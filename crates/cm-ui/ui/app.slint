// ConMan — main application window (Direction A shell, P1.4 panels).
//
// P1.4 additions over P2.8/P3.2 baseline:
//  • ConnRow gains `depth: int` for subgroup indentation.
//  • ConnectionRow gains CRUD hover buttons and group-toggle behaviour.
//  • New CredRow struct + CredTreeRow component for the Keys panel.
//  • New ConnProfile / GroupForm / CredFormData structs (in screen files).
//  • Keys panel is now a real credential folder tree (replaces the P2.8 stub).
//  • Connections panel header has New Group + New Connection buttons.
//  • ProfileEditor / GroupEditor / CredEditor modals mounted here.
//  • AppWindow gains credentials, cred-name-list, editor state + callbacks.
//
// BEHAVIOUR PRESERVED: TerminalSurface and its callbacks are UNCHANGED from P2.4.

import { Theme } from "theme.slint";
import {
    StatusDot, StatusPill, IconButton, ActivityBarButton,
    PrimaryButton, SecondaryButton, EmptyState
} from "components.slint";
import { ListView, Palette, LineEdit } from "std-widgets.slint";
import { Modal, QuickConnectForm, HostKeyDialog, CertDialog } from "screens/dialogs.slint";
import { CommandPalette, PaletteAction } from "screens/command_palette.slint";
import { SettingsPanel } from "screens/settings_panel.slint";
import { ConnectingOverlay, ErrorOverlay } from "screens/session_overlays.slint";
import { Launchpad, RecentItem } from "screens/launchpad.slint";
import {
    ConnProfile, GroupForm, ProfileEditor, GroupEditor
} from "screens/profile_editor.slint";
import { CredFormData, CredEditor } from "screens/cred_editor.slint";

// ── Models ────────────────────────────────────────────────────────────────
export struct TabItem {
    title: string,
    id: int,
    status: string,
    pane-count: int,
}

// Flattened connection-tree row.  `depth` drives left-indent (16 px per level).
// Rust flattens the group/connection tree into this list honouring expand/collapse.
export struct ConnRow {
    id: int,
    label: string,
    host: string,
    kind: string,      // "SSH" | "RDP" | "LOCAL" | "" (groups)
    status: string,
    is-group: bool,
    expanded: bool,
    selected: bool,
    depth: int,        // 0 = root level, 1 = inside a group, etc.
}

// Flattened credential-folder row for the Keys panel.  Mirrors ConnRow shape.
export struct CredRow {
    id: int,
    label: string,
    kind: string,      // "Password" | "SSH Key" | "SSH Key+PP" | "" (folder)
    username: string,
    is-folder: bool,
    expanded: bool,
    selected: bool,
    depth: int,
}

// ── TerminalSurface (verbatim from P2.4; background tokenised) ─────────────
component TerminalSurface inherits Rectangle {
    in property <image> frame;
    callback key-input(string, int, int);
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);
    callback resized(length, length);
    callback toggle-palette();

    pure function mods(c: bool, a: bool, s: bool, m: bool) -> int {
        (c ? 1 : 0) + (a ? 2 : 0) + (s ? 4 : 0) + (m ? 8 : 0)
    }

    background: Theme.color-terminal-bg;
    forward-focus: fs;

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "k" || e.text == "K")) {
                root.toggle-palette();
                accept
            } else {
                root.key-input(
                    e.text,
                    (e.text == Key.Return) ? 1
                        : (e.text == Key.Tab) ? 2
                        : (e.text == Key.Backspace) ? 3
                        : (e.text == Key.Escape) ? 4
                        : (e.text == Key.UpArrow) ? 5
                        : (e.text == Key.DownArrow) ? 6
                        : (e.text == Key.LeftArrow) ? 7
                        : (e.text == Key.RightArrow) ? 8
                        : (e.text == Key.Home) ? 9
                        : (e.text == Key.End) ? 10
                        : (e.text == Key.PageUp) ? 11
                        : (e.text == Key.PageDown) ? 12
                        : (e.text == Key.Delete) ? 14
                        : 0,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
                accept
            }
        }

        Image {
            source: frame;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: pixelated;
        }

        ta := TouchArea {
            pointer-event(e) => {
                fs.focus();
                root.pointer(
                    e.button == PointerEventButton.left ? 1
                        : e.button == PointerEventButton.right ? 2
                        : e.button == PointerEventButton.middle ? 3
                        : 0,
                    e.kind == PointerEventKind.down ? 1
                        : e.kind == PointerEventKind.up ? 2
                        : e.kind == PointerEventKind.move ? 3
                        : 0,
                    ta.mouse-x, ta.mouse-y,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
            }
            scroll-event(e) => {
                root.scroll(e.delta-x, e.delta-y);
                accept
            }
        }
    }

    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
}

// ── RdpSurface (P4.2) ──────────────────────────────────────────────────────
// Framebuffer surface for RDP sessions. Renders a decoded RGBA slint::Image and
// forwards keyboard (both key-down AND key-up), pointer, and scroll events to the
// controller for conversion to IronRDP FastPath PDUs.
//
// Key design differences from TerminalSurface (which is FROZEN):
//  - Uses both `key-pressed` and `key-released` events (RDP needs key-up PDUs).
//  - `special()` pure function exposes F-key codes to the controller.
//  - Background is pure black (the framebuffer fills it).
//  - No toggle-palette callback (Ctrl-K palette is handled at the AppWindow level).
component RdpSurface inherits Rectangle {
    in property <image> frame;
    // key-down: fired on key-pressed (key-down PDU to RDP).
    callback key-down(string /* text */, int /* special */, int /* mods */);
    // key-up: fired on key-released (key-up PDU to RDP).
    callback key-up(string /* text */, int /* special */, int /* mods */);
    callback pointer(int /* button */, int /* kind */, length /* x */, length /* y */, int /* mods */);
    // rdp-scroll: passes actual pointer position (carry-over fix c).
    callback rdp-scroll(length /* x */, length /* y */, length /* dx */, length /* dy */);
    callback resized(length /* w */, length /* h */);

    pure function mods(c: bool, a: bool, s: bool, m: bool) -> int {
        (c ? 1 : 0) + (a ? 2 : 0) + (s ? 4 : 0) + (m ? 8 : 0)
    }

    // Maps Slint Key.* strings to the same special codes used by TerminalSurface
    // (plus F1–F12) so the Rust input module can produce the right PS/2 scancodes.
    pure function special(text: string) -> int {
        (text == Key.Return)    ? 1
        : (text == Key.Tab)       ? 2
        : (text == Key.Backspace) ? 3
        : (text == Key.Escape)    ? 4
        : (text == Key.UpArrow)   ? 5
        : (text == Key.DownArrow) ? 6
        : (text == Key.LeftArrow) ? 7
        : (text == Key.RightArrow)? 8
        : (text == Key.Home)      ? 9
        : (text == Key.End)       ? 10
        : (text == Key.PageUp)    ? 11
        : (text == Key.PageDown)  ? 12
        : (text == Key.Delete)    ? 14
        : (text == Key.F1)        ? 15
        : (text == Key.F2)        ? 16
        : (text == Key.F3)        ? 17
        : (text == Key.F4)        ? 18
        : (text == Key.F5)        ? 19
        : (text == Key.F6)        ? 20
        : (text == Key.F7)        ? 21
        : (text == Key.F8)        ? 22
        : (text == Key.F9)        ? 23
        : (text == Key.F10)       ? 24
        : (text == Key.F11)       ? 25
        : (text == Key.F12)       ? 26
        : 0
    }

    background: #000000;
    forward-focus: rdp-fs;

    rdp-fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(e) => {
            root.key-down(
                e.text,
                root.special(e.text),
                root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)
            );
            accept
        }

        key-released(e) => {
            root.key-up(
                e.text,
                root.special(e.text),
                root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)
            );
            accept
        }

        Image {
            source: frame;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: pixelated;
        }

        rdp-ta := TouchArea {
            pointer-event(e) => {
                rdp-fs.focus();
                root.pointer(
                    e.button == PointerEventButton.left   ? 1
                        : e.button == PointerEventButton.right  ? 2
                        : e.button == PointerEventButton.middle ? 3
                        : 0,
                    e.kind == PointerEventKind.down  ? 1
                        : e.kind == PointerEventKind.up   ? 2
                        : e.kind == PointerEventKind.move ? 3
                        : 0,
                    rdp-ta.mouse-x, rdp-ta.mouse-y,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
            }
            scroll-event(e) => {
                // Pass actual pointer position (carry-over fix c: was surface centre).
                root.rdp-scroll(rdp-ta.mouse-x, rdp-ta.mouse-y, e.delta-x, e.delta-y);
                accept
            }
        }
    }

    changed width  => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
}

// ── Tab ────────────────────────────────────────────────────────────────────
component Tab inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <int>    pane-count: 1;
    in property <bool>   active;
    callback clicked();
    callback closed();

    height: Theme.tab-height;
    border-radius: Theme.radius-sm + 0px;
    background: active ? Theme.color-card : (touch.has-hover ? Theme.color-hover : transparent);

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        VerticalLayout { alignment: center; StatusDot { state: root.status; } }
        Text {
            text: title;
            color: active ? Theme.color-text : Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
        if root.pane-count > 1 : Rectangle {
            y: (parent.height - self.height) / 2;
            height: 16px;
            border-radius: Theme.radius-sm - 2px;
            background: Theme.color-accent-subtle;
            HorizontalLayout {
                padding-left: 5px; padding-right: 5px;
                Text {
                    text: "⊟ " + root.pane-count;
                    color: Theme.color-accent;
                    font-size: Theme.font-xxs;
                    font-family: Theme.font-family-mono;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: "\u{E711}";
                size: 16px;
                glyph-size: Theme.icon-xs;
                clicked => { root.closed(); }
            }
        }
    }
}

// ── ConnectionRow (P1.4: depth-indent + hover CRUD buttons) ────────────────
// The base `touch` is the FIRST child so the HorizontalLayout (holding the
// interactive action buttons) is rendered on top and captures clicks first —
// the same pattern used by the Tab component's close button.
component ConnectionRow inherits Rectangle {
    in property <ConnRow> data;
    callback activated();       // open session tab (leaf)
    callback toggled();         // expand / collapse group
    callback edit-clicked();    // open profile / group editor
    callback new-sub();         // new child item under this group
    callback delete-clicked();
    callback move-up();         // reorder: move one step up within same parent
    callback move-down();       // reorder: move one step down within same parent

    height: Theme.tree-row-height;
    border-radius: Theme.radius-sm;
    background: data.selected ? Theme.color-accent-subtle
              : touch.has-hover ? Theme.color-hover : transparent;

    // Accent rail (selected connection).
    Rectangle {
        x: 0px; width: 2.5px; height: Theme.tag-height;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xs - 1px;
        background: data.selected ? Theme.color-accent : transparent;
    }

    // Base touch — FIRST interactive child; content layer on top captures first.
    touch := TouchArea {
        clicked => {
            if (data.is-group) { root.toggled(); }
            else { root.activated(); }
        }
    }

    HorizontalLayout {
        padding-left: (data.depth * 16px) + (data.is-group ? Theme.space-1 : Theme.space-3);
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            if data.is-group : Text {
                text: data.expanded ? "\u{E70D}" : "\u{E76C}";
                font-family: Theme.font-family-icons;
                font-size: Theme.icon-xs;
                color: Theme.color-text-secondary;
            }
            if !data.is-group : StatusDot { state: data.status; diameter: 6px; }
        }

        Text {
            text: data.label;
            color: data.is-group ? Theme.color-text
                 : data.selected ? Theme.color-text : Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            font-weight: data.is-group ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if !data.is-group && data.kind != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                height: Theme.tag-height;
                border-radius: Theme.radius-xs;
                background: Theme.color-hover;
                HorizontalLayout {
                    padding-left: 5px; padding-right: 5px;
                    Text {
                        text: data.kind;
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-xxs;
                        font-family: Theme.font-family-mono;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Hover action buttons (shown only while the pointer is over the row).
        if touch.has-hover : HorizontalLayout {
            spacing: Theme.gap-hairline;
            alignment: center;
            // ↑ / ↓ reorder within the same parent.
            IconButton {
                glyph: "\u{E70E}";   // ChevronUp
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.move-up(); }
            }
            IconButton {
                glyph: "\u{E70D}";   // ChevronDown
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.move-down(); }
            }
            // Group: new-child + edit; Connection: edit (pencil).
            if data.is-group : IconButton {
                glyph: "\u{E710}";   // Add (new child)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.new-sub(); }
            }
            IconButton {
                glyph: "\u{E70F}";   // Edit (pencil)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.edit-clicked(); }
            }
            IconButton {
                glyph: "\u{E74D}";   // Delete (trash)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                glyph-color: Theme.color-error;
                clicked => { root.delete-clicked(); }
            }
        }
    }
}

// ── CredTreeRow — Keys panel tree row ─────────────────────────────────────
component CredTreeRow inherits Rectangle {
    in property <CredRow> data;
    callback activated();
    callback toggled();
    callback new-sub();
    callback delete-clicked();

    height: Theme.tree-row-height;
    border-radius: Theme.radius-sm;
    background: data.selected ? Theme.color-accent-subtle
              : touch.has-hover ? Theme.color-hover : transparent;

    touch := TouchArea {
        clicked => {
            if (data.is-folder) { root.toggled(); }
            else { root.activated(); }
        }
    }

    HorizontalLayout {
        padding-left: (data.depth * 16px) + (data.is-folder ? Theme.space-1 : Theme.space-3);
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            if data.is-folder : Text {
                text: data.expanded ? "\u{E70D}" : "\u{E76C}";
                font-family: Theme.font-family-icons;
                font-size: Theme.icon-xs;
                color: Theme.color-text-secondary;
            }
            if !data.is-folder : Rectangle {
                width: 7px; height: 7px;
                border-radius: 4px;
                background: Theme.color-accent-subtle;
            }
        }

        Text {
            text: data.label;
            color: data.is-folder ? Theme.color-text : Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            font-weight: data.is-folder ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if !data.is-folder && data.username != "" : VerticalLayout {
            alignment: center;
            Text {
                text: data.username;
                color: Theme.color-text-disabled;
                font-size: Theme.font-xxs;
                font-family: Theme.font-family-mono;
                vertical-alignment: center;
            }
        }

        if !data.is-folder && data.kind != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                height: Theme.tag-height;
                border-radius: Theme.radius-xs;
                background: Theme.color-hover;
                HorizontalLayout {
                    padding-left: 5px; padding-right: 5px;
                    Text {
                        text: data.kind;
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-xxs;
                        font-family: Theme.font-family-mono;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if touch.has-hover : HorizontalLayout {
            spacing: Theme.gap-hairline;
            alignment: center;
            if data.is-folder : IconButton {
                glyph: "\u{E710}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.new-sub(); }
            }
            if !data.is-folder : IconButton {
                glyph: "\u{E70F}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                clicked => { root.activated(); }
            }
            IconButton {
                glyph: "\u{E74D}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                glyph-color: Theme.color-error;
                clicked => { root.delete-clicked(); }
            }
        }
    }
}

// ── PaneSlot (P5.1) ────────────────────────────────────────────────────────
// Wraps TerminalSurface with pane-index identity so multi-pane layouts can
// track focus and route events per pane.  TerminalSurface internals are
// FROZEN (P2.4); PaneSlot adds only an outer border + `pane-focused` routing.
component PaneSlot inherits Rectangle {
    in property <image>  frame;
    in property <bool>   is-focused;
    in property <int>    pane-index;
    callback pane-focused(int);   // tell the parent which pane was clicked
    callback key-input(string, int, int);
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);
    callback resized(length, length);
    callback toggle-palette();

    // Accent border on the focused pane; invisible otherwise.
    border-width: root.is-focused ? 1.5px : 0px;
    border-color: Theme.color-accent;
    clip: true;

    TerminalSurface {
        width: 100%; height: 100%;
        frame: root.frame;
        key-input(t, s, m) => { root.key-input(t, s, m); }
        pointer(b, k, x, y, m) => {
            root.pane-focused(root.pane-index);
            root.pointer(b, k, x, y, m);
        }
        scroll(dx, dy) => { root.scroll(dx, dy); }
        resized(w, h)  => { root.resized(w, h); }
        toggle-palette => { root.toggle-palette(); }
    }
}

// ── AppWindow ──────────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    title: "ConMan";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.color-base;
    // Note: forward-focus is intentionally NOT set here because the active session
    // surface (terminal or RDP) is conditional. Each surface's FocusScope grabs focus
    // on the first pointer click via fs.focus() / rdp-fs.focus().

    // ── Session / tabs (P2.4 contract unchanged) ──────────────────────
    in property <[TabItem]> tabs;
    in property <int>       active-tab;
    in property <image>     frame;
    // ── RDP surface (P4.2) ────────────────────────────────────────────
    // rdp-frame: the decoded RGBA image from the active RDP session.
    // rdp-active: true while an RDP tab is the active tab.
    in property <image>     rdp-frame;
    in-out property <bool>  rdp-active: false;

    // ── Side panel ────────────────────────────────────────────────────
    in property <[ConnRow]> connections;
    in-out property <int>   active-panel: 0;
    in-out property <bool>  sidebar-collapsed: false;
    // P5.3b: live search/filter for the connection tree and keys tree.
    in-out property <string> conn-filter: "";
    in-out property <string> cred-filter: "";
    callback conn-filter-changed(string);
    callback cred-filter-changed(string);

    // ── Keys panel data ───────────────────────────────────────────────
    in property <[CredRow]>  credentials;
    // Flat list of credential names for all dropdowns.
    // Index 0 = "Inherit from group" / "No default"; 1.. = credential names.
    in property <[string]>   cred-name-list;
    // Flat folder name list for the credential editor's folder picker.
    in property <[string]>   folder-name-list;
    // Flat list of group names for the group/parent pickers in editors.
    // Index 0 = "Root (no group)"; 1.. = group names in sort order.
    in property <[string]>   group-name-list;

    // ── Status bar / broadcast ────────────────────────────────────────
    in property <string>  session-status: "disconnected";
    in property <string>  session-identity: "";
    in-out property <bool> broadcast-active: false;

    // ── P5.1: Split panes ─────────────────────────────────────────────
    // pane-layout: 0=single, 1=H-split (side by side), 2=V-split (stacked).
    in property <int>    pane-layout: 0;
    // Frame for the second pane (pane index 1); ignored when pane-layout==0.
    in property <image>  pane-frame-2;
    // Which pane is currently focused (0-based).
    in-out property <int> active-pane: 0;
    // Number of detached (background) sessions — shown in palette.
    in property <int> detached-count: 0;
    // Callbacks: split/close/focus/resize.
    callback split-pane-h();
    callback split-pane-v();
    callback close-pane();
    callback detach-session();
    callback pane-focused(int);
    callback pane-resized(int, length, length);

    // ── Command palette ───────────────────────────────────────────────
    in-out property <bool>           palette-open: false;
    in-out property <string>         palette-query: "";
    in property <[PaletteAction]>    palette-actions;
    in-out property <int>            palette-selected: 0;

    // ── Session overlays ──────────────────────────────────────────────
    in-out property <bool>   overlay-connecting: false;
    in-out property <bool>   overlay-error: false;
    in-out property <bool>   launchpad-open: false;
    in property <int>        connecting-step: 0;
    in property <string>     error-reason: "";
    in property <string>     error-detail: "";
    in property <[RecentItem]> launchpad-recents;
    in-out property <string> launchpad-query: "";
    callback reconnect();
    callback launchpad-edited(string);
    callback open-recent(int);
    callback open-group-split();

    // ── Quick-connect form (P3.2) ─────────────────────────────────────
    in-out property <bool>   quick-connect-open: false;
    in-out property <string> qc-host: "";
    in-out property <string> qc-port: "22";
    in-out property <string> qc-username: "";
    in-out property <int>    qc-auth-method: 1;
    in-out property <string> qc-secret: "";
    in-out property <string> qc-passphrase: "";
    callback qc-connect();

    // ── Host-key dialog (P3.2) ────────────────────────────────────────
    in-out property <bool>   host-key-open: false;
    in property <bool>       host-key-mismatch: false;
    in property <string>     host-key-host: "";
    in property <string>     host-key-type: "";
    in property <string>     host-key-fingerprint: "";
    in property <string>     host-key-stored-fp: "";
    callback host-key-accept();
    callback host-key-reject();

    // ── RDP cert dialog (P4.2) ───────────────────────────────────────
    in-out property <bool>   cert-dialog-open: false;
    in property <bool>       cert-dialog-mismatch: false;
    in property <string>     cert-dialog-host: "";
    in property <string>     cert-dialog-subject: "";
    in property <string>     cert-dialog-fingerprint: "";
    in property <string>     cert-dialog-stored-fp: "";
    callback cert-accept();
    callback cert-reject();

    // ── Appearance (P5.2: full settings exposed here) ────────────────
    in-out property <int>   theme-mode: 2;
    in-out property <int>   density    <=> Theme.density;
    in-out property <int>   accent-index: 0;
    in-out property <bool>  dark-mode  <=> Theme.dark-mode;
    in-out property <color> accent     <=> Theme.accent;
    // Terminal defaults
    in-out property <int>    settings-font-size: 13;
    in-out property <string> settings-shell-path: "";
    in-out property <string> settings-shell-args: "";
    in-out property <string> settings-shell-cwd: "";
    // Startup behavior: 0 = clean start, 1 = restore last session
    in-out property <int>    startup-behavior: 0;

    // ── P1.4: Profile editor modal ───────────────────────────────────
    in-out property <bool>        profile-editor-open: false;
    in-out property <ConnProfile> profile-form;
    callback profile-save();

    // ── P1.4: Group editor modal ──────────────────────────────────────
    in-out property <bool>      group-editor-open: false;
    in-out property <GroupForm> group-form;
    callback group-save();

    // ── P1.4: Credential editor modal ────────────────────────────────
    in-out property <bool>         cred-editor-open: false;
    in-out property <CredFormData> cred-form;
    callback cred-save();

    // ── Shell callbacks ───────────────────────────────────────────────
    callback select-tab(int);
    callback close-tab(int);
    callback new-tab();
    callback select-panel(int);
    callback toggle-sidebar();
    callback open-palette();
    callback quick-connect();
    callback row-activated(int);
    callback toggle-broadcast();
    callback palette-edited(string);
    callback palette-activated(int);
    callback theme-changed(int);
    callback density-changed(int);
    callback accent-changed(int);
    // P5.2 fix: restore persisted accent color at launch (called from Rust startup).
    callback apply-accent-index(int);
    apply-accent-index(idx) => { Theme.accent = Theme.accent-presets[idx]; }
    callback settings-font-size-changed(int);
    callback settings-shell-path-changed(string);
    callback settings-shell-args-changed(string);
    callback settings-shell-cwd-changed(string);
    callback startup-behavior-changed(int);

    // P1.4 — Connections panel CRUD.
    callback toggle-conn-row(int);       // idx → expand/collapse group
    callback new-connection(int);        // parent group_id (0=root)
    callback new-group(int);             // parent group_id (0=root)
    callback edit-conn(int);             // connection id → profile editor
    callback edit-group(int);            // group id → group editor
    callback delete-conn-row(int, bool); // id, is_group
    // P1.4 — Reorder (up/down within the same parent) + move-between-groups.
    // Reorder is wired from hover ↑/↓ buttons; move-between-groups is exposed
    // via the group/parent-group ComboBoxes in the profile and group editors.
    callback reorder-conn-row(int, int);  // conn_id, direction (-1=up, +1=down)
    callback reorder-group-row(int, int); // group_id, direction

    // P1.4 — Keys panel CRUD.
    callback toggle-cred-row(int);        // idx → expand/collapse folder
    callback new-cred-folder(int);        // parent_folder_id (0=root)
    callback new-cred(int);               // folder_id (0=root)
    callback edit-cred(int);              // credential id
    callback delete-cred-row(int, bool);  // id, is_folder

    // TerminalSurface passthrough (UNCHANGED from P2.4).
    callback key-input(string, int, int);
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);
    callback surface-resized(length, length);
    // RDP scroll with actual pointer coordinates (carry-over fix c).
    callback rdp-scroll(length /* x */, length /* y */, length /* dx */, length /* dy */);

    // RDP surface key events (P4.2) — separate from terminal because RDP needs
    // both key-down and key-up PDUs (key-released fires key-up).
    callback rdp-key-down(string /* text */, int /* special */, int /* mods */);
    callback rdp-key-up(string /* text */, int /* special */, int /* mods */);

    // ── Main shell ────────────────────────────────────────────────────
    VerticalLayout {
        // Tab strip.
        Rectangle {
            height: 40px;
            background: Theme.color-base.darker(0.2);
            HorizontalLayout {
                padding: Theme.space-1;
                spacing: Theme.space-1;
                alignment: start;
                for tab[idx] in tabs: Tab {
                    title: tab.title;
                    status: tab.status;
                    pane-count: tab.pane-count;
                    active: idx == active-tab;
                    clicked => { root.select-tab(idx); }
                    closed => { root.close-tab(idx); }
                }
                IconButton {
                    glyph: "\u{E710}";
                    clicked => { root.new-tab(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Body: activity bar + side panel + session area.
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Activity bar.
            Rectangle {
                width: Theme.activity-bar-width;
                background: Theme.color-elevated;
                VerticalLayout {
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-1;
                    ActivityBarButton {
                        glyph: "\u{E968}"; active: active-panel == 0;
                        clicked => { root.select-panel(0); }
                    }
                    ActivityBarButton {
                        glyph: "\u{E8D7}"; active: active-panel == 1;
                        clicked => { root.select-panel(1); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    ActivityBarButton {
                        glyph: "\u{E713}"; active: active-panel == 2;
                        clicked => { root.select-panel(2); }
                    }
                    ActivityBarButton { glyph: "\u{E77B}"; }
                }
            }

            // Side panel (collapsible).
            if !sidebar-collapsed : Rectangle {
                width: Theme.side-panel-width;
                background: Theme.color-elevated;

                // ── Connections panel ──────────────────────────────
                if active-panel == 0 : VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-2;
                        padding-top: Theme.space-3; padding-bottom: Theme.space-2;
                        Text {
                            text: "CONNECTIONS";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            glyph: "\u{E8F4}";   // New folder / group
                            size: 24px; glyph-size: Theme.icon-sm;
                            clicked => { root.new-group(0); }
                        }
                        IconButton {
                            glyph: "\u{E710}";   // Add connection
                            size: 24px; glyph-size: Theme.icon-sm;
                            clicked => { root.new-connection(0); }
                        }
                    }
                    // P5.3b: Search/filter box.
                    HorizontalLayout {
                        padding-left: Theme.space-3; padding-right: Theme.space-3;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-2;
                        Text { text: "\u{E721}"; font-family: Theme.font-family-icons;
                            font-size: Theme.icon-sm; color: Theme.color-text-secondary;
                            vertical-alignment: center; }
                        LineEdit {
                            placeholder-text: "Filter connections…";
                            text <=> root.conn-filter;
                            font-size: Theme.font-sm;
                            horizontal-stretch: 1;
                            edited(t) => { root.conn-filter-changed(t); }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for conn[idx] in connections: ConnectionRow {
                            data: conn;
                            activated     => { root.row-activated(idx); }
                            toggled       => { root.toggle-conn-row(idx); }
                            edit-clicked  => {
                                if (conn.is-group) { root.edit-group(conn.id); }
                                else { root.edit-conn(conn.id); }
                            }
                            new-sub => { root.new-connection(conn.id); }
                            delete-clicked => {
                                root.delete-conn-row(conn.id, conn.is-group);
                            }
                            move-up => {
                                if (conn.is-group) { root.reorder-group-row(conn.id, -1); }
                                else { root.reorder-conn-row(conn.id, -1); }
                            }
                            move-down => {
                                if (conn.is-group) { root.reorder-group-row(conn.id, 1); }
                                else { root.reorder-conn-row(conn.id, 1); }
                            }
                        }
                    }

                    if connections.length == 0 && conn-filter == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{E968}";
                        title: "No connections yet";
                        subtitle: "Use the + button above to add your first connection.";
                    }
                    if connections.length == 0 && conn-filter != "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{E721}";
                        title: "No matches";
                        subtitle: "No connections match your filter.";
                    }

                    Rectangle {
                        height: 52px;
                        HorizontalLayout {
                            padding: Theme.space-3;
                            PrimaryButton {
                                text: "Quick connect";
                                clicked => { root.quick-connect(); }
                            }
                        }
                    }
                }

                // ── Keys panel ─────────────────────────────────────
                if active-panel == 1 : VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-2;
                        padding-top: Theme.space-3; padding-bottom: Theme.space-2;
                        Text {
                            text: "KEYS";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            glyph: "\u{E8F4}";   // New folder
                            size: 24px; glyph-size: Theme.icon-sm;
                            clicked => { root.new-cred-folder(0); }
                        }
                        IconButton {
                            glyph: "\u{E710}";   // New credential
                            size: 24px; glyph-size: Theme.icon-sm;
                            clicked => { root.new-cred(0); }
                        }
                    }
                    // P5.3b: Search/filter box.
                    HorizontalLayout {
                        padding-left: Theme.space-3; padding-right: Theme.space-3;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-2;
                        Text { text: "\u{E721}"; font-family: Theme.font-family-icons;
                            font-size: Theme.icon-sm; color: Theme.color-text-secondary;
                            vertical-alignment: center; }
                        LineEdit {
                            placeholder-text: "Filter credentials…";
                            text <=> root.cred-filter;
                            font-size: Theme.font-sm;
                            horizontal-stretch: 1;
                            edited(t) => { root.cred-filter-changed(t); }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for cred[idx] in credentials: CredTreeRow {
                            data: cred;
                            activated      => { root.edit-cred(cred.id); }
                            toggled        => { root.toggle-cred-row(idx); }
                            new-sub        => { root.new-cred(cred.id); }
                            delete-clicked => {
                                root.delete-cred-row(cred.id, cred.is-folder);
                            }
                        }
                    }

                    if credentials.length == 0 && cred-filter == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{E8D7}";
                        title: "No credentials yet";
                        subtitle: "Use the + button above to add SSH keys or passwords.";
                    }
                    if credentials.length == 0 && cred-filter != "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{E721}";
                        title: "No matches";
                        subtitle: "No credentials match your filter.";
                    }
                }

                // ── Settings panel (P5.2) ──────────────────────────
                if active-panel == 2 : SettingsPanel {
                    theme-mode          <=> root.theme-mode;
                    density             <=> root.density;
                    accent-index        <=> root.accent-index;
                    font-size           <=> root.settings-font-size;
                    shell-path          <=> root.settings-shell-path;
                    shell-args          <=> root.settings-shell-args;
                    shell-cwd           <=> root.settings-shell-cwd;
                    startup-behavior    <=> root.startup-behavior;
                    // theme-changed is also handled inside SettingsPanel (live recolor);
                    // the callback here persists the choice to the DB.
                    theme-changed(i)    => { root.theme-changed(i); }
                    density-changed(i)  => { root.density-changed(i); }
                    accent-changed(i)   => { root.accent-changed(i); }
                    font-size-changed(v)         => { root.settings-font-size-changed(v); }
                    shell-path-changed(v)        => { root.settings-shell-path-changed(v); }
                    shell-args-changed(v)        => { root.settings-shell-args-changed(v); }
                    shell-cwd-changed(v)         => { root.settings-shell-cwd-changed(v); }
                    startup-behavior-changed(v)  => { root.startup-behavior-changed(v); }
                }
            }

            // Session area.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // ── Single-pane terminal (P2.4; FROZEN — pane-layout == 0, no RDP) ──
                if !rdp-active && pane-layout == 0 : TerminalSurface {
                    vertical-stretch: 1;
                    frame: root.frame;
                    key-input(t, s, m) => { root.key-input(t, s, m); }
                    pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                    scroll(dx, dy) => { root.scroll(dx, dy); }
                    resized(w, h) => { root.surface-resized(w, h); }
                    toggle-palette => {
                        root.palette-open = !root.palette-open;
                        if (!root.palette-open) { root.palette-selected = 0; }
                    }
                }

                // ── H-split: two panes side by side (P5.1) ──────────────────────
                if !rdp-active && pane-layout == 1 : HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;
                    PaneSlot {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        frame: root.frame;
                        is-focused: root.active-pane == 0;
                        pane-index: 0;
                        pane-focused(i) => { root.pane-focused(i); }
                        key-input(t, s, m) => { root.key-input(t, s, m); }
                        pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                        scroll(dx, dy) => { root.scroll(dx, dy); }
                        resized(w, h) => { root.pane-resized(0, w, h); }
                        toggle-palette => {
                            root.palette-open = !root.palette-open;
                            if (!root.palette-open) { root.palette-selected = 0; }
                        }
                    }
                    // Hairline divider.
                    Rectangle { width: 1px; vertical-stretch: 1; background: Theme.color-stroke; }
                    PaneSlot {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        frame: root.pane-frame-2;
                        is-focused: root.active-pane == 1;
                        pane-index: 1;
                        pane-focused(i) => { root.pane-focused(i); }
                        key-input(t, s, m) => { root.key-input(t, s, m); }
                        pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                        scroll(dx, dy) => { root.scroll(dx, dy); }
                        resized(w, h) => { root.pane-resized(1, w, h); }
                        toggle-palette => {
                            root.palette-open = !root.palette-open;
                            if (!root.palette-open) { root.palette-selected = 0; }
                        }
                    }
                }

                // ── V-split: two panes stacked (P5.1) ───────────────────────────
                if !rdp-active && pane-layout == 2 : VerticalLayout {
                    spacing: 0px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    PaneSlot {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        frame: root.frame;
                        is-focused: root.active-pane == 0;
                        pane-index: 0;
                        pane-focused(i) => { root.pane-focused(i); }
                        key-input(t, s, m) => { root.key-input(t, s, m); }
                        pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                        scroll(dx, dy) => { root.scroll(dx, dy); }
                        resized(w, h) => { root.pane-resized(0, w, h); }
                        toggle-palette => {
                            root.palette-open = !root.palette-open;
                            if (!root.palette-open) { root.palette-selected = 0; }
                        }
                    }
                    // Hairline divider.
                    Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.color-stroke; }
                    PaneSlot {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        frame: root.pane-frame-2;
                        is-focused: root.active-pane == 1;
                        pane-index: 1;
                        pane-focused(i) => { root.pane-focused(i); }
                        key-input(t, s, m) => { root.key-input(t, s, m); }
                        pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                        scroll(dx, dy) => { root.scroll(dx, dy); }
                        resized(w, h) => { root.pane-resized(1, w, h); }
                        toggle-palette => {
                            root.palette-open = !root.palette-open;
                            if (!root.palette-open) { root.palette-selected = 0; }
                        }
                    }
                }

                // ── RDP surface (P4.2; only shown when an RDP tab is active) ────
                if rdp-active : RdpSurface {
                    vertical-stretch: 1;
                    frame: root.rdp-frame;
                    key-down(t, s, m) => { root.rdp-key-down(t, s, m); }
                    key-up(t, s, m)   => { root.rdp-key-up(t, s, m); }
                    pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                    rdp-scroll(x, y, dx, dy) => { root.rdp-scroll(x, y, dx, dy); }
                    resized(w, h)     => { root.surface-resized(w, h); }
                }

                // ── Broadcast bar (always visible when active; never silent) ────
                if broadcast-active : Rectangle {
                    height: 46px;
                    background: Theme.color-elevated;
                    border-width: 1px;
                    border-color: Theme.color-broadcast-edge;
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-4;
                        spacing: Theme.space-3;
                        Text {
                            text: "\u{E95A}  Broadcast on";
                            color: Theme.color-accent;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        // Show target scope when split.
                        if pane-layout != 0 : Text {
                            text: "→ all panes";
                            color: Theme.color-text-secondary;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Dismiss button.
                        IconButton {
                            glyph: "\u{E711}";
                            size: 24px; glyph-size: Theme.icon-sm;
                            clicked => { root.toggle-broadcast(); }
                        }
                    }
                }
            }
        }

        // Status bar.
        Rectangle {
            height: Theme.status-bar-height;
            background: Theme.color-base.darker(0.2);
            HorizontalLayout {
                padding-left: Theme.space-3; padding-right: Theme.space-3;
                spacing: Theme.space-4;
                VerticalLayout {
                    alignment: center;
                    StatusPill {
                        state: session-status;
                        text: session-identity != ""
                            ? "Connected · " + session-identity
                            : "No active session";
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Detached-session badge: click to open palette filtered to "reattach".
                if detached-count > 0 : Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    border-radius: Theme.radius-sm - 2px;
                    background: Theme.color-elevated;
                    HorizontalLayout {
                        padding-left: Theme.space-2; padding-right: Theme.space-2;
                        spacing: Theme.space-1;
                        Text { text: "\u{E8FB}"; color: Theme.color-text-secondary; font-size: Theme.font-xs;
                            font-family: Theme.font-family-mono; vertical-alignment: center; }
                        Text { text: detached-count + " detached"; color: Theme.color-text-secondary;
                            font-size: Theme.font-xs; font-family: Theme.font-family; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.open-palette(); } }
                }
                // Broadcast indicator in the status bar (never silent).
                if broadcast-active : Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    border-radius: Theme.radius-sm - 2px;
                    background: Theme.color-broadcast-edge;
                    HorizontalLayout {
                        padding-left: Theme.space-2; padding-right: Theme.space-2;
                        Text { text: "\u{E95A} BC"; color: Theme.color-base; font-size: Theme.font-xs;
                            font-family: Theme.font-family-mono; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.toggle-broadcast(); } }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    border-radius: Theme.radius-sm - 2px;
                    background: Theme.color-accent-subtle;
                    HorizontalLayout {
                        padding-left: Theme.space-2; padding-right: Theme.space-2;
                        spacing: Theme.space-1;
                        Text { text: "Ctrl K"; color: Theme.color-accent; font-size: Theme.font-xs;
                            font-family: Theme.font-family-mono; font-weight: 700; vertical-alignment: center; }
                        Text { text: "Palette"; color: Theme.color-accent; font-size: Theme.font-sm;
                            font-family: Theme.font-family; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.open-palette(); } }
                }
            }
        }
    }

    // ── Session-state overlays ────────────────────────────────────────────
    if overlay-connecting : ConnectingOverlay {
        x: 0; y: 0; width: 100%; height: 100%;
        identity: session-identity;
        step: connecting-step;
    }
    if overlay-error : ErrorOverlay {
        x: 0; y: 0; width: 100%; height: 100%;
        identity: session-identity;
        reason: error-reason;
        detail: error-detail;
        reconnect => { root.reconnect(); }
        edit => { root.quick-connect(); }
    }
    if launchpad-open : Launchpad {
        x: 0; y: 0; width: 100%; height: 100%;
        recents: launchpad-recents;
        query <=> launchpad-query;
        edited(q) => { root.launchpad-edited(q); }
        open-recent(i) => { root.open-recent(i); }
        quick-connect => { root.quick-connect(); }
        open-group-split => { root.open-group-split(); }
    }

    // ── Quick-connect modal ───────────────────────────────────────────────
    Modal {
        open: root.quick-connect-open;
        dismissed => { root.quick-connect-open = false; }
        QuickConnectForm {
            host <=> root.qc-host;
            port <=> root.qc-port;
            username <=> root.qc-username;
            auth-method <=> root.qc-auth-method;
            secret <=> root.qc-secret;
            passphrase <=> root.qc-passphrase;
            connect => { root.qc-connect(); }
            cancel  => { root.quick-connect-open = false; }
        }
    }

    // ── Host-key dialog ───────────────────────────────────────────────────
    Modal {
        open: root.host-key-open;
        dismissed => {}
        HostKeyDialog {
            mismatch:           root.host-key-mismatch;
            host:               root.host-key-host;
            key-type:           root.host-key-type;
            fingerprint:        root.host-key-fingerprint;
            stored-fingerprint: root.host-key-stored-fp;
            reject => { root.host-key-reject(); }
            accept => { root.host-key-accept(); }
        }
    }

    // ── RDP cert dialog (P4.2) ────────────────────────────────────────────
    Modal {
        open: root.cert-dialog-open;
        dismissed => {}
        CertDialog {
            mismatch:           root.cert-dialog-mismatch;
            host:               root.cert-dialog-host;
            subject:            root.cert-dialog-subject;
            fingerprint:        root.cert-dialog-fingerprint;
            stored-fingerprint: root.cert-dialog-stored-fp;
            reject => { root.cert-reject(); }
            accept => { root.cert-accept(); }
        }
    }

    // ── P1.4: Profile editor modal ────────────────────────────────────────
    Modal {
        open: root.profile-editor-open;
        dismissed => { root.profile-editor-open = false; }
        ProfileEditor {
            form <=> root.profile-form;
            cred-name-list: root.cred-name-list;
            group-name-list: root.group-name-list;
            save   => { root.profile-save(); }
            cancel => { root.profile-editor-open = false; }
        }
    }

    // ── P1.4: Group editor modal ──────────────────────────────────────────
    Modal {
        open: root.group-editor-open;
        dismissed => { root.group-editor-open = false; }
        GroupEditor {
            form <=> root.group-form;
            cred-name-list: root.cred-name-list;
            group-name-list: root.group-name-list;
            save   => { root.group-save(); }
            cancel => { root.group-editor-open = false; }
        }
    }

    // ── P1.4: Credential editor modal ─────────────────────────────────────
    Modal {
        open: root.cred-editor-open;
        dismissed => { root.cred-editor-open = false; }
        CredEditor {
            form <=> root.cred-form;
            folder-name-list: root.folder-name-list;
            save   => { root.cred-save(); }
            cancel => { root.cred-editor-open = false; }
        }
    }

    // ── Command palette (last child = topmost z-layer) ────────────────────
    palette-modal := Modal {
        open: root.palette-open;
        dismissed => {
            root.palette-open = false;
            root.palette-selected = 0;
        }
        CommandPalette {
            query <=> root.palette-query;
            actions: root.palette-actions;
            selected-index <=> root.palette-selected;
            edited(q) => { root.palette-edited(q); }
            activated(idx) => {
                root.palette-open = false;
                root.palette-selected = 0;
                root.palette-activated(idx);
            }
        }
    }
}
