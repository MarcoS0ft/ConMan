// ConMan — main application window (Direction A shell, P1.4 panels).
//
// P1.4 additions over P2.8/P3.2 baseline:
//  • ConnRow gains `depth: int` for subgroup indentation.
//  • ConnectionRow gains CRUD hover buttons and group-toggle behaviour.
//  • New CredRow struct + CredTreeRow component for the Keys panel.
//  • New ConnProfile / GroupForm / CredFormData structs (in screen files).
//  • Keys panel is now a real credential folder tree (replaces the P2.8 stub).
//  • Connections panel header has New Group + New Connection buttons.
//  • ProfileEditor / GroupEditor / CredEditor modals mounted here.
//  • AppWindow gains credentials, cred-name-list, editor state + callbacks.
//
// BEHAVIOUR PRESERVED: TerminalSurface and its callbacks are UNCHANGED from P2.4.

import { Theme } from "theme.slint";
import {
    StatusDot, StatusPill, IconButton, ActivityBarButton,
    PrimaryButton, SecondaryButton, EmptyState, Toast
} from "components.slint";
import { ListView, Palette, LineEdit } from "std-widgets.slint";
import { Modal, QuickConnectForm, HostKeyDialog, CertDialog, KbdInteractiveDialog, KbdPromptRow, ImportPasswordDialog, DeleteConfirmationDialog } from "screens/dialogs.slint";
import { CommandPalette, PaletteAction } from "screens/command_palette.slint";
import { SettingsPanel } from "screens/settings_panel.slint";
import { ConnectingOverlay, ErrorOverlay, SearchOverlay } from "screens/session_overlays.slint";
import { Launchpad, RecentItem } from "screens/launchpad.slint";
import {
    ConnProfile, GroupForm, ProfileEditor, GroupEditor
} from "screens/profile_editor.slint";
import { CredFormData, CredEditor } from "screens/cred_editor.slint";

// ── Models ────────────────────────────────────────────────────────────────
// Toast entry for background-event notifications (P5.3b).
// kind: 0=info · 1=success · 2=warning · 3=error
export struct ToastEntry {
    id:      int,
    message: string,
    kind:    int,
}

export struct TabItem {
    title: string,
    id: int,
    status: string,
    pane-count: int,
    // P9.10 #3: the Launchpad-fronted "Home"/new-tab-without-a-live-session
    // tab (`Tab::is_empty` in the controller) isn't a connection -- it must
    // not show the connection StatusDot. Mirrors `Tab::is_empty` 1:1 (see
    // `push_tab`, the only place `TabItem` is constructed for a real
    // controller-driven tab).
    is-home: bool,
    // P9.10 #1: whether the tab context menu's "Duplicate" item has a
    // target to relaunch -- a stored-connection tab (`origin_connection_id`
    // is `Some`) or a plain local shell (`!is_remote`). `false` for a
    // quick-connect-originated remote tab (no stored settings to safely
    // relaunch) and for a reattached tab whose origin wasn't preserved --
    // omit the item rather than launch nothing (spec's explicit rule).
    can-duplicate: bool,
}

// P6.11: one entry per pane in the active tab's N-way split, computed in Rust
// from `PaneGroup::rects()` (fractional geometry) plus that pane's current
// frame image and surface kind. Drives the `pane-cells` repeater in the
// session area — only populated (non-empty) when the active tab has more
// than one pane; a single-pane tab keeps using `frame`/`rdp-frame`/
// `rdp-active` directly (unchanged since P2.4/P4.2).
export struct PaneCell {
    pane: int,
    x: float,
    y: float,
    w: float,
    h: float,
    frame: image,
    is-rdp: bool,
}

// Flattened connection-tree row.  `depth` drives left-indent (16 px per level).
// Rust flattens the group/connection tree into this list honouring expand/collapse.
export struct ConnRow {
    id: int,
    label: string,
    host: string,
    kind: string,      // "SSH" | "RDP" | "LOCAL" | "" (groups)
    status: string,
    is-group: bool,
    expanded: bool,
    selected: bool,
    depth: int,        // 0 = root level, 1 = inside a group, etc.
}

// Flattened credential-folder row for the Keys panel.  Mirrors ConnRow shape.
export struct CredRow {
    id: int,
    label: string,
    kind: string,      // "Password" | "SSH Key" | "SSH Key+PP" | "" (folder)
    username: string,
    is-folder: bool,
    expanded: bool,
    selected: bool,
    depth: int,
    // P9.5 #6: "" (folder rows, or a credential used by no connection) hides
    // the badge; otherwise a ready-made label ("Used by 1 connection" / "Used
    // by N connections") -- precomputed in Rust (keys_ctl::refresh_cred_model)
    // rather than formatted in .slint, matching `kind`'s existing pattern.
    used-by-label: string,
}

// ── TerminalSurface (verbatim from P2.4; background tokenised) ─────────────
component TerminalSurface inherits Rectangle {
    in property <image> frame;
    callback key-input(string, int, int);
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);
    callback resized(length, length);
    callback toggle-palette();

    pure function mods(c: bool, a: bool, s: bool, m: bool) -> int {
        (c ? 1 : 0) + (a ? 2 : 0) + (s ? 4 : 0) + (m ? 8 : 0)
    }

    background: Theme.color-terminal-bg;
    forward-focus: fs;

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "k" || e.text == "K")) {
                root.toggle-palette();
                accept
            } else {
                root.key-input(
                    e.text,
                    (e.text == Key.Return) ? 1
                        : (e.text == Key.Tab) ? 2
                        : (e.text == Key.Backspace) ? 3
                        : (e.text == Key.Escape) ? 4
                        : (e.text == Key.UpArrow) ? 5
                        : (e.text == Key.DownArrow) ? 6
                        : (e.text == Key.LeftArrow) ? 7
                        : (e.text == Key.RightArrow) ? 8
                        : (e.text == Key.Home) ? 9
                        : (e.text == Key.End) ? 10
                        : (e.text == Key.PageUp) ? 11
                        : (e.text == Key.PageDown) ? 12
                        : (e.text == Key.Delete) ? 14
                        : 0,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
                accept
            }
        }

        Image {
            source: frame;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: pixelated;
        }

        ta := TouchArea {
            pointer-event(e) => {
                fs.focus();
                root.pointer(
                    e.button == PointerEventButton.left ? 1
                        : e.button == PointerEventButton.right ? 2
                        : e.button == PointerEventButton.middle ? 3
                        : 0,
                    e.kind == PointerEventKind.down ? 1
                        : e.kind == PointerEventKind.up ? 2
                        : e.kind == PointerEventKind.move ? 3
                        : 0,
                    ta.mouse-x, ta.mouse-y,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
            }
            scroll-event(e) => {
                root.scroll(e.delta-x, e.delta-y);
                accept
            }
        }
    }

    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
}

// ── RdpSurface (P4.2) ──────────────────────────────────────────────────────
// Framebuffer surface for RDP sessions. Renders a decoded RGBA slint::Image and
// forwards keyboard (both key-down AND key-up), pointer, and scroll events to the
// controller for conversion to IronRDP FastPath PDUs.
//
// Key design differences from TerminalSurface (which is FROZEN):
//  - Uses both `key-pressed` and `key-released` events (RDP needs key-up PDUs).
//  - `special()` pure function exposes F-key codes to the controller.
//  - Background is pure black (the framebuffer fills it).
//  - No toggle-palette callback (Ctrl-K palette is handled at the AppWindow level).
component RdpSurface inherits Rectangle {
    in property <image> frame;
    // key-down: fired on key-pressed (key-down PDU to RDP).
    callback key-down(string /* text */, int /* special */, int /* mods */);
    // key-up: fired on key-released (key-up PDU to RDP).
    callback key-up(string /* text */, int /* special */, int /* mods */);
    callback pointer(int /* button */, int /* kind */, length /* x */, length /* y */, int /* mods */);
    // rdp-scroll: passes actual pointer position (carry-over fix c).
    callback rdp-scroll(length /* x */, length /* y */, length /* dx */, length /* dy */);
    callback resized(length /* w */, length /* h */);

    pure function mods(c: bool, a: bool, s: bool, m: bool) -> int {
        (c ? 1 : 0) + (a ? 2 : 0) + (s ? 4 : 0) + (m ? 8 : 0)
    }

    // Maps Slint Key.* strings to the same special codes used by TerminalSurface
    // (plus F1–F12) so the Rust input module can produce the right PS/2 scancodes.
    pure function special(text: string) -> int {
        (text == Key.Return)    ? 1
        : (text == Key.Tab)       ? 2
        : (text == Key.Backspace) ? 3
        : (text == Key.Escape)    ? 4
        : (text == Key.UpArrow)   ? 5
        : (text == Key.DownArrow) ? 6
        : (text == Key.LeftArrow) ? 7
        : (text == Key.RightArrow)? 8
        : (text == Key.Home)      ? 9
        : (text == Key.End)       ? 10
        : (text == Key.PageUp)    ? 11
        : (text == Key.PageDown)  ? 12
        : (text == Key.Delete)    ? 14
        : (text == Key.F1)        ? 15
        : (text == Key.F2)        ? 16
        : (text == Key.F3)        ? 17
        : (text == Key.F4)        ? 18
        : (text == Key.F5)        ? 19
        : (text == Key.F6)        ? 20
        : (text == Key.F7)        ? 21
        : (text == Key.F8)        ? 22
        : (text == Key.F9)        ? 23
        : (text == Key.F10)       ? 24
        : (text == Key.F11)       ? 25
        : (text == Key.F12)       ? 26
        : 0
    }

    background: Theme.color-terminal-bg;
    forward-focus: rdp-fs;

    rdp-fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(e) => {
            root.key-down(
                e.text,
                root.special(e.text),
                root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)
            );
            accept
        }

        key-released(e) => {
            root.key-up(
                e.text,
                root.special(e.text),
                root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)
            );
            accept
        }

        Image {
            source: frame;
            width: 100%;
            height: 100%;
            // P9.5 #10: `contain` (not `fill`) -- the controller now
            // negotiates the RDP desktop at the pane's live pixel size (see
            // `sessions::apply_pane_resolution`), so this is a 1:1 no-op in
            // the common case; `contain` only matters (no distortion,
            // letterboxed instead) for the brief window before a resize
            // settles, or if a server clamps the requested resolution.
            image-fit: contain;
            image-rendering: pixelated;
        }

        rdp-ta := TouchArea {
            pointer-event(e) => {
                rdp-fs.focus();
                root.pointer(
                    e.button == PointerEventButton.left   ? 1
                        : e.button == PointerEventButton.right  ? 2
                        : e.button == PointerEventButton.middle ? 3
                        : 0,
                    e.kind == PointerEventKind.down  ? 1
                        : e.kind == PointerEventKind.up   ? 2
                        : e.kind == PointerEventKind.move ? 3
                        : 0,
                    rdp-ta.mouse-x, rdp-ta.mouse-y,
                    root.mods(e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
            }
            scroll-event(e) => {
                // Pass actual pointer position (carry-over fix c: was surface centre).
                root.rdp-scroll(rdp-ta.mouse-x, rdp-ta.mouse-y, e.delta-x, e.delta-y);
                accept
            }
        }
    }

    changed width  => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
}

// ── Tab ────────────────────────────────────────────────────────────────────
component Tab inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <int>    pane-count: 1;
    in property <bool>   active;
    // P9.10 #3: the Home tab isn't a connection -- it shows a house glyph
    // (Codicon `cod-home`, same icon family as this row's own close button
    // just below) instead of the connection StatusDot.
    in property <bool>   is-home: false;
    // P8.1: position within the tab strip, supplied by the `for` loop at the
    // call site — repeated items disambiguate via item-index/item-count, not
    // label suffixes (the contract's rule).
    in property <int>    item-index: 0;
    in property <int>    item-count: 1;
    // P9.10 #1: whether "Duplicate" has a target to relaunch -- see
    // `TabItem::can_duplicate`'s doc comment (Rust side) for the exact rule.
    in property <bool>   can-duplicate: false;
    callback clicked();
    callback closed();
    // P9.10 #1: the tab context menu's session actions -- Home never wires
    // these (see the ContextMenuArea below), so the controller doesn't need
    // its own `is-home` guard at the callback site, just the usual
    // out-of-range `idx` one every other tab callback already has.
    callback reconnect-clicked();
    callback disconnect-clicked();
    callback duplicate-clicked();

    // P8.1: one tab per session; label is the (dynamic) tab title.
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-index: root.item-index;
    accessible-item-count: root.item-count;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    height: Theme.tab-height;
    border-radius: Theme.radius-sm + 0px;
    background: active ? Theme.color-card : (touch.has-hover ? Theme.color-hover : transparent);

    touch := TouchArea { clicked => { root.clicked(); } }

    // P9.10 #1: right-click menu, mirroring the connection tree row's
    // ContextMenuArea/Menu/MenuItem shape (app.slint's ConnectionRow,
    // `if !data.is-group : MenuItem {...}` conditional-item pattern). Home
    // suppresses every session item -- there is no session to reconnect/
    // disconnect/duplicate -- but "Close" is still offered everywhere,
    // mirroring `close-tab-btn`'s own always-present behavior.
    ContextMenuArea {
        Menu {
            if !root.is-home : MenuItem {
                title: "Reconnect";
                activated => { root.reconnect-clicked(); }
            }
            if !root.is-home : MenuItem {
                title: "Disconnect";
                activated => { root.disconnect-clicked(); }
            }
            if !root.is-home && root.can-duplicate : MenuItem {
                title: "Duplicate";
                activated => { root.duplicate-clicked(); }
            }
            if !root.is-home : MenuSeparator {}
            MenuItem {
                title: "Close";
                activated => { root.closed(); }
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        // P9.10 #3: an explicit fixed width (the larger of the dot's default
        // 7px diameter and the glyph's icon-xs size) so this cell reserves
        // the SAME space in every tab -- the title's x-position never shifts
        // between a Home tab and a normal one.
        VerticalLayout {
            width: Theme.icon-xs;
            alignment: center;
            if !root.is-home : StatusDot { state: root.status; }
            if root.is-home : Text {
                text: "\u{EB06}"; // cod-home
                font-family: Theme.font-family-icons;
                font-size: Theme.icon-xs;
                color: Theme.color-text-secondary;
                horizontal-alignment: center;
                width: 100%;
            }
        }
        Text {
            text: title;
            color: active ? Theme.color-text : Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
        if root.pane-count > 1 : Rectangle {
            y: (parent.height - self.height) / 2;
            height: 16px;
            border-radius: Theme.radius-sm - 2px;
            background: Theme.color-accent-subtle;
            HorizontalLayout {
                padding-left: 5px; padding-right: 5px;
                Text {
                    text: "⊟ " + root.pane-count;
                    color: Theme.color-accent;
                    font-size: Theme.font-xxs;
                    font-family: Theme.font-family-mono;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            close-tab-btn := IconButton {
                glyph: "\u{EA76}";
                size: 16px;
                glyph-size: Theme.icon-xs;
                tooltip: "Close tab";
                clicked => { root.closed(); }
            }
        }
    }
}

// ── ConnectionRow (P1.4: depth-indent + hover CRUD buttons) ────────────────
// The base `touch` is the FIRST child so the HorizontalLayout (holding the
// interactive action buttons) is rendered on top and captures clicks first —
// the same pattern used by the Tab component's close button.
component ConnectionRow inherits Rectangle {
    in property <ConnRow> data;
    // P5.3b: keyboard-navigation cursor highlight (driven by parent's kb-idx).
    in property <bool> highlighted: false;
    // P8.1: position within the flattened tree, supplied by the `for` loop.
    in property <int> row-index: 0;
    in property <int> row-count: 0;
    // P9.5 #2: single click on a leaf row selects/highlights (`selected`);
    // double click launches (`activated`). Groups aren't affected -- a
    // single click still expands/collapses (`toggled`), which was never the
    // "launches accidentally" complaint. Keyboard Enter and the context
    // menu's "Connect" still call `activated()` directly (see `touch`
    // below) -- only the plain mouse click path changes.
    callback activated();       // open session tab (leaf) -- double-click
    callback selected();        // select/highlight (leaf) -- single-click
    callback toggled();         // expand / collapse group
    callback edit-clicked();    // open profile / group editor
    callback new-sub();         // new child item under this group
    callback duplicate-clicked(); // P6.10: clone this connection (leaf only)
    // P6.10 / P6.11: open this connection into the active tab's next pane
    // slot (leaf only). SSH/Local/RDP all supported since P6.11 lifted the
    // RDP-in-pane deferral — see the ContextMenuArea comment below.
    callback connect-in-split-clicked();
    callback delete-clicked();
    callback move-up();         // reorder: move one step up within same parent
    callback move-down();       // reorder: move one step down within same parent

    // P8.1: a flattened tree row rendered inside a ListView — `list-item` is
    // the closest role Slint 1.17 offers (no distinct tree-item role); label
    // is the connection/group name, per the contract's dynamic-content rule.
    accessible-role: list-item;
    accessible-label: data.label;
    accessible-item-index: root.row-index;
    accessible-item-count: root.row-count;
    accessible-item-selected: data.selected;
    accessible-action-default => { if (data.is-group) { root.toggled(); } else { root.activated(); } }

    // P9.5 #1: latched by each action button's `hover-changed` callback
    // (see IconButton in components.slint) -- one property per button since
    // they're all conditionally instantiated `if root.action-hover`, and
    // Slint won't let `action-hover`'s own formula read a conditional
    // instance's property from outside its conditional ("Cannot access
    // id"). Each defaults to `false` and is written ONLY by its own
    // button's callback, so there's no shared-write race between buttons.
    property <bool> move-up-hover: false;
    property <bool> move-down-hover: false;
    property <bool> new-child-hover: false;
    property <bool> edit-hover: false;
    property <bool> delete-hover: false;

    // Whether ANY part of the row -- background OR the action-icon strip
    // itself -- currently has the pointer over it. `touch` (below) no
    // longer extends under the icon strip at all (P9.5 #1 follow-up, see
    // `content`'s comment), so this OR exists only to keep the strip
    // latched-visible across the hand-off from `touch`'s cell to a button's
    // own cell as the pointer crosses that (now non-overlapping) boundary --
    // without it, `touch.has-hover` alone would drop to false the instant
    // the cursor leaves `touch`'s cell and enters the icon strip's, which
    // would destroy the `if root.action-hover` strip out from under the
    // pointer (the original P9.5 #1 flicker bug). ORing in every button's
    // latched hover state keeps the combined signal true continuously as
    // the pointer crosses that boundary: exactly one of these TouchAreas is
    // hovering the pointer at any instant, so the OR never has a gap.
    property <bool> action-hover: touch.has-hover
        || root.move-up-hover || root.move-down-hover || root.new-child-hover
        || root.edit-hover || root.delete-hover;

    height: Theme.tree-row-height;
    border-radius: Theme.radius-sm;
    background: data.selected ? Theme.color-accent-subtle
              : root.highlighted ? Theme.color-accent-subtle.with-alpha(0.5)
              : root.action-hover ? Theme.color-hover : transparent;

    // Accent rail (selected connection).
    Rectangle {
        x: 0px; width: 2.5px; height: Theme.tag-height;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xs - 1px;
        background: data.selected ? Theme.color-accent : transparent;
    }

    HorizontalLayout {
        padding-left: (data.depth * 16px) + (data.is-group ? Theme.space-1 : Theme.space-3);
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        // P9.5 #1 follow-up (.99 GPU visual verify, Bug A -- "hover icons
        // are stable but unclickable"): `touch` used to be a bare sibling of
        // this WHOLE HorizontalLayout, sized to cover the entire row --
        // including the pixels the hover action-icon strip (below) renders
        // into once it exists. That left `touch` and the icon strip as
        // OVERLAPPING siblings whose relative click priority depended on
        // Slint's FrontToBack sibling-traversal order (last-declared visited
        // first) -- correct on paper (confirmed by reading i-slint-core's
        // actual `send_mouse_event_to_item`/`TouchArea::input_event`), but a
        // real pointer on real GPU-backed hardware still couldn't reliably
        // land clicks on the icons, and this headless harness can't
        // reproduce real-pointer input to prove or disprove why (see
        // suite_connections_tree.rs's own note: every existing suite drives
        // callbacks directly, never literal pointer coordinates). Rather
        // than keep correctness resting on that traversal-order subtlety,
        // mirror ../SafeTunnel's pattern (apps/windows/ui/detail_pane.slint):
        // give the clickable row body and the action-icon strip their OWN
        // adjacent, NON-OVERLAPPING cells in this layout, so a click
        // physically cannot land on both. `content` below scopes `touch` to
        // the dot/label/tag cell only; the icon strip is a separate later
        // cell entirely outside `touch`'s geometry.
        content := Rectangle {
            horizontal-stretch: 1;

            // Base touch -- click/double-click for select/launch/toggle.
            // P9.5 #2: single click selects a leaf row; double click
            // launches it (`clicked` fires on every physical click,
            // `double-clicked` fires additionally on the 2nd/4th/... click
            // of a rapid sequence -- Slint's own click-count tracking, no
            // hand-rolled timer needed). Groups keep single-click-to-toggle,
            // unaffected -- that was never the "launches accidentally"
            // complaint.
            touch := TouchArea {
                clicked => {
                    if (data.is-group) { root.toggled(); }
                    else { root.selected(); }
                }
                double-clicked => {
                    if (!data.is-group) { root.activated(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-2;

                VerticalLayout {
                    alignment: center;
                    if data.is-group : Text {
                        text: data.expanded ? "\u{EAB4}" : "\u{EAB6}";
                        font-family: Theme.font-family-icons;
                        font-size: Theme.icon-xs;
                        color: Theme.color-text-secondary;
                    }
                    if !data.is-group : StatusDot { state: data.status; diameter: 6px; }
                }

                Text {
                    text: data.label;
                    color: data.is-group ? Theme.color-text
                         : data.selected ? Theme.color-text : Theme.color-text-secondary;
                    font-size: Theme.font-base;
                    font-family: Theme.font-family;
                    font-weight: data.is-group ? 600 : 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !data.is-group && data.kind != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: Theme.tag-height;
                        border-radius: Theme.radius-xs;
                        background: Theme.color-hover;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text {
                                text: data.kind;
                                color: Theme.color-text-secondary;
                                font-size: Theme.font-xxs;
                                font-family: Theme.font-family-mono;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Hover action buttons (shown only while the pointer is over the
        // row). Gated on `root.action-hover`, not the base `touch.has-hover`
        // alone -- see the property's doc comment above for why (P9.5 #1). A
        // separate cell from `content` above, never overlapping it, so a
        // click here can never also land on `touch`.
        if root.action-hover : HorizontalLayout {
            spacing: Theme.gap-hairline;
            alignment: center;
            // ↑ / ↓ reorder within the same parent.
            move-up-btn := IconButton {
                glyph: "\u{EAB7}";   // ChevronUp
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: "Move up";
                clicked => { root.move-up(); }
                hover-changed(h) => { root.move-up-hover = h; }
            }
            move-down-btn := IconButton {
                glyph: "\u{EAB4}";   // ChevronDown
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: "Move down";
                clicked => { root.move-down(); }
                hover-changed(h) => { root.move-down-hover = h; }
            }
            // Group: new-child + edit; Connection: edit (pencil).
            if data.is-group : new-child-btn := IconButton {
                glyph: "\u{EA60}";   // Add (new child)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: "New child";
                clicked => { root.new-sub(); }
                hover-changed(h) => { root.new-child-hover = h; }
            }
            edit-row-btn := IconButton {
                glyph: "\u{F03EB}";   // Edit (pencil)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: data.is-group ? "Edit group" : "Edit";
                clicked => { root.edit-clicked(); }
                hover-changed(h) => { root.edit-hover = h; }
            }
            delete-row-btn := IconButton {
                glyph: "\u{EA81}";   // Delete (trash)
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                glyph-color: Theme.color-error;
                tooltip: "Delete";
                clicked => { root.delete-clicked(); }
                hover-changed(h) => { root.delete-hover = h; }
            }
        }
    }

    // P9.12 #1 (regression from Bug A `269a5e5`, fixed): right-click on a
    // connection row stopped opening this menu after `touch` moved from a
    // bare row-spanning sibling into the `content` cell above. Root cause,
    // confirmed against i-slint-core: mouse dispatch visits siblings
    // FrontToBack (last-declared first); `TouchArea::input_event` grabs
    // UNCONDITIONALLY on Press for ANY button, not just left (`items/
    // input_items.rs`'s `Pressed` arm sets `self.grabbed`/returns
    // `GrabMouse` regardless of `button`). Before `269a5e5`, this
    // `ContextMenuArea` was declared BEFORE the row's content, so it was
    // visited (and got first crack at every click, including right-clicks)
    // BEFORE `touch`. Wrapping `touch` inside `content` (still needed --
    // that fix is correct and unrelated) left `ContextMenuArea` declared
    // BEFORE the HorizontalLayout that now contains `touch`, inverting the
    // priority: `touch` got visited first and grabbed the right-click before
    // `ContextMenuArea` ever saw it. Fix: declare `ContextMenuArea` LAST
    // (after the row's whole HorizontalLayout) instead of nesting it around
    // the content -- nesting alone wouldn't help, since `touch` would still
    // be reached (and still grab) as a DESCENDANT before `ContextMenuArea`'s
    // own fallback `input_event` ever runs. Declaring it last means it's
    // visited FIRST: for a right-click, its own `input_event` (`items.rs`'s
    // `ContextMenu` impl) matches `PointerEventButton::Right` immediately and
    // accepts, before `touch` is ever reached. For anything else (left
    // click), it returns `EventIgnored`, which continues the sibling walk to
    // the HorizontalLayout/`touch`/icon-strip exactly as before -- so
    // left-click select, double-click launch, and the hover-icon clicks
    // (the whole Bug-A/A' set) are all unaffected; verified via the full
    // existing element-suite pass, which still exercises every one of those
    // paths and stayed green. Items/callbacks below are unchanged.
    ContextMenuArea {
        Menu {
            if !data.is-group : MenuItem {
                title: "Connect";
                activated => { root.activated(); }
            }
            if !data.is-group : MenuItem {
                title: "Connect in split";
                activated => { root.connect-in-split-clicked(); }
            }
            if data.is-group : MenuItem {
                title: "New child";
                activated => { root.new-sub(); }
            }
            MenuSeparator {}
            MenuItem {
                title: data.is-group ? "Edit group" : "Edit";
                activated => { root.edit-clicked(); }
            }
            if !data.is-group : MenuItem {
                title: "Duplicate";
                activated => { root.duplicate-clicked(); }
            }
            if !data.is-group : MenuSeparator {}
            if !data.is-group : MenuItem {
                title: "Move up";
                activated => { root.move-up(); }
            }
            if !data.is-group : MenuItem {
                title: "Move down";
                activated => { root.move-down(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Delete";
                activated => { root.delete-clicked(); }
            }
        }
    }
}

// ── CredTreeRow — Keys panel tree row ─────────────────────────────────────
component CredTreeRow inherits Rectangle {
    in property <CredRow> data;
    // P5.3b: keyboard-navigation cursor highlight.
    in property <bool> highlighted: false;
    // P8.1: position within the flattened folder tree, supplied by the `for` loop.
    in property <int> row-index: 0;
    in property <int> row-count: 0;
    callback activated();
    callback toggled();
    callback new-sub();
    callback delete-clicked();

    // P8.1: same list-item rationale as ConnectionRow — label is the
    // credential/folder name (dynamic content).
    accessible-role: list-item;
    accessible-label: data.label;
    accessible-item-index: root.row-index;
    accessible-item-count: root.row-count;
    accessible-item-selected: data.selected;
    accessible-action-default => { if (data.is-folder) { root.toggled(); } else { root.activated(); } }

    // P9.5 #1 (closing the identical latent bug flagged in the connection
    // tree's own fix): same reasoning as `ConnectionRow::action-hover` in
    // this file -- `touch` (now scoped to `content`, see below) and the
    // action-icon strip are adjacent, non-overlapping cells, so gating the
    // strip's existence on `touch.has-hover` alone is unstable across that
    // cell boundary (Slint hands the pointer to whichever button is
    // topmost, synthesizing an Exit for `touch` that destroys the
    // `if`-gated strip out from under the pointer). ORing in each button's
    // own latched hover (via `IconButton::hover-changed`, see
    // `move-up-hover` etc. on ConnectionRow for the full mechanism/why)
    // keeps the combined signal stable across that boundary.
    property <bool> new-cred-hover: false;
    property <bool> edit-cred-hover: false;
    property <bool> delete-cred-hover: false;
    property <bool> action-hover: touch.has-hover
        || root.new-cred-hover || root.edit-cred-hover || root.delete-cred-hover;

    height: Theme.tree-row-height;
    border-radius: Theme.radius-sm;
    background: data.selected ? Theme.color-accent-subtle
              : root.highlighted ? Theme.color-accent-subtle.with-alpha(0.5)
              : root.action-hover ? Theme.color-hover : transparent;

    HorizontalLayout {
        padding-left: (data.depth * 16px) + (data.is-folder ? Theme.space-1 : Theme.space-3);
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        // P9.11: mirrors `ConnectionRow`'s identical `content` cell (Bug A,
        // `269a5e5`) -- `touch` used to be a bare sibling of this whole
        // HorizontalLayout, sized to cover the entire row including the
        // pixels the hover action-icon strip (below) renders into once it
        // exists, leaving `touch` and the strip as OVERLAPPING siblings
        // whose relative click priority depended on Slint's FrontToBack
        // sibling-traversal order. See `ConnectionRow`'s `content` comment
        // for the full investigation (i-slint-core's `send_mouse_event_to_
        // item`/`TouchArea::input_event`) -- correctness now rests on
        // non-overlapping geometry instead: `content` scopes `touch` to the
        // tree-icon/label/tag cell only; the icon strip is a separate later
        // cell entirely outside `touch`'s geometry.
        content := Rectangle {
            horizontal-stretch: 1;

            touch := TouchArea {
                clicked => {
                    if (data.is-folder) { root.toggled(); }
                    else { root.activated(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-2;

                VerticalLayout {
                    alignment: center;
                    if data.is-folder : Text {
                        text: data.expanded ? "\u{EAB4}" : "\u{EAB6}";
                        font-family: Theme.font-family-icons;
                        font-size: Theme.icon-xs;
                        color: Theme.color-text-secondary;
                    }
                    if !data.is-folder : Rectangle {
                        width: 7px; height: 7px;
                        border-radius: 4px;
                        background: Theme.color-accent-subtle;
                    }
                }

                Text {
                    text: data.label;
                    color: data.is-folder ? Theme.color-text : Theme.color-text-secondary;
                    font-size: Theme.font-base;
                    font-family: Theme.font-family;
                    font-weight: data.is-folder ? 600 : 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !data.is-folder && data.username != "" : VerticalLayout {
                    alignment: center;
                    Text {
                        text: data.username;
                        color: Theme.color-text-disabled;
                        font-size: Theme.font-xxs;
                        font-family: Theme.font-family-mono;
                        vertical-alignment: center;
                    }
                }

                if !data.is-folder && data.kind != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: Theme.tag-height;
                        border-radius: Theme.radius-xs;
                        background: Theme.color-hover;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text {
                                text: data.kind;
                                color: Theme.color-text-secondary;
                                font-size: Theme.font-xxs;
                                font-family: Theme.font-family-mono;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // P9.5 #6: "used by N connections" indicator -- mirrors the
                // `kind` tag immediately above; hidden (empty label) for
                // folders and for a credential nothing currently references
                // directly.
                if !data.is-folder && data.used-by-label != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: Theme.tag-height;
                        border-radius: Theme.radius-xs;
                        background: Theme.color-hover;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text {
                                text: data.used-by-label;
                                color: Theme.color-text-secondary;
                                font-size: Theme.font-xxs;
                                font-family: Theme.font-family-mono;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Gated on `root.action-hover`, not bare `touch.has-hover` -- see the
        // property's doc comment above (P9.5 #1). A separate cell from
        // `content` above, never overlapping it, so a click here can never
        // also land on `touch` (P9.11).
        if root.action-hover : HorizontalLayout {
            spacing: Theme.gap-hairline;
            alignment: center;
            if data.is-folder : new-cred-btn := IconButton {
                glyph: "\u{EA60}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: "New credential";
                clicked => { root.new-sub(); }
                hover-changed(h) => { root.new-cred-hover = h; }
            }
            if !data.is-folder : edit-cred-btn := IconButton {
                glyph: "\u{F03EB}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                tooltip: "Edit";
                clicked => { root.activated(); }
                hover-changed(h) => { root.edit-cred-hover = h; }
            }
            delete-cred-btn := IconButton {
                glyph: "\u{EA81}";
                size: Theme.icon-btn; glyph-size: Theme.icon-xs;
                glyph-color: Theme.color-error;
                tooltip: "Delete";
                clicked => { root.delete-clicked(); }
                hover-changed(h) => { root.delete-cred-hover = h; }
            }
        }
    }

    // P9.12 #1 (regression from Bug A's `content`/`touch` restructure,
    // ported to CredTreeRow in P9.11 -- see `ConnectionRow`'s identical
    // comment for the full i-slint-core mechanism): declared LAST so
    // FrontToBack visits it FIRST, before `touch` (a descendant of the
    // HorizontalLayout above) ever gets a chance to grab the right-click.
    ContextMenuArea {
        Menu {
            if data.is-folder : MenuItem {
                title: "New credential";
                activated => { root.new-sub(); }
            }
            if !data.is-folder : MenuItem {
                title: "Edit";
                activated => { root.activated(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Delete";
                activated => { root.delete-clicked(); }
            }
        }
    }
}

// ── PaneSlot (P5.1; generalized to N panes + RDP-in-pane in P6.11) ─────────
// Wraps either a TerminalSurface or an RdpSurface (picked by `is-rdp`) with
// pane-index identity so multi-pane layouts can track focus and route events
// per pane. TerminalSurface/RdpSurface internals are FROZEN (P2.4/P4.2);
// PaneSlot adds only an outer border + `pane-focused` routing + the
// terminal/RDP callback forwarding, unified under one set of names.
component PaneSlot inherits Rectangle {
    in property <image>  frame;
    in property <bool>   is-focused;
    in property <int>    pane-index;
    in property <bool>   is-rdp;
    // P9.10 #2: true only when this pane is one of several in a split (the
    // repeater sets it from `pane-cells.length > 1`) -- a single-pane tab has
    // nothing to "disconnect FROM" without closing the whole tab, so there is
    // no affordance to show there at all.
    in property <bool>   show-disconnect: false;
    callback pane-focused(int);   // tell the parent which pane was clicked
    callback key-input(string, int, int);   // terminal panes
    callback key-down(string, int, int);    // RDP panes
    callback key-up(string, int, int);      // RDP panes
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);                        // terminal panes
    callback rdp-scroll(length, length, length, length);    // RDP panes
    callback resized(length, length);
    callback toggle-palette();
    // P9.10 #2: per-pane disconnect -- arg is `root.pane-index` (this pane's
    // real id), not the repeater's own iteration index.
    callback pane-disconnect(int);

    // Hairline border always visible (panes are placed edge-to-edge with no
    // separate divider rectangle — P6.11's absolutely-positioned N-way
    // layout replaces the old HorizontalLayout/VerticalLayout dividers);
    // accent + thicker when focused.
    border-width: root.is-focused ? 1.5px : 1px;
    border-color: root.is-focused ? Theme.color-accent : Theme.color-stroke;
    clip: true;

    if !root.is-rdp : TerminalSurface {
        width: 100%; height: 100%;
        frame: root.frame;
        key-input(t, s, m) => { root.key-input(t, s, m); }
        pointer(b, k, x, y, m) => {
            root.pane-focused(root.pane-index);
            root.pointer(b, k, x, y, m);
        }
        scroll(dx, dy) => { root.scroll(dx, dy); }
        resized(w, h)  => { root.resized(w, h); }
        toggle-palette => { root.toggle-palette(); }
    }

    if root.is-rdp : RdpSurface {
        width: 100%; height: 100%;
        frame: root.frame;
        key-down(t, s, m) => { root.key-down(t, s, m); }
        key-up(t, s, m)   => { root.key-up(t, s, m); }
        pointer(b, k, x, y, m) => {
            root.pane-focused(root.pane-index);
            root.pointer(b, k, x, y, m);
        }
        rdp-scroll(x, y, dx, dy) => { root.rdp-scroll(x, y, dx, dy); }
        resized(w, h) => { root.resized(w, h); }
    }

    // P9.10 #2: per-pane disconnect affordance. Declared LAST (renders on
    // top of the terminal/RDP surface above), but deliberately a SMALL
    // corner element rather than a pane-wide hover-tracking overlay: a
    // full-area `TouchArea` layered over the surface to detect "is the
    // pointer somewhere in this pane" would grab every press meant for the
    // terminal/RDP content underneath it (Slint's `TouchArea` grabs
    // unconditionally on Press regardless of which callbacks are wired --
    // the exact mechanism Bug A's investigation traced through
    // `i-slint-core`), breaking real terminal typing/RDP input entirely.
    // Always visible (not hover-gated) when in a split, mirroring the tab
    // strip's own always-visible `close-tab-btn` -- small, in its own
    // corner, never overlapping the interactive surface below it.
    if root.show-disconnect : Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: Theme.color-overlay.with-alpha(0.65);
        IconButton {
            glyph: "\u{EA76}"; // cod-close -- same glyph as the tab strip's close button
            size: 24px;
            glyph-size: Theme.icon-xs;
            tooltip: "Disconnect this pane";
            clicked => { root.pane-disconnect(root.pane-index); }
        }
    }
}

// ── AppWindow ──────────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    title: "ConMan";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.color-base;
    // Note: forward-focus is intentionally NOT set here because the active session
    // surface (terminal or RDP) is conditional. Each surface's FocusScope grabs focus
    // on the first pointer click via fs.focus() / rdp-fs.focus().

    // ── Session / tabs (P2.4 contract unchanged) ──────────────────────
    in property <[TabItem]> tabs;
    in property <int>       active-tab;
    in property <image>     frame;
    // ── RDP surface (P4.2) ────────────────────────────────────────────
    // rdp-frame: the decoded RGBA image from the active RDP session.
    // rdp-active: true while an RDP tab is the active tab.
    in property <image>     rdp-frame;
    in-out property <bool>  rdp-active: false;

    // ── Side panel ────────────────────────────────────────────────────
    in property <[ConnRow]> connections;
    in-out property <int>   active-panel: 0;
    in-out property <bool>  sidebar-collapsed: false;
    // P6.9 (gap 11): live + persisted side-panel width in logical px. Plain
    // `int` (not `length`) — the Rust side stores/round-trips it as a plain
    // pixel integer via the settings table, same as every other persisted
    // int preference (theme-mode, density, ...).
    in-out property <int>   sidebar-width: Theme.side-panel-width / 1px;
    // Fired once per drag gesture (on pointer-up), not on every intermediate
    // move — avoids spamming the settings DB while dragging.
    callback sidebar-width-changed(int);
    // P5.3b: live search/filter for the connection tree and keys tree.
    in-out property <string> conn-filter: "";
    in-out property <string> cred-filter: "";
    callback conn-filter-changed(string);
    callback cred-filter-changed(string);
    // P5.3b: toast notifications for background events.
    in property <[ToastEntry]> toasts;
    callback toast-dismissed(int);  // arg = ToastEntry.id

    // ── Keys panel data ───────────────────────────────────────────────
    in property <[CredRow]>  credentials;
    // Flat list of credential names for all dropdowns.
    // Index 0 = "Inherit from group" / "No default"; 1.. = credential names.
    in property <[string]>   cred-name-list;
    // Flat folder name list for the credential editor's folder picker.
    in property <[string]>   folder-name-list;
    // Flat list of group names for the group/parent pickers in editors.
    // Index 0 = "Root (no group)"; 1.. = group names in sort order.
    in property <[string]>   group-name-list;

    // ── Status bar / broadcast ────────────────────────────────────────
    in property <string>  session-status: "disconnected";
    in property <string>  session-identity: "";
    in-out property <bool> broadcast-active: false;

    // ── P5.1 / P6.11: Split panes (generalized 2-pane → N-pane) ────────
    // pane-layout: legacy display value (0=single, 1=H-split, 2=V-split) --
    // kept for the single-pane (0) case and informational display; N-way
    // geometry (3+ panes, or any RDP-in-pane mix) is driven entirely by
    // `pane-cells` below instead.
    in property <int>    pane-layout: 0;
    // P6.11: one entry per pane in the active tab (empty/1 entry when the
    // tab isn't split — see `PaneCell`'s doc comment). Renders via the N-way
    // repeater in the session area, replacing the old fixed 2-pane
    // HSplit/VSplit branches.
    in property <[PaneCell]> pane-cells;
    // Which pane is currently focused (0-based pane id).
    in-out property <int> active-pane: 0;
    // Number of detached (background) sessions — shown in palette.
    in property <int> detached-count: 0;
    // Callbacks: split/close/focus/resize.
    callback split-pane-h();
    callback split-pane-v();
    callback close-pane();
    callback detach-session();
    callback pane-focused(int);
    callback pane-resized(int, length, length);
    // P9.10 #2: per-pane disconnect inside a split -- arg is the pane id
    // (`PaneCell.pane`, same identity `pane-resized` already forwards),
    // never "whichever pane is focused" like `close-pane` above (a
    // right-clicked/hover-clicked pane need not be the focused one).
    callback pane-disconnect(int);
    // RDP-in-pane (P6.11): key/scroll callbacks fired from ANY pane's
    // RdpSurface, not only a whole-tab-is-RDP primary. Reuses the exact same
    // names the primary RDP surface already had (`rdp-key-down` etc., see
    // below) — the Rust handler routes by focused-pane id either way.

    // ── P6.11 (gap 14): broadcast targeting menu ────────────────────────
    // Never-silent status/broadcast-bar label naming the active target set
    // ("all panes" / "2 of 4 panes" / "group: <name>").
    in property <string> broadcast-target-label: "all panes";
    in-out property <bool> broadcast-target-open: false;
    // One entry per pane in the active tab (parallel to `pane-cells`'
    // indexing): `true` if that pane id is checked in the in-progress custom
    // selection.
    in property <[bool]> broadcast-pane-checks;
    // Names of this tab's saved custom selections ("named groups").
    in property <[string]> broadcast-saved-groups;
    in-out property <string> broadcast-group-name-draft: "";
    callback open-broadcast-target();
    callback close-broadcast-target();
    callback select-broadcast-visible();
    callback toggle-broadcast-pane-check(int);
    callback apply-broadcast-custom();
    callback save-broadcast-group();
    callback select-broadcast-group(int);

    // ── Command palette ───────────────────────────────────────────────
    in-out property <bool>           palette-open: false;
    in-out property <string>         palette-query: "";
    in property <[PaletteAction]>    palette-actions;
    in-out property <int>            palette-selected: 0;

    // ── Terminal search overlay (P6.7, Ctrl⇧F) ─────────────────────────
    in-out property <bool>   terminal-search-open: false;
    in-out property <string> terminal-search-query: "";
    // Total hits in the active tab's buffer, and the 0-based index of the
    // current one (`-1` when there are no matches) — the overlay renders
    // "current+1 / match-count".
    in property <int>        terminal-search-match-count: 0;
    in property <int>        terminal-search-current-index: -1;
    callback search-edited(string);
    callback search-next();
    callback search-prev();
    callback search-close();

    // ── Session overlays ──────────────────────────────────────────────
    in-out property <bool>   overlay-connecting: false;
    in-out property <bool>   overlay-error: false;
    in-out property <bool>   launchpad-open: false;
    // P6.9 (gap 16): the session layer only reports coarse `SessionStatus`
    // (Connecting/Connected/Failed/...) with no auth-stage sub-events, so the
    // overlay shows one honest live line ("Establishing an SSH connection…")
    // tagged with the real protocol kind, instead of a fake 3-step checklist
    // that used to sit stuck on a literal "Authenticating · ed25519" string.
    // See docs/devel/tasks/P6.9-shell-truth-ergonomics.md ("Out" scope note).
    in property <string>     connecting-kind: "";
    // Explicit security property for plain Telnet. It is refreshed from the
    // active tab, never inferred from titles or failure state.
    in property <bool>       session-insecure: false;
    in property <string>     error-reason: "";
    in property <string>     error-detail: "";
    // P9.12 #3: `ErrorOverlay` used to show the same "Connection failed"
    // title + red error styling for a genuine `Failed` session AND a clean
    // `Disconnected`/`Exited` end -- misleading (exiting a shell normally
    // looked like a failure). `true` only for a real `Failed` status;
    // `false` for `Disconnected`/`Exited` (see `overlays::update_overlays_
    // from_status`), which get a neutral "Session ended" title instead.
    in property <bool>       error-is-failure: true;
    in property <[RecentItem]> launchpad-recents;
    in-out property <string> launchpad-query: "";
    // P6.14: a real (time-of-day) greeting computed in Rust, replacing the
    // component's literal "Welcome back, ops" default.
    in property <string> launchpad-greeting: "Welcome back.";
    callback reconnect();
    // P6.9 (gap 16): opens the failed profile's editor (falls back to
    // quick-connect when the failed session has no originating stored
    // profile, e.g. a quick-connect session).
    callback edit-failed-profile();
    callback launchpad-edited(string);
    callback open-recent(int);
    callback open-group-split();

    // ── Quick-connect form (P3.2; P6.12 gap 20 adds the kind selector) ──
    in-out property <bool>   quick-connect-open: false;
    // 0 = SSH · 1 = RDP · 2 = Telnet · 3 = Local.
    in-out property <int>    qc-kind: 0;
    in-out property <string> qc-host: "";
    in-out property <string> qc-port: "22";
    in-out property <string> qc-username: "";
    in-out property <int>    qc-auth-method: 1;
    // SSH: private-key path / password (per qc-auth-method). RDP: password.
    in-out property <string> qc-secret: "";
    in-out property <string> qc-passphrase: "";
    // RDP-only fields.
    in-out property <string> qc-rdp-domain: "";
    in-out property <string> qc-rdp-resolution: "1280x720";
    // Local-only fields.
    in-out property <string> qc-local-program: "";
    in-out property <string> qc-local-args: "";
    in-out property <string> qc-local-cwd: "";
    callback qc-connect();

    // ── Host-key dialog (P3.2) ────────────────────────────────────────
    in-out property <bool>   host-key-open: false;
    in property <bool>       host-key-mismatch: false;
    in property <string>     host-key-host: "";
    in property <string>     host-key-type: "";
    in property <string>     host-key-fingerprint: "";
    in property <string>     host-key-stored-fp: "";
    callback host-key-accept();
    callback host-key-reject();

    // ── RDP cert dialog (P4.2) ───────────────────────────────────────
    in-out property <bool>   cert-dialog-open: false;
    in property <bool>       cert-dialog-mismatch: false;
    in property <string>     cert-dialog-host: "";
    in property <string>     cert-dialog-subject: "";
    in property <string>     cert-dialog-fingerprint: "";
    in property <string>     cert-dialog-stored-fp: "";
    callback cert-accept();
    callback cert-reject();

    // ── SSH keyboard-interactive dialog (P6.13) ───────────────────────
    in-out property <bool>          kbd-open: false;
    in property <string>            kbd-name: "";
    in property <string>            kbd-instructions: "";
    in property <[KbdPromptRow]>    kbd-prompts: [];
    callback kbd-answer-edited(int, string);
    callback kbd-submit();
    callback kbd-cancel();

    // ── mRemoteNG import password prompt (P9.4) ───────────────────────
    in-out property <bool>   import-password-open: false;
    in property <string>     import-password-file-name: "";
    callback import-password-edited(string);
    callback import-password-submit();
    callback import-password-cancel();

    // ── Destructive deletion confirmation ────────────────────────────
    in-out property <bool> delete-confirm-open: false;
    in property <string> delete-confirm-target-name: "";
    in property <bool> delete-confirm-is-group: false;
    in property <int> delete-confirm-group-count: 0;
    in property <int> delete-confirm-connection-count: 0;
    callback delete-confirm-accept();
    callback delete-confirm-cancel();

    // ── Appearance (P5.2: full settings exposed here) ────────────────
    in-out property <int>   theme-mode: 2;
    in-out property <int>   density    <=> Theme.density;
    in-out property <int>   accent-index: 0;
    in-out property <bool>  dark-mode  <=> Theme.dark-mode;
    in-out property <color> accent     <=> Theme.accent;
    // Keep std-widgets' native styling (LineEdit, ComboBox, ...) in sync with
    // the app's own dark/light token switch. `Theme.dark-mode` is our own
    // global and does NOT by itself affect native-widget styling -- that's
    // driven by std-widgets' `Palette.color-scheme`. Without this, inputs
    // (e.g. the profile editor's LineEdits, P7.2) keep rendering with the
    // environment's default scheme even after the user picks Dark/Light in
    // Settings, or after startup restores a persisted dark/light choice
    // (P6.17 gap V2).
    changed dark-mode => {
        Palette.color-scheme = self.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    // Terminal defaults
    in property <[string]> settings-font-families;
    in-out property <string> settings-font-family: "JetBrainsMono Nerd Font Mono";
    in-out property <int> settings-font-family-index: 0;
    in-out property <int>    settings-font-size: 13;
    in-out property <string> settings-shell-path: "";
    in-out property <string> settings-shell-args: "";
    in-out property <string> settings-shell-cwd: "";
    // Startup behavior: 0 = clean start, 1 = restore last session
    in-out property <int>    startup-behavior: 0;
    // Renderer backend (P7.1 cont.): 0 auto · 1 software · 2 hardware.
    // Applied on next launch; persisted to render.backend by the controller.
    in-out property <int>    render-backend: 0;

    // ── Automation / Agent mode (P8.6-B) ──────────────────────────────
    // See SettingsPanel's identically-named properties for the full doc
    // comments -- these just relay them between the controller and the panel.
    in property <bool>    agent-mode-available: false;
    in-out property <bool> agent-mode-enabled: false;
    in-out property <bool> agent-mode-scope-read: false;
    in-out property <bool> agent-mode-scope-write: false;
    in-out property <bool> agent-mode-scope-execute: false;
    in property <string>  agent-mode-connection-details: "";
    callback agent-mode-enabled-changed(bool);
    callback agent-mode-scope-read-changed(bool);
    callback agent-mode-scope-write-changed(bool);
    callback agent-mode-scope-execute-changed(bool);

    // ── P1.4: Profile editor modal ───────────────────────────────────
    in-out property <bool>        profile-editor-open: false;
    in-out property <ConnProfile> profile-form;
    callback profile-save();

    // ── P1.4: Group editor modal ──────────────────────────────────────
    in-out property <bool>      group-editor-open: false;
    in-out property <GroupForm> group-form;
    callback group-save();

    // ── P1.4: Credential editor modal ────────────────────────────────
    in-out property <bool>         cred-editor-open: false;
    in-out property <CredFormData> cred-form;
    callback cred-save();

    // ── Shell callbacks ───────────────────────────────────────────────
    callback select-tab(int);
    callback close-tab(int);
    // P9.10 #1: the tab strip's right-click context menu (mirrors the
    // connection tree row's ContextMenuArea/MenuItem shape). Home suppresses
    // these entirely (see the `Tab` instantiation below) -- there is no
    // session to reconnect/disconnect/duplicate.
    callback tab-reconnect(int);
    callback tab-disconnect(int);
    callback tab-duplicate(int);
    callback new-tab();
    callback select-panel(int);
    callback toggle-sidebar();
    callback open-palette();
    callback quick-connect();
    callback row-activated(int);
    // P9.5 #2: fired on a single click on a leaf connection row (select,
    // as opposed to `row-activated`'s double-click launch).
    callback row-selected(int);
    callback toggle-broadcast();
    callback palette-edited(string);
    callback palette-activated(int);
    callback theme-changed(int);
    callback density-changed(int);
    callback accent-changed(int);
    // P5.2 fix: restore persisted accent color at launch (called from Rust startup).
    // P6.8 (gap 10): a persisted "OS accent" selection (accent-index ==
    // Theme.os-accent-index) resolves to the live OS color instead of a preset.
    callback apply-accent-index(int);
    apply-accent-index(idx) => {
        Theme.accent = idx == Theme.os-accent-index
            ? Theme.os-accent-color : Theme.accent-presets[idx];
    }
    // P6.8 (gap 10): pushes the live OS accent value read by `cm_platform::accent`
    // into `Theme.os-accent-color` -- called once at startup and, where the
    // platform has a live signal, again on every OS accent change. Keeps the
    // accent live if the user currently has the "OS accent" swatch selected.
    callback set-os-accent(color);
    set-os-accent(c) => {
        Theme.os-accent-color = c;
        if (root.accent-index == Theme.os-accent-index) {
            Theme.accent = c;
        }
    }
    callback settings-font-size-changed(int);
    callback settings-font-family-changed(string);
    callback settings-shell-path-changed(string);
    callback settings-shell-args-changed(string);
    callback settings-shell-cwd-changed(string);
    callback startup-behavior-changed(int);
    callback render-backend-changed(int);

    // P1.4 — Connections panel CRUD.
    callback toggle-conn-row(int);       // idx → expand/collapse group
    callback new-connection(int);        // parent group_id (0=root)
    callback new-group(int);             // parent group_id (0=root)
    callback edit-conn(int);             // connection id → profile editor
    callback edit-group(int);            // group id → group editor
    callback duplicate-conn-row(int);    // connection id (P6.10 gap 15)
    // Connection id → open into the active tab's next pane slot (P6.10 fix
    // round 2 / P6.11). SSH/Local/RDP all supported since P6.11.
    callback connect-in-split-row(int);
    callback delete-conn-row(int, bool); // id, is_group
    // P1.4 — Reorder (up/down within the same parent) + move-between-groups.
    // Reorder is wired from hover ↑/↓ buttons; move-between-groups is exposed
    // via the group/parent-group ComboBoxes in the profile and group editors.
    callback reorder-conn-row(int, int);  // conn_id, direction (-1=up, +1=down)
    callback reorder-group-row(int, int); // group_id, direction

    // P1.4 — Keys panel CRUD.
    callback toggle-cred-row(int);        // idx → expand/collapse folder
    callback new-cred-folder(int);        // parent_folder_id (0=root)
    callback new-cred(int);               // folder_id (0=root)
    callback edit-cred(int);              // credential id
    callback delete-cred-row(int, bool);  // id, is_folder

    // TerminalSurface passthrough (UNCHANGED from P2.4).
    callback key-input(string, int, int);
    callback pointer(int, int, length, length, int);
    callback scroll(length, length);
    callback surface-resized(length, length);
    // RDP scroll with actual pointer coordinates (carry-over fix c).
    callback rdp-scroll(length /* x */, length /* y */, length /* dx */, length /* dy */);

    // RDP surface key events (P4.2) — separate from terminal because RDP needs
    // both key-down and key-up PDUs (key-released fires key-up).
    callback rdp-key-down(string /* text */, int /* special */, int /* mods */);
    callback rdp-key-up(string /* text */, int /* special */, int /* mods */);

    // ── Main shell (P7.3) ───────────────────────────────────────────────
    // Two-column shell: a full-height NAV column (activity bar + side panel,
    // spanning top-to-bottom) on the left, and a RIGHT column (tab strip +
    // session + status bar, status bar scoped to this column only) — an
    // mRemoteNG-style split that replaces the P2.4-era "tab strip spans the
    // full window width above everything" layout. See GUI_DESIGN.md §2.
    HorizontalLayout {
        spacing: 0px;

        // ── Left: full-height nav column ────────────────────────────
        // Activity bar.
        Rectangle {
                width: Theme.activity-bar-width;
                background: Theme.color-elevated;
                VerticalLayout {
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-1;
                    connections-panel-btn := ActivityBarButton {
                        glyph: "\u{F0317}"; active: active-panel == 0;
                        tooltip: "Connections";
                        clicked => { root.select-panel(0); }
                    }
                    keys-panel-btn := ActivityBarButton {
                        glyph: "\u{EB11}"; active: active-panel == 1;
                        tooltip: "Keys";
                        clicked => { root.select-panel(1); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    settings-panel-btn := ActivityBarButton {
                        glyph: "\u{F0493}"; active: active-panel == 2;
                        tooltip: "Settings";
                        clicked => { root.select-panel(2); }
                    }
                    // P6.9 (gap 11): chrome collapse toggle beyond the palette-only
                    // path ("Toggle sidebar" in the command palette). Same glyph as
                    // that palette action (cod-three_bars); `active` mirrors the
                    // current collapsed state so the rail lights up when hidden.
                    sidebar-toggle-btn := ActivityBarButton {
                        glyph: "\u{EB6A}"; active: root.sidebar-collapsed;
                        tooltip: "Toggle sidebar";
                        clicked => { root.toggle-sidebar(); }
                    }
                    // P8.1: pre-existing unwired placeholder icon (no `clicked`
                    // handler, no behavior) — out of this task's scope to wire up
                    // or invent a fabricated label for. Allowlisted in
                    // tests/a11y_audit.rs under this exact id.
                    team-placeholder-btn := ActivityBarButton { glyph: "\u{F0849}"; }
                }
            }

            // Side panel (collapsible + drag-resizable).
            if !sidebar-collapsed : Rectangle {
                width: root.sidebar-width * 1px;
                background: Theme.color-elevated;

                // ── Connections panel ──────────────────────────────
                if active-panel == 0 : VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-2;
                        padding-top: Theme.space-3; padding-bottom: Theme.space-2;
                        Text {
                            text: "CONNECTIONS";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        new-group-btn := IconButton {
                            glyph: "\u{EA80}";   // New folder / group
                            size: 24px; glyph-size: Theme.icon-sm;
                            tooltip: "New group";
                            clicked => { root.new-group(0); }
                        }
                        new-connection-btn := IconButton {
                            glyph: "\u{EA60}";   // Add connection
                            size: 24px; glyph-size: Theme.icon-sm;
                            tooltip: "New connection";
                            clicked => { root.new-connection(0); }
                        }
                    }
                    // P5.3b: Search/filter box.
                    HorizontalLayout {
                        padding-left: Theme.space-3; padding-right: Theme.space-3;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-2;
                        Text { text: "\u{F0349}"; font-family: Theme.font-family-icons;
                            font-size: Theme.icon-sm; color: Theme.color-text-secondary;
                            vertical-alignment: center; }
                        conn-filter-field := LineEdit {
                            placeholder-text: "Filter connections…";
                            text <=> root.conn-filter;
                            font-size: Theme.font-sm;
                            horizontal-stretch: 1;
                            accessible-label: "Filter connections";
                            edited(t) => { root.conn-filter-changed(t); }
                        }
                    }

                    // P5.3b: FocusScope for keyboard navigation in the connection tree.
                    // Clicking inside the tree area gives focus to this scope so
                    // arrow keys navigate rows without disturbing the terminal.
                    //
                    // P6.10 (gap 15): wrapped in a `ContextMenuArea` so the keyboard
                    // Menu key (Slint fires it natively once an inner `FocusScope`
                    // holds focus — no key detection code needed here) opens a menu
                    // for the arrow-key-highlighted row, and a right-click that lands
                    // on empty tree space (i.e. not consumed by a row's own
                    // `ContextMenuArea`, which wins first for on-row clicks) offers
                    // "New connection" / "New group".
                    //
                    // "Connect in split" (P6.10 fix round 2 / P6.11): same
                    // callback as the per-row ConnectionRow menu above — see
                    // its comment for the full rationale (SSH/Local/RDP all
                    // supported since P6.11).
                    ContextMenuArea {
                        vertical-stretch: 1;
                        Menu {
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length && !connections[conn-tree-focus.kb-idx].is-group : MenuItem {
                                title: "Connect";
                                activated => { root.row-activated(conn-tree-focus.kb-idx); }
                            }
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length && !connections[conn-tree-focus.kb-idx].is-group : MenuItem {
                                title: "Connect in split";
                                activated => { root.connect-in-split-row(connections[conn-tree-focus.kb-idx].id); }
                            }
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length && connections[conn-tree-focus.kb-idx].is-group : MenuItem {
                                title: "New child";
                                activated => { root.new-connection(connections[conn-tree-focus.kb-idx].id); }
                            }
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length : MenuItem {
                                title: connections[conn-tree-focus.kb-idx].is-group ? "Edit group" : "Edit";
                                activated => {
                                    if (connections[conn-tree-focus.kb-idx].is-group) {
                                        root.edit-group(connections[conn-tree-focus.kb-idx].id);
                                    } else {
                                        root.edit-conn(connections[conn-tree-focus.kb-idx].id);
                                    }
                                }
                            }
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length && !connections[conn-tree-focus.kb-idx].is-group : MenuItem {
                                title: "Duplicate";
                                activated => { root.duplicate-conn-row(connections[conn-tree-focus.kb-idx].id); }
                            }
                            if conn-tree-focus.kb-idx >= 0 && conn-tree-focus.kb-idx < connections.length : MenuItem {
                                title: "Delete";
                                activated => {
                                    root.delete-conn-row(
                                        connections[conn-tree-focus.kb-idx].id,
                                        connections[conn-tree-focus.kb-idx].is-group);
                                }
                            }
                            MenuSeparator {}
                            MenuItem { title: "New connection"; activated => { root.new-connection(0); } }
                            MenuItem { title: "New group"; activated => { root.new-group(0); } }
                        }
                        conn-tree-focus := FocusScope {
                            width: 100%; height: 100%;
                            property <int> kb-idx: -1;
                            key-pressed(e) => {
                                if (e.text == Key.UpArrow) {
                                    self.kb-idx = max(0, self.kb-idx - 1);
                                    accept
                                } else if (e.text == Key.DownArrow) {
                                    self.kb-idx = min(connections.length - 1, self.kb-idx + 1);
                                    accept
                                } else if (e.text == Key.Return) {
                                    if (self.kb-idx >= 0 && self.kb-idx < connections.length) {
                                        root.row-activated(self.kb-idx);
                                    }
                                    accept
                                } else if (e.text == Key.Escape) {
                                    self.kb-idx = -1;
                                    accept
                                } else {
                                    reject
                                }
                            }
                            TouchArea {
                                // Click anywhere in the list area to give keyboard focus.
                                width: 100%; height: 100%;
                                clicked => { conn-tree-focus.focus(); }
                            }
                            ListView {
                                width: 100%; height: 100%;
                                for conn[idx] in connections: conn-row := ConnectionRow {
                                    data: conn;
                                    row-index: idx;
                                    row-count: connections.length;
                                    highlighted: idx == conn-tree-focus.kb-idx;
                                    activated     => { root.row-activated(idx); }
                                    selected      => { root.row-selected(idx); }
                                    toggled       => { root.toggle-conn-row(idx); }
                                    edit-clicked  => {
                                        if (conn.is-group) { root.edit-group(conn.id); }
                                        else { root.edit-conn(conn.id); }
                                    }
                                    new-sub => { root.new-connection(conn.id); }
                                    duplicate-clicked => { root.duplicate-conn-row(conn.id); }
                                    connect-in-split-clicked => { root.connect-in-split-row(conn.id); }
                                    delete-clicked => {
                                        root.delete-conn-row(conn.id, conn.is-group);
                                    }
                                    move-up => {
                                        if (conn.is-group) { root.reorder-group-row(conn.id, -1); }
                                        else { root.reorder-conn-row(conn.id, -1); }
                                    }
                                    move-down => {
                                        if (conn.is-group) { root.reorder-group-row(conn.id, 1); }
                                        else { root.reorder-conn-row(conn.id, 1); }
                                    }
                                }
                            }
                        }
                    }

                    if connections.length == 0 && conn-filter == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{F0317}";
                        title: "No connections yet";
                        subtitle: "Use the + button above to add your first connection.";
                    }
                    if connections.length == 0 && conn-filter != "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{F0349}";
                        title: "No matches";
                        subtitle: "No connections match your filter.";
                    }

                    Rectangle {
                        height: 52px;
                        HorizontalLayout {
                            padding: Theme.space-3;
                            quick-connect-btn := PrimaryButton {
                                text: "Quick connect";
                                clicked => { root.quick-connect(); }
                            }
                        }
                    }
                }

                // ── Keys panel ─────────────────────────────────────
                if active-panel == 1 : VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-2;
                        padding-top: Theme.space-3; padding-bottom: Theme.space-2;
                        Text {
                            text: "KEYS";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        new-folder-btn := IconButton {
                            glyph: "\u{EA80}";   // New folder
                            size: 24px; glyph-size: Theme.icon-sm;
                            tooltip: "New folder";
                            clicked => { root.new-cred-folder(0); }
                        }
                        new-credential-btn := IconButton {
                            glyph: "\u{EA60}";   // New credential
                            size: 24px; glyph-size: Theme.icon-sm;
                            tooltip: "New credential";
                            clicked => { root.new-cred(0); }
                        }
                    }
                    // P5.3b: Search/filter box.
                    HorizontalLayout {
                        padding-left: Theme.space-3; padding-right: Theme.space-3;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-2;
                        Text { text: "\u{F0349}"; font-family: Theme.font-family-icons;
                            font-size: Theme.icon-sm; color: Theme.color-text-secondary;
                            vertical-alignment: center; }
                        cred-filter-field := LineEdit {
                            placeholder-text: "Filter credentials…";
                            text <=> root.cred-filter;
                            font-size: Theme.font-sm;
                            horizontal-stretch: 1;
                            accessible-label: "Filter credentials";
                            edited(t) => { root.cred-filter-changed(t); }
                        }
                    }

                    // P5.3b: FocusScope for keyboard navigation in the keys tree.
                    // P6.10 (gap 15): wrapped in a `ContextMenuArea` — same rationale
                    // as the connections tree above (keyboard Menu key on the
                    // highlighted row; empty-area right-click → New credential/folder).
                    ContextMenuArea {
                        vertical-stretch: 1;
                        Menu {
                            if cred-tree-focus.kb-idx >= 0 && cred-tree-focus.kb-idx < credentials.length && credentials[cred-tree-focus.kb-idx].is-folder : MenuItem {
                                title: "New credential";
                                activated => { root.new-cred(credentials[cred-tree-focus.kb-idx].id); }
                            }
                            if cred-tree-focus.kb-idx >= 0 && cred-tree-focus.kb-idx < credentials.length && !credentials[cred-tree-focus.kb-idx].is-folder : MenuItem {
                                title: "Edit";
                                activated => { root.edit-cred(credentials[cred-tree-focus.kb-idx].id); }
                            }
                            if cred-tree-focus.kb-idx >= 0 && cred-tree-focus.kb-idx < credentials.length : MenuItem {
                                title: "Delete";
                                activated => {
                                    root.delete-cred-row(
                                        credentials[cred-tree-focus.kb-idx].id,
                                        credentials[cred-tree-focus.kb-idx].is-folder);
                                }
                            }
                            MenuSeparator {}
                            MenuItem { title: "New credential"; activated => { root.new-cred(0); } }
                            MenuItem { title: "New folder"; activated => { root.new-cred-folder(0); } }
                        }
                        cred-tree-focus := FocusScope {
                            width: 100%; height: 100%;
                            property <int> kb-idx: -1;
                            key-pressed(e) => {
                                if (e.text == Key.UpArrow) {
                                    self.kb-idx = max(0, self.kb-idx - 1);
                                    accept
                                } else if (e.text == Key.DownArrow) {
                                    self.kb-idx = min(credentials.length - 1, self.kb-idx + 1);
                                    accept
                                } else if (e.text == Key.Return) {
                                    if (self.kb-idx >= 0 && self.kb-idx < credentials.length) {
                                        root.edit-cred(credentials[self.kb-idx].id);
                                    }
                                    accept
                                } else if (e.text == Key.Escape) {
                                    self.kb-idx = -1;
                                    accept
                                } else {
                                    reject
                                }
                            }
                            TouchArea {
                                width: 100%; height: 100%;
                                clicked => { cred-tree-focus.focus(); }
                            }
                            ListView {
                                width: 100%; height: 100%;
                                for cred[idx] in credentials: cred-row := CredTreeRow {
                                    data: cred;
                                    row-index: idx;
                                    row-count: credentials.length;
                                    highlighted: idx == cred-tree-focus.kb-idx;
                                    activated      => { root.edit-cred(cred.id); }
                                    toggled        => { root.toggle-cred-row(idx); }
                                    new-sub        => { root.new-cred(cred.id); }
                                    delete-clicked => {
                                        root.delete-cred-row(cred.id, cred.is-folder);
                                    }
                                }
                            }
                        }
                    }

                    if credentials.length == 0 && cred-filter == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{EB11}";
                        title: "No credentials yet";
                        subtitle: "Use the + button above to add SSH keys or passwords.";
                    }
                    if credentials.length == 0 && cred-filter != "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{F0349}";
                        title: "No matches";
                        subtitle: "No credentials match your filter.";
                    }
                }

                // ── Settings panel (P5.2) ──────────────────────────
                if active-panel == 2 : SettingsPanel {
                    theme-mode          <=> root.theme-mode;
                    density             <=> root.density;
                    accent-index        <=> root.accent-index;
                    font-families       : root.settings-font-families;
                    font-family         <=> root.settings-font-family;
                    font-family-index   <=> root.settings-font-family-index;
                    font-size           <=> root.settings-font-size;
                    shell-path          <=> root.settings-shell-path;
                    shell-args          <=> root.settings-shell-args;
                    shell-cwd           <=> root.settings-shell-cwd;
                    startup-behavior    <=> root.startup-behavior;
                    render-backend      <=> root.render-backend;
                    agent-mode-available            : root.agent-mode-available;
                    agent-mode-enabled               <=> root.agent-mode-enabled;
                    agent-mode-scope-read             <=> root.agent-mode-scope-read;
                    agent-mode-scope-write            <=> root.agent-mode-scope-write;
                    agent-mode-scope-execute          <=> root.agent-mode-scope-execute;
                    agent-mode-connection-details    : root.agent-mode-connection-details;
                    // theme-changed is also handled inside SettingsPanel (live recolor);
                    // the callback here persists the choice to the DB.
                    theme-changed(i)    => { root.theme-changed(i); }
                    density-changed(i)  => { root.density-changed(i); }
                    accent-changed(i)   => { root.accent-changed(i); }
                    font-family-changed(v)       => { root.settings-font-family-changed(v); }
                    font-size-changed(v)         => { root.settings-font-size-changed(v); }
                    shell-path-changed(v)        => { root.settings-shell-path-changed(v); }
                    shell-args-changed(v)        => { root.settings-shell-args-changed(v); }
                    shell-cwd-changed(v)         => { root.settings-shell-cwd-changed(v); }
                    startup-behavior-changed(v)  => { root.startup-behavior-changed(v); }
                    render-backend-changed(v)    => { root.render-backend-changed(v); }
                    agent-mode-enabled-changed(v)       => { root.agent-mode-enabled-changed(v); }
                    agent-mode-scope-read-changed(v)    => { root.agent-mode-scope-read-changed(v); }
                    agent-mode-scope-write-changed(v)   => { root.agent-mode-scope-write-changed(v); }
                    agent-mode-scope-execute-changed(v) => { root.agent-mode-scope-execute-changed(v); }
                }
            }

            // Side-panel drag handle (P6.9, gap 11). Live-resizes `sidebar-width`
            // (clamped to Theme's min/max) while dragging; commits the final width
            // via `sidebar-width-changed` on release so the DB is written once per
            // gesture, not once per pixel.
            if !sidebar-collapsed : Rectangle {
                width: 4px;
                background: sb-resize.pressed ? Theme.color-accent
                          : sb-resize.has-hover ? Theme.color-accent.with-alpha(0.4)
                          : transparent;
                property <int> drag-base-width: 0;
                sb-resize := TouchArea {
                    // P8.1: no dedicated "separator/resize handle" role exists in
                    // Slint 1.17's enum; `slider` is the closest value-bearing fit
                    // for a 1-D drag control.
                    accessible-role: slider;
                    accessible-label: "Resize side panel";
                    accessible-value: root.sidebar-width + "px";
                    mouse-cursor: MouseCursor.ew-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            parent.drag-base-width = root.sidebar-width;
                        } else if (e.kind == PointerEventKind.up) {
                            root.sidebar-width-changed(root.sidebar-width);
                        }
                    }
                    moved => {
                        root.sidebar-width = clamp(
                            parent.drag-base-width
                                + round((sb-resize.mouse-x - sb-resize.pressed-x) / 1px),
                            Theme.side-panel-min-width,
                            Theme.side-panel-max-width);
                    }
                }
            }

        // ── Hairline divider (P7.3, fixes #5) ───────────────────────────
        // A clean, deliberate seam between the nav column and the tab-strip/
        // session/status column — replaces the old zero-gap "first tab flush
        // to the window corner" join.
        Rectangle {
            width: 1px;
            background: Theme.color-stroke;
        }

        // ── Right: tab strip + session + status bar column ──────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Tab strip (spans only this column — NOT over the nav column).
            Rectangle {
                height: 40px;
                background: Theme.color-strip;
                HorizontalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.space-1;
                    alignment: start;
                    for tab[idx] in tabs: tab-item := Tab {
                        title: tab.title;
                        status: tab.status;
                        pane-count: tab.pane-count;
                        active: idx == active-tab;
                        is-home: tab.is-home;
                        can-duplicate: tab.can-duplicate;
                        item-index: idx;
                        item-count: tabs.length;
                        clicked => { root.select-tab(idx); }
                        closed => { root.close-tab(idx); }
                        reconnect-clicked => { root.tab-reconnect(idx); }
                        disconnect-clicked => { root.tab-disconnect(idx); }
                        duplicate-clicked => { root.tab-duplicate(idx); }
                    }
                    new-tab-btn := IconButton {
                        glyph: "\u{EA60}";
                        tooltip: "New tab";
                        clicked => { root.new-tab(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Session area (P6.10 / P6.17 R2: wrapped in a plain Rectangle so the
            // session-state overlays below can be layered ABOVE the surface/broadcast
            // bar but stay confined to this cell — they no longer paint over the tab
            // strip or status bar, which used to happen when they were mounted as
            // 100%x100% siblings of the whole AppWindow (app.slint:1372-1389 pre-P6.10).
            session-area := Rectangle {
                vertical-stretch: 1;
                clip: true;

            VerticalLayout {
                width: 100%; height: 100%;
                spacing: 0px;

                // ── Single-pane terminal (P2.4; FROZEN — no split, no RDP) ──────
                if !rdp-active && pane-cells.length <= 1 : TerminalSurface {
                    vertical-stretch: 1;
                    frame: root.frame;
                    key-input(t, s, m) => { root.key-input(t, s, m); }
                    pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                    scroll(dx, dy) => { root.scroll(dx, dy); }
                    resized(w, h) => { root.surface-resized(w, h); }
                    toggle-palette => {
                        root.palette-open = !root.palette-open;
                        if (!root.palette-open) { root.palette-selected = 0; }
                    }
                }

                // ── RDP surface (P4.2; only shown when an unsplit RDP tab is
                // active — a split tab, even one containing an RDP pane,
                // renders through the N-way repeater below instead) ────────
                if rdp-active && pane-cells.length <= 1 : RdpSurface {
                    vertical-stretch: 1;
                    frame: root.rdp-frame;
                    key-down(t, s, m) => { root.rdp-key-down(t, s, m); }
                    key-up(t, s, m)   => { root.rdp-key-up(t, s, m); }
                    pointer(b, k, x, y, m) => { root.pointer(b, k, x, y, m); }
                    rdp-scroll(x, y, dx, dy) => { root.rdp-scroll(x, y, dx, dy); }
                    resized(w, h)     => { root.surface-resized(w, h); }
                }

                // ── N-way split (P6.11): one PaneSlot per `pane-cells` entry,
                // absolutely positioned from Rust-computed fractional
                // geometry (`PaneGroup::rects()`) — replaces the old fixed
                // 2-pane HSplit/VSplit branches. Each cell carries its own
                // `is-rdp` flag, so a split can freely mix terminal and RDP
                // panes (RDP-in-pane, P6.11's second scope item).
                if pane-cells.length > 1 : Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    for cell[idx] in root.pane-cells : PaneSlot {
                        x: cell.x * parent.width;
                        y: cell.y * parent.height;
                        width: cell.w * parent.width;
                        height: cell.h * parent.height;
                        frame: cell.frame;
                        is-rdp: cell.is-rdp;
                        is-focused: root.active-pane == cell.pane;
                        pane-index: cell.pane;
                        // P9.10 #2: a split (more than one cell) is the only
                        // time there's another pane to fall back to.
                        show-disconnect: root.pane-cells.length > 1;
                        pane-focused(i) => { root.pane-focused(i); }
                        key-input(t, s, m) => { root.key-input(t, s, m); }
                        key-down(t, s, m) => { root.rdp-key-down(t, s, m); }
                        key-up(t, s, m) => { root.rdp-key-up(t, s, m); }
                        pointer(b, k, px, py, m) => { root.pointer(b, k, px, py, m); }
                        scroll(dx, dy) => { root.scroll(dx, dy); }
                        rdp-scroll(px, py, dx, dy) => { root.rdp-scroll(px, py, dx, dy); }
                        resized(w, h) => { root.pane-resized(cell.pane, w, h); }
                        pane-disconnect(i) => { root.pane-disconnect(i); }
                        toggle-palette => {
                            root.palette-open = !root.palette-open;
                            if (!root.palette-open) { root.palette-selected = 0; }
                        }
                    }
                }

                // ── Broadcast bar (always visible when active; never silent) ────
                if broadcast-active : Rectangle {
                    height: 46px;
                    background: Theme.color-elevated;
                    border-width: 1px;
                    border-color: Theme.color-broadcast-edge;
                    HorizontalLayout {
                        padding-left: Theme.space-4; padding-right: Theme.space-4;
                        spacing: Theme.space-3;
                        Text {
                            text: "\u{EAAD}  Broadcast on";
                            color: Theme.color-accent;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        // P6.11 (gap 14): targeting menu trigger — always shows
                        // the active target ("never silent"), clickable to
                        // change it. Implicit width from the HorizontalLayout
                        // child (same pattern as the status-bar pills below);
                        // the plain `TouchArea` sibling fills the Rectangle.
                        Rectangle {
                            HorizontalLayout {
                                spacing: Theme.space-1;
                                Text {
                                    text: "→ " + root.broadcast-target-label;
                                    color: bc-target-touch.has-hover ? Theme.color-accent : Theme.color-text-secondary;
                                    font-size: Theme.font-sm;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "\u{25BE}"; // plain-Unicode chevron-down (not the icon font)
                                    color: bc-target-touch.has-hover ? Theme.color-accent : Theme.color-text-secondary;
                                    font-size: Theme.font-xs;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                            }
                            bc-target-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "Broadcast target: " + root.broadcast-target-label;
                                accessible-action-default => { root.open-broadcast-target(); }
                                clicked => { root.open-broadcast-target(); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Dismiss button.
                        broadcast-off-btn := IconButton {
                            glyph: "\u{EA76}";
                            size: 24px; glyph-size: Theme.icon-sm;
                            tooltip: "Turn off broadcast";
                            clicked => { root.toggle-broadcast(); }
                        }
                    }
                }
            }

            // ── Broadcast targeting popup (P6.11, gap 14) ────────────────────
            // A small anchored popup off the broadcast-bar trigger (not a
            // full-screen Modal — the spec calls for "a small popup off the
            // broadcast affordance"). Mounted at the `session-area` level
            // (like the overlays below) rather than nested inside the 46px
            // broadcast-bar Rectangle: that bar sits at the very bottom of
            // the clipped `session-area`, so a popup positioned *below* it
            // (or only as tall as the bar's own local frame) gets clipped
            // away or leaves most of the pane area uncovered by the
            // click-out catcher. Full-bleed here guarantees both the popup
            // and its click-out catcher are always inside the visible,
            // unclipped region, regardless of window size.
            if broadcast-target-open : Rectangle {
                x: 0; y: 0; width: 100%; height: 100%;
                TouchArea { clicked => { root.close-broadcast-target(); } }
                Rectangle {
                    x: Theme.space-4; y: parent.height - self.height - 46px - Theme.space-2;
                    width: 260px;
                    background: Theme.color-overlay;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.color-stroke;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: Theme.color-scrim;
                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;
                        Text {
                            text: "Broadcast target";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                        }
                        bc-visible-touch := TouchArea {
                            height: 26px;
                            accessible-role: radio-button;
                            accessible-label: "All visible panes";
                            accessible-checked: root.broadcast-target-label == "all panes";
                            accessible-action-default => { root.select-broadcast-visible(); }
                            clicked => { root.select-broadcast-visible(); }
                            HorizontalLayout {
                                Text {
                                    text: (root.broadcast-target-label == "all panes" ? "\u{2713} " : "    ") + "All visible panes";
                                    color: bc-visible-touch.has-hover ? Theme.color-accent : Theme.color-text;
                                    font-size: Theme.font-sm;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if broadcast-saved-groups.length > 0 : Rectangle { height: 1px; background: Theme.color-stroke; }
                        for grp[gi] in root.broadcast-saved-groups : bg-group-row := TouchArea {
                            height: 26px;
                            accessible-role: radio-button;
                            accessible-label: grp;
                            accessible-checked: root.broadcast-target-label == grp;
                            accessible-item-index: gi;
                            accessible-item-count: root.broadcast-saved-groups.length;
                            accessible-action-default => { root.select-broadcast-group(gi); }
                            clicked => { root.select-broadcast-group(gi); }
                            HorizontalLayout {
                                Text {
                                    text: "\u{25B8} " + grp;
                                    color: Theme.color-text;
                                    font-size: Theme.font-sm;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.color-stroke; }
                        Text {
                            text: "Custom selection";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-family;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                        }
                        for chk[pi] in root.broadcast-pane-checks : bg-pane-check := TouchArea {
                            height: 24px;
                            accessible-role: checkbox;
                            accessible-label: "Pane " + (pi + 1);
                            accessible-checked: chk;
                            accessible-item-index: pi;
                            accessible-item-count: root.broadcast-pane-checks.length;
                            accessible-action-default => { root.toggle-broadcast-pane-check(pi); }
                            clicked => { root.toggle-broadcast-pane-check(pi); }
                            HorizontalLayout {
                                spacing: Theme.space-1;
                                Text {
                                    text: chk ? "\u{2611}" : "\u{2610}";
                                    color: chk ? Theme.color-accent : Theme.color-text-disabled;
                                    font-size: Theme.font-sm;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Pane " + (pi + 1);
                                    color: Theme.color-text;
                                    font-size: Theme.font-sm;
                                    font-family: Theme.font-family;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            apply-broadcast-btn := SecondaryButton {
                                text: "Apply";
                                clicked => { root.apply-broadcast-custom(); }
                            }
                        }
                        broadcast-group-name-field := LineEdit {
                            placeholder-text: "Save selection as…";
                            text <=> root.broadcast-group-name-draft;
                            accessible-label: "Save selection as";
                            accepted => { root.save-broadcast-group(); }
                        }
                        save-broadcast-group-btn := SecondaryButton {
                            text: "Save as named group";
                            clicked => { root.save-broadcast-group(); }
                        }
                    }
                }
            }

            // ── Session-state overlays (P6.10 / P6.17 R2) ──────────────────
            // Moved from window-level 100%x100% siblings (which painted over the
            // tab strip and status bar — shots 21/25/34/38 in the P6.17 memo) to
            // this cell: still full-bleed over the surface/broadcast bar, but the
            // tab strip above and the status bar below stay visible and honest
            // while a tab is connecting/failed/empty.
            if overlay-connecting : ConnectingOverlay {
                x: 0; y: 0; width: 100%; height: 100%;
                identity: session-identity;
                kind: connecting-kind;
                // P7.3: Cancel aborts the held connect via the same
                // close-tab path the tab strip's ✕ uses (detaches the
                // in-flight session, selects the next tab / falls back to
                // the empty/launchpad tab).
                cancel => { root.close-tab(root.active-tab); }
            }
            if overlay-error : ErrorOverlay {
                x: 0; y: 0; width: 100%; height: 100%;
                identity: session-identity;
                reason: error-reason;
                detail: error-detail;
                is-failure: error-is-failure;
                reconnect => { root.reconnect(); }
                edit => { root.edit-failed-profile(); }
            }
            if launchpad-open : Launchpad {
                x: 0; y: 0; width: 100%; height: 100%;
                greeting: launchpad-greeting;
                recents: launchpad-recents;
                query <=> launchpad-query;
                edited(q) => { root.launchpad-edited(q); }
                open-recent(i) => { root.open-recent(i); }
                quick-connect => { root.quick-connect(); }
                open-group-split => { root.open-group-split(); }
            }
            // ── P6.7: terminal search overlay ────────────────────────────────
            // Floats over the live terminal (top-right), not full-bleed like the
            // overlays above — the terminal underneath stays visible/live.
            if terminal-search-open : SearchOverlay {
                x: parent.width - self.width - Theme.space-4;
                y: Theme.space-3;
                query <=> terminal-search-query;
                match-count: terminal-search-match-count;
                current-index: terminal-search-current-index;
                edited(q) => { root.search-edited(q); }
                next => { root.search-next(); }
                prev => { root.search-prev(); }
                close => { root.search-close(); }
            }
            }

            // Status bar (P7.3: scoped to this column only — NOT full window
            // width, so it never draws under/past the nav column).
            Rectangle {
                height: Theme.status-bar-height;
                background: Theme.color-strip;
                HorizontalLayout {
                    padding-left: Theme.space-3; padding-right: Theme.space-3;
                    spacing: Theme.space-4;
                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            state: session-status;
                            // P6.9 (gap 13): the label now tracks the live status instead
                            // of a hardcoded "Connected · " prefix — a Failed/Disconnected
                            // tab used to read "Connected · host" while showing a red dot.
                            text: session-identity == "" ? "No active session"
                                : (session-status == "connecting" ? "Connecting · "
                                    : session-status == "connected" ? "Connected · "
                                    : session-status == "error" ? "Failed · "
                                    : "Disconnected · ") + session-identity;
                        }
                    }
                    if connecting-kind != "" : Text {
                        text: connecting-kind;
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-family;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if session-insecure : insecure-transport-label := Rectangle {
                        height: 18px;
                        border-radius: Theme.radius-xs;
                        background: Theme.color-connecting.with-alpha(0.16);
                        border-width: 1px;
                        border-color: Theme.color-connecting.with-alpha(0.55);
                        accessible-role: text;
                        accessible-label: "INSECURE transport";
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            Text {
                                text: "INSECURE";
                                color: Theme.color-connecting;
                                font-size: Theme.font-xs;
                                font-family: Theme.font-family;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Detached-session badge: click to open palette filtered to "reattach".
                    if detached-count > 0 : Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 18px;
                        border-radius: Theme.radius-sm - 2px;
                        background: Theme.color-elevated;
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2;
                            spacing: Theme.space-1;
                            Text { text: "\u{EAAD}"; color: Theme.color-text-secondary; font-size: Theme.font-xs;
                                font-family: Theme.font-family-mono; vertical-alignment: center; }
                            Text { text: detached-count + " detached"; color: Theme.color-text-secondary;
                                font-size: Theme.font-xs; font-family: Theme.font-family; vertical-alignment: center; }
                        }
                        detached-badge-btn := TouchArea {
                            accessible-role: button;
                            accessible-label: root.detached-count + " detached sessions";
                            accessible-action-default => { root.open-palette(); }
                            clicked => { root.open-palette(); }
                        }
                    }
                    // Broadcast indicator in the status bar (never silent — P6.11
                    // names the active target, not just "BC"). Click opens the
                    // targeting menu; the dedicated dismiss button in the
                    // broadcast bar above still turns broadcast fully off.
                    if broadcast-active : Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 18px;
                        border-radius: Theme.radius-sm - 2px;
                        background: Theme.color-broadcast-edge;
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2;
                            Text { text: "\u{EAAD} BC · " + root.broadcast-target-label; color: Theme.color-base; font-size: Theme.font-xs;
                                font-family: Theme.font-family-mono; font-weight: 700; vertical-alignment: center; }
                        }
                        broadcast-badge-btn := TouchArea {
                            accessible-role: button;
                            accessible-label: "Broadcast active: " + root.broadcast-target-label;
                            accessible-action-default => { root.open-broadcast-target(); }
                            clicked => { root.open-broadcast-target(); }
                        }
                    }
                    // P8.6-B: persistent active indicator -- shown iff agent-mode is
                    // both enabled AND actually listening (a non-empty connection
                    // details string means the proxy bound successfully), in the
                    // spirit of a screen-share indicator: a security signal that
                    // must be visible for as long as an agent could be connected,
                    // not just at the moment it was turned on. Click opens Settings
                    // (where it can be turned back off).
                    if agent-mode-enabled && agent-mode-connection-details != "" : Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 18px;
                        border-radius: Theme.radius-sm - 2px;
                        background: Theme.color-connecting.with-alpha(0.18);
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2;
                            spacing: Theme.space-1;
                            Text { text: "Agent mode"; color: Theme.color-connecting; font-size: Theme.font-xs;
                                font-family: Theme.font-family-mono; font-weight: 700; vertical-alignment: center; }
                        }
                        agent-mode-badge-btn := TouchArea {
                            accessible-role: button;
                            accessible-label: "Agent mode active on " + root.agent-mode-connection-details + " -- open Settings";
                            accessible-action-default => { root.select-panel(2); }
                            clicked => { root.select-panel(2); }
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 18px;
                        border-radius: Theme.radius-sm - 2px;
                        background: Theme.color-accent-subtle;
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2;
                            spacing: Theme.space-1;
                            Text { text: "Ctrl K"; color: Theme.color-accent; font-size: Theme.font-xs;
                                font-family: Theme.font-family-mono; font-weight: 700; vertical-alignment: center; }
                            Text { text: "Palette"; color: Theme.color-accent; font-size: Theme.font-sm;
                                font-family: Theme.font-family; vertical-alignment: center; }
                        }
                        palette-badge-btn := TouchArea {
                            accessible-role: button;
                            accessible-label: "Open command palette";
                            accessible-action-default => { root.open-palette(); }
                            clicked => { root.open-palette(); }
                        }
                    }
                }
            }
        }
    }

    // ── Quick-connect modal ───────────────────────────────────────────────
    Modal {
        open: root.quick-connect-open;
        dismissed => { root.quick-connect-open = false; }
        quick-connect-dialog := QuickConnectForm {
            kind <=> root.qc-kind;
            host <=> root.qc-host;
            port <=> root.qc-port;
            username <=> root.qc-username;
            auth-method <=> root.qc-auth-method;
            secret <=> root.qc-secret;
            passphrase <=> root.qc-passphrase;
            rdp-domain <=> root.qc-rdp-domain;
            rdp-resolution <=> root.qc-rdp-resolution;
            local-program <=> root.qc-local-program;
            local-args <=> root.qc-local-args;
            local-cwd <=> root.qc-local-cwd;
            connect => { root.qc-connect(); }
            cancel  => { root.quick-connect-open = false; }
        }
    }

    // ── Host-key dialog ───────────────────────────────────────────────────
    Modal {
        open: root.host-key-open;
        dismissed => {}
        host-key-dialog := HostKeyDialog {
            mismatch:           root.host-key-mismatch;
            host:               root.host-key-host;
            key-type:           root.host-key-type;
            fingerprint:        root.host-key-fingerprint;
            stored-fingerprint: root.host-key-stored-fp;
            reject => { root.host-key-reject(); }
            accept => { root.host-key-accept(); }
        }
    }

    // ── RDP cert dialog (P4.2) ────────────────────────────────────────────
    Modal {
        open: root.cert-dialog-open;
        dismissed => {}
        cert-dialog := CertDialog {
            mismatch:           root.cert-dialog-mismatch;
            host:               root.cert-dialog-host;
            subject:            root.cert-dialog-subject;
            fingerprint:        root.cert-dialog-fingerprint;
            stored-fingerprint: root.cert-dialog-stored-fp;
            reject => { root.cert-reject(); }
            accept => { root.cert-accept(); }
        }
    }

    // ── SSH keyboard-interactive dialog (P6.13) ───────────────────────────
    Modal {
        open: root.kbd-open;
        dismissed => {}
        kbd-dialog := KbdInteractiveDialog {
            name:         root.kbd-name;
            instructions: root.kbd-instructions;
            prompts:      root.kbd-prompts;
            answer-edited(idx, t) => { root.kbd-answer-edited(idx, t); }
            submit => { root.kbd-submit(); }
            cancel => { root.kbd-cancel(); }
        }
    }

    // ── mRemoteNG import password prompt (P9.4) ───────────────────────────
    Modal {
        open: root.import-password-open;
        dismissed => { root.import-password-cancel(); }
        import-password-dialog := ImportPasswordDialog {
            file-name: root.import-password-file-name;
            password-edited(t) => { root.import-password-edited(t); }
            submit => { root.import-password-submit(); }
            cancel => { root.import-password-cancel(); }
        }
    }

    // ── Destructive deletion confirmation ────────────────────────────────
    Modal {
        open: root.delete-confirm-open;
        dismissed => { root.delete-confirm-cancel(); }
        delete-confirm-dialog := DeleteConfirmationDialog {
            target-name: root.delete-confirm-target-name;
            is-group: root.delete-confirm-is-group;
            group-count: root.delete-confirm-group-count;
            connection-count: root.delete-confirm-connection-count;
            confirm => { root.delete-confirm-accept(); }
            cancel => { root.delete-confirm-cancel(); }
        }
    }

    // ── P1.4: Profile editor modal ────────────────────────────────────────
    Modal {
        open: root.profile-editor-open;
        // Fable follow-up (P8.6-B): Esc/scrim-click must clear the transient
        // Inline password too, not just the explicit Cancel button below --
        // mirrors ProfileEditor's own `cancel` body exactly.
        dismissed => {
            root.profile-form.inline-password = "";
            root.profile-editor-open = false;
        }
        profile-editor-dialog := ProfileEditor {
            form <=> root.profile-form;
            cred-name-list: root.cred-name-list;
            group-name-list: root.group-name-list;
            save   => { root.profile-save(); }
            // Fable non-blocking note (P9.6-A Phase C): a typed-then-cancelled
            // Inline password otherwise lingers in `profile-form` until the
            // next editor-open (save/open already clear it -- see
            // tree_ctl::wire_profile_save / wire_edit_conn) -- close the gap
            // on cancel too.
            cancel => {
                root.profile-form.inline-password = "";
                root.profile-editor-open = false;
            }
        }
    }

    // ── P1.4: Group editor modal ──────────────────────────────────────────
    Modal {
        open: root.group-editor-open;
        dismissed => { root.group-editor-open = false; }
        group-editor-dialog := GroupEditor {
            form <=> root.group-form;
            cred-name-list: root.cred-name-list;
            group-name-list: root.group-name-list;
            save   => { root.group-save(); }
            cancel => { root.group-editor-open = false; }
        }
    }

    // ── P1.4: Credential editor modal ─────────────────────────────────────
    Modal {
        open: root.cred-editor-open;
        dismissed => { root.cred-editor-open = false; }
        cred-editor-dialog := CredEditor {
            form <=> root.cred-form;
            folder-name-list: root.folder-name-list;
            save   => { root.cred-save(); }
            cancel => { root.cred-editor-open = false; }
        }
    }

    // ── P5.3b: Toast bar (background-event notifications) ────────────────────
    // Positioned at the bottom-center; above all chrome but below the palette.
    if toasts.length > 0 : VerticalLayout {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - Theme.space-4 - Theme.status-bar-height;
        width: 440px;
        spacing: Theme.space-2;
        alignment: end;
        for t in root.toasts: toast-item := Toast {
            message: t.message;
            kind:    t.kind;
            dismissed => { root.toast-dismissed(t.id); }
        }
    }

    // ── Command palette (last child = topmost z-layer) ────────────────────
    palette-modal := Modal {
        open: root.palette-open;
        dismissed => {
            root.palette-open = false;
            root.palette-selected = 0;
        }
        command-palette-dialog := CommandPalette {
            query <=> root.palette-query;
            actions: root.palette-actions;
            selected-index <=> root.palette-selected;
            edited(q) => { root.palette-edited(q); }
            activated(idx) => {
                root.palette-open = false;
                root.palette-selected = 0;
                root.palette-activated(idx);
            }
        }
    }
}
