// ConMan — Theme global: color tokens, spacing, radii, fonts, status colors.
//
// Targets Slint 1.17 (std-widgets `Palette` available; `ColorScheme` enum is a builtin).
//
// Dark/light is driven by `dark-mode`. Default seeds from the OS scheme via
// `Palette.color-scheme` (no platform code needed); the Settings panel may override it.
// Accent is set by the preset picker in Settings; persisted value is restored at launch
// via AppWindow.invoke_apply_accent_index.
// Theme.dark-mode = bool // written by Settings panel or apply_settings_to_ui
//
// Every other.slint imports this global; there are ZERO hardcoded colors elsewhere:
// import { Theme } from "theme.slint";

// ColorScheme is a Slint 1.17 builtin — no import needed.
import { Palette } from "std-widgets.slint";
// Bundle the Symbols Nerd Font Mono for cross-platform chrome icons.
// Slint registers this font under its internal family name "Symbols Nerd Font Mono"
// and makes it available as Theme.font-family-icons on all platforms.
import "../assets/fonts/SymbolsNerdFontMono-Regular.ttf";

export global Theme {
  // ── Scheme flag ────────────────────────────────────────────────────────────
  // Seeded from the OS scheme; `in-out` so a manual override (Settings: dark/light/
  // system) or cm-platform can write it. When following "system", leave this bound
  // to the Palette and don't write it.
  in-out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
  // Terminal palette selection is intentionally independent of shell theme.
  in-out property <bool> terminal-dark: true;

  // ── Accent color (preset or restored from settings; cool-blue fallback) ──────
  // Accent is set by the Settings panel accent picker or restored from persisted
  // settings at launch via AppWindow.invoke_apply_accent_index.
  // Status colors NEVER derive from this (see §status).
  in-out property <color> accent: #3b82f6;

  // ── Density preset ────────────────────────────────────────────────────────
  // Written by Settings › Density segmented control; read from the settings DB
  // on launch. Changing this property automatically reflows all dependent
  // component metrics below without any additional Rust code.
  in-out property <int> density: 0;

  // ── Surfaces — depth ladder: canvas → activity/side panel → card → overlay ──
  // color-base: window canvas / session area chrome (recedes)
  // color-elevated: activity bar + side panel surface
  // color-card: cards, inputs, tabs, list rows (lifts)
  // color-overlay: dialogs, command palette, context menus (floats)
  // color-stroke: hairline borders / dividers
  // color-hover: soft hover wash for interactive rows / icon buttons
  out property <color> color-base:     dark-mode ? #0e1014 : #eef0f3;
  out property <color> color-elevated: dark-mode ? #15181e : #e9ecf0;
  out property <color> color-card:     dark-mode ? #1c2027 : #ffffff;
  out property <color> color-overlay:  dark-mode ? #1c2027 : #fbfaf7;
  out property <color> color-stroke:   dark-mode ? #ffffff12 : #00000019;
  out property <color> color-hover:    dark-mode ? #ffffff0d : #0000000a;
  // Modal scrim behind dialogs / command palette (same in both schemes).
  out property <color> color-scrim:    #00000099;
  // Quiet chrome strip for tab strip and status bar backgrounds.
  // `color-base.darker(0.2)` was asymmetric across schemes: near-invisible on
  // the dark canvas but a heavy #C6C8CB slab on the light one. A dedicated
  // per-scheme token keeps both readings hairline-subtle.
  out property <color> color-strip:    dark-mode ? #0b0d10 : #e2e5e9;

  // ── Terminal default surface ───────────────────────────────────────────────
  // Empty-state/overlay surface tokens follow the shell. The actual terminal canvas
  // follows the separately selected terminal palette.
  out property <color> color-terminal-bg: dark-mode ? #0a0c10 : #ffffff;
  out property <color> color-terminal-fg: dark-mode ? #c9ccd1 : #2b2f36;
  out property <color> color-terminal-canvas-bg: terminal-dark ? #0a0c10 : #ffffff;

  // ── Text — hand-tuned per scheme for guaranteed contrast ───────────────────
  out property <color> color-text:           dark-mode ? #e7e9ee : #1b1e24;
  out property <color> color-text-secondary: dark-mode ? #969ca8 : #5c636e;
  out property <color> color-text-disabled:  dark-mode ? #5f6671 : #8b929c;

  // ── Accent-derived interactive colors ──────────────────────────────────────
  // In dark mode the OS accent is brightened slightly so it reads on the dark canvas.
  out property <color> color-accent:         dark-mode ? accent.brighter(0.15) : accent;
  out property <color> color-accent-hover:   color-accent.brighter(0.12);
  out property <color> color-accent-pressed: color-accent.darker(0.10);
  out property <color> color-accent-text:    #ffffff;   // text/icon on an accent fill
  out property <color> color-accent-subtle:  color-accent.with-alpha(dark-mode ? 0.15 : 0.12);  // selection / armed tint

  // Broadcast "armed" framing reuses the accent at a low alpha (see BroadcastBar).
  out property <color> color-broadcast-edge: color-accent.with-alpha(dark-mode ? 0.40 : 0.45);

  // ── Semantic status colors (never accent-derived) ───────────────────────
  // The fixed colors drive dots, fills, borders, and other decorative accents.
  // Normal-size semantic text uses the per-scheme `-foreground` variants: the
  // fixed amber/red do not reach 4.5:1 on light surfaces.
  out property <color> color-connected:    #3fb950;   // green
  out property <color> color-connecting:   #d8a623;   // amber
  out property <color> color-disconnected: dark-mode ? #6e7681 : #9aa1ac;  // grey
  out property <color> color-error:        #f85149;   // red
  out property <color> color-connecting-foreground: dark-mode ? #d8a623 : #765600;
  out property <color> color-error-foreground:      dark-mode ? #f85149 : #a1261b;

  // ── Spacing scale (logical px, 4px base — multiples only) ──────────────────
  out property <length> space-1:   4px;
  out property <length> space-2:   8px;
  out property <length> space-3:  12px;
  out property <length> space-4:  16px;
  out property <length> space-5:  20px;
  out property <length> space-6:  24px;
  out property <length> space-8:  32px;
  out property <length> space-10: 40px;
  out property <length> space-12: 48px;

  // ── Corner radii (clean-modern = subtle) ───────────────────────────────────
  out property <length> radius-xs:   3px;   // tag/badge chips (kind pill, protocol label)
  out property <length> radius-sm:   6px;   // tabs, rows, inputs, icon buttons
  out property <length> radius-md:   8px;   // cards, segmented control
  out property <length> radius-lg:  12px;   // dialogs, command palette
  out property <length> radius-pill: 100px;

  // ── Font sizes ─────────────────────────────────────────────────────────────
  out property <length> font-xxs:  9px;    // badge / chip text (×N split, protocol chip)
  out property <length> font-xs:   10px;   // hints, group-header labels, shortcut badges
  out property <length> font-sm:   11px;   // captions, group headers (often +letter-spacing)
  out property <length> font-base: 13px;   // body / row text
  out property <length> font-lg:   15px;   // dialog titles, panel headers
  out property <length> font-xl:   19px;   // launchpad greeting
  out property <length> font-2xl:  25px;
  out property <length> font-mono: 12.5px; // terminal, fingerprints, host strings

  // ── Icon / glyph sizes (Fluent codepoints rendered as Text) ──────────────
  out property <length> icon-xs:    10px;  // chevrons and small inline glyphs
  out property <length> icon-sm:    12px;  // step-state glyphs in session overlays
  out property <length> icon-action:14px;  // command-palette action item glyph
  out property <length> icon-md:    16px;  // standard chrome icon (IconButton glyph default)
  out property <length> icon-bar:   17px;  // activity-bar panel icons
  out property <length> icon-alert: 18px;  // alert / warning banner icon
  out property <length> icon-xl:    22px;  // large overlay / empty-state icons

  // ── Accent preset swatches (single source of truth for the Settings panel) ─
  // Curated preset options shown in the Settings › Appearance accent picker.
  out property <[color]> accent-presets: [#3b82f6, #2dd4bf, #3fb950, #a78bfa];

  // ── OS accent ─────────────────────────────────────────────────────────────
  // The live OS accent color, written once at startup (and live, on the OS
  // accent-change signal where the platform supports it) via
  // `AppWindow.set-os-accent` - see `cm_platform::accent`. NOT folded into
  // `accent-presets` because it isn't a fixed preset color, it tracks a
  // runtime value. The reserved "OS accent" swatch in Settings sets `accent`
  // to this; `os-accent-index` is the sentinel `accent-index` value that
  // selection uses for it (one past the last preset, computed rather than a
  // literal so it never drifts if presets are added/removed).
  in-out property <color> os-accent-color: #3b82f6;
  out property <int> os-accent-index: accent-presets.length;

  // Segoe UI = Windows system font (our primary platform); falls back elsewhere.
  out property <string> font-family:       "Segoe UI";
  // Mono = the bundled Nerd Font shared with the terminal renderer.
  out property <string> font-family-mono:  "JetBrains Mono";
  // Cross-platform icon font: bundled Symbols Nerd Font Mono.
  out property <string> font-family-icons: "Symbols Nerd Font Mono";

  // ── Component metrics — density-aware ─────────────────────────────────────
  // and padding by 6px everywhere, which is enough to feel more spacious without
  // breaking any layout constraints. All callers read these tokens — zero
  // hardcoded sizes outside this file.
  out property <length> activity-bar-width: 48px;
  out property <length> side-panel-width:  252px;   // default; resizable + persisted
  // Drag-resize clamps for the side panel. Plain `int` (not
  // `length`) so they compare directly against the `int`-typed
  // `AppWindow.sidebar-width` property with no unit-stripping conversion.
  out property <int> side-panel-min-width: 180;
  out property <int> side-panel-max-width: 480;
  out property <length> tab-height:         density == 1 ? 36px : 30px;
  out property <length> tree-row-height:    density == 1 ? 32px : 26px;
  out property <length> status-bar-height:  density == 1 ? 30px : 26px;
  out property <length> control-height:     density == 1 ? 38px : 32px;  // buttons, inputs, segmented
  // ── Tree / keys panel row micro-metrics ──────────────────────────────────
  // Inline kind/protocol badge (e.g. "SSH", "RDP", "pw", "key").
  out property <length> tag-height:   density == 1 ? 18px : 15px;  // badge pill height in tree rows
  // Compact icon button used inside hover action groups in tree rows.
  out property <length> icon-btn:     density == 1 ? 26px : 22px;  // container side length
  // Hairline gap between adjacent compact icon buttons.
  out property <length> gap-hairline:  1px;
  // Settings panel section header row height .
  out property <length> settings-section-header-height: 34px;
  // Keyboard shortcut label column width in settings shortcut rows .
  out property <length> settings-shortcut-label-width: 112px;
  // Vertical scrollbar rail width (Fluent std-widgets `ScrollView`'s
  // vertical-bar draws 14px wide, overlaid on the flickable's right edge) -
  // scrollable field columns pad their content by this much on the right so
  // the rail never overdraws field borders.
  out property <length> scrollbar-gutter: 14px;
}
