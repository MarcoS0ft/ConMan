// ConMan — Launchpad (the productive "empty / new tab" state; GUI_DESIGN §5 + the
// Direction A pressure-test). Fills the session area when a tab has no live session:
// search-to-connect, recents, and group shortcuts instead of a blank screen.
//
//   import { Launchpad, RecentItem } from "screens/launchpad.slint";

import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton, StatusDot } from "../components.slint";
import { LineEdit } from "std-widgets.slint";

export struct RecentItem {
    id: int,
    name: string,
    meta: string,     // "2m ago" etc.
    kind: string,     // "SSH" | "RDP" | "TELNET" | "LOCAL"
    status: string,
}

export component Launchpad inherits Rectangle {
    in property <string>        greeting: "Welcome back, ops";
    in property <[RecentItem]>  recents;
    in-out property <string>    query;
    callback edited(string);
    callback open-recent(int);
    callback quick-connect();
    callback open-group-split();

    background: Theme.color-terminal-bg;

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        launchpad-wordmark := Image {
            source: Theme.dark-mode
                ? @image-url("../../../../resources/ConMan_Wordmark_DarkMode.svg")
                : @image-url("../../../../resources/ConMan_Wordmark_LightMode.svg");
            width: 192px;
            height: 72px;
            image-fit: contain;
            accessible-role: image;
            accessible-label: "Connection Manager";
        }

        Text { text: greeting; color: Theme.color-text; font-size: Theme.font-xl;
            font-family: Theme.font-family; font-weight: 700; }
        Text { text: "Jump back in, or start something new."; color: Theme.color-text-secondary;
            font-size: Theme.font-base; font-family: Theme.font-family; }

        // Search-to-connect.
        Rectangle {
            height: 40px;
            background: Theme.color-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.color-stroke;
            HorizontalLayout {
                padding-left: Theme.space-3; padding-right: Theme.space-3;
                spacing: Theme.space-2;
                // Search glyph — Theme.font-lg is 15px, matching the icon size here.
                Text { text: "\u{F0349}"; font-family: Theme.font-family-icons;
                    font-size: Theme.font-lg;
                    color: Theme.color-text-secondary; vertical-alignment: center; }
                LineEdit { placeholder-text: "Search a host, or type  ssh user@host  to connect…";
                    text <=> root.query; font-size: Theme.font-base;
                    accessible-label: "Search or connect";
                    edited(t) => { root.edited(t); } }
            }
        }

        // Group header — Theme.font-xs token (was 10px literal).
        Text { text: "RECENT"; color: Theme.color-text-disabled; font-size: Theme.font-xs;
            font-family: Theme.font-family; font-weight: 700; letter-spacing: 0.6px; }

        // Recents grid (2 columns).
        for item[idx] in recents : recent-item-row := Rectangle {
            height: 50px;
            background: Theme.color-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.color-stroke;
            // P8.1: one recent-connection card = one list item; label combines
            // the connection name + relative time (both dynamic).
            accessible-role: list-item;
            accessible-label: item.name + " · " + item.meta;
            accessible-item-index: idx;
            accessible-item-count: root.recents.length;
            accessible-action-default => { root.open-recent(idx); }
            HorizontalLayout {
                padding-left: Theme.space-3; padding-right: Theme.space-3;
                spacing: Theme.space-3;
                VerticalLayout { alignment: center; StatusDot { state: item.status; diameter: 8px; } }
                VerticalLayout { alignment: center; horizontal-stretch: 1;
                    Text { text: item.name; color: Theme.color-text; font-size: Theme.font-base;
                        font-family: Theme.font-family; font-weight: 600; }
                    // Item meta (time ago, etc.) — Theme.font-xs token (was 10px literal).
                    Text { text: item.meta; color: Theme.color-text-secondary;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-family-mono; }
                }
                VerticalLayout { alignment: center;
                    Rectangle { height: 16px; border-radius: 3px; background: Theme.color-hover;
                        HorizontalLayout { padding-left: 5px; padding-right: 5px;
                            // Protocol chip — Theme.font-xxs token (was 9px literal).
                            Text { text: item.kind; color: Theme.color-text-secondary;
                                font-size: Theme.font-xxs;
                                font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } } }
                }
            }
            TouchArea { clicked => { root.open-recent(idx); } }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Theme.space-2;
            launchpad-quick-connect-btn := PrimaryButton { text: "Quick connect"; clicked => { root.quick-connect(); } }
            launchpad-open-group-btn := SecondaryButton { text: "Open Production in split"; clicked => { root.open-group-split(); } }
        }
    }
}
