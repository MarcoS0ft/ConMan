// P1.4 — Connection profile editor + group settings modal.
//
// ProfileEditor: per-kind form (SSH / RDP / Local) with name, host/port/user,
// auth method, and credential assignment (with inherited/effective display).
// GroupEditor:   sets the group name and its default_credential.
//
// Both are mounted inside a Modal in app.slint and populated by the Rust
// controller before opening.  The Rust handler reads the form back via the
// save callbacks; it MUST clear any transient secret fields immediately.

import { Theme } from "../theme.slint";
import {
    FormField, PrimaryButton, SecondaryButton, SegmentedControl, Card
} from "../components.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";

// ── ConnProfile ────────────────────────────────────────────────────────────
// Data bag for the connection profile editor. All fields are in-out so Rust
// can pre-populate them before opening and read them back after save.
//
// `kind`  0 = SSH · 1 = RDP · 2 = Local
// `auth-method`  0 = Public key · 1 = Password · 2 = Agent  (SSH only)
// `selected-cred-idx`  index into AppWindow.cred-name-list; 0 = "Inherit"
// `effective-cred-name`  resolved credential name (may come from a group)
// `effective-inherited`  true when the effective cred comes from a group
// `selected-group-idx`  index into AppWindow.group-name-list; 0 = "Root (no group)"
// `rdp-domain` / `rdp-resolution`  RDP-only (kind == 1); mirror QuickConnectForm's
// fields (screens/dialogs.slint) so a profile-saved RDP connection can set them too.
export struct ConnProfile {
    id: int,
    name: string,
    group-id: int,
    kind: int,
    host: string,
    port: string,
    username: string,
    auth-method: int,
    selected-cred-idx: int,
    effective-cred-name: string,
    effective-inherited: bool,
    selected-group-idx: int,
    rdp-domain: string,
    rdp-resolution: string,
}

// ── GroupForm ──────────────────────────────────────────────────────────────
// Data bag for the group editor.  `default-cred-idx` is an index into
// AppWindow.cred-name-list (0 = "No default / inherit from parent").
// `selected-parent-idx` is an index into AppWindow.group-name-list;
// 0 = "Root (no parent)".
export struct GroupForm {
    id: int,
    name: string,
    parent-id: int,
    default-cred-idx: int,
    selected-parent-idx: int,
}

// ── ProfileEditor ──────────────────────────────────────────────────────────
// Mounted inside a Modal.  Rust sets `form` + `cred-name-list` + `group-name-list`
// before opening.
//
// Opaque card + bounded height: mirrors QuickConnectForm (screens/dialogs.slint) —
// a solid `color-overlay` panel with a border/radius so nothing behind the Modal
// scrim bleeds through, in both themes. The field column is capped to the
// available window height and scrolls internally so Save/Cancel are never
// pushed off the bottom on a short window (P7.2, gap #1/#2).
export component ProfileEditor inherits Rectangle {
    in-out property <ConnProfile> form;
    // Flat list of credential names for the ComboBox.
    // cred-name-list[0] is always "Inherit from group"; the rest map 1-to-1
    // to persisted credentials (Rust maintains this list in sync with the DB).
    in property <[string]> cred-name-list;
    // Flat list of group names for the group picker.
    // group-name-list[0] is always "Root (no group)"; the rest are group names
    // in sort order.  form.selected-group-idx indexes into this list.
    in property <[string]> group-name-list;
    callback save();
    callback cancel();

    // P8.1: no dialog role in Slint 1.17 — groupbox + "<Title> dialog".
    accessible-role: groupbox;
    accessible-label: (root.form.id == 0 ? "New connection" : "Edit connection") + " dialog";

    width: 520px;
    // Nearly-fill the Modal's centering region vertically, leaving a small
    // top/bottom gutter (alignment:center in the Modal, screens/dialogs.slint,
    // splits the remainder evenly). A bare percentage literal is the one
    // Slint form exempt from layout-info propagation -- binding to an
    // ancestor's *resolved* pixel height instead creates a genuine
    // compile-time binding loop through the Window's own preferred size.
    // This is what actually guarantees Save/Cancel are never pushed off the
    // bottom: the field ScrollView below gets whatever's left after the fixed-
    // height Title/Actions rows, however tall/short the window is (P7.2 #2).
    height: 94%;
    background: Theme.color-overlay;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    // Absorb clicks so the Modal scrim behind doesn't dismiss on inner clicks
    // (mirrors QuickConnectForm, screens/dialogs.slint).
    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;

        // ── Title ──────────────────────────────────────────────────────
        Text {
            text: root.form.id == 0 ? "New Connection" : "Edit Connection";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }

        // ── Scrollable field column ──────────────────────────────────────
        // Bounded by the card's max-height above; Title and Actions stay
        // outside the scroll region so they're always visible.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-5;
                // Right gutter so the vertical scrollbar rail never overdraws
                // the fields' right borders when the form scrolls (P7.6,
                // fixes P7.2-a).
                padding-right: Theme.scrollbar-gutter;

                // ── Name ──────────────────────────────────────────────
                profile-name-field := FormField {
                    label: "Name";
                    placeholder: "Connection name";
                    text <=> root.form.name;
                }

                // ── Group (move between groups) ───────────────────────
                if root.group-name-list.length > 0 : VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Group";
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-family;
                        font-weight: 600;
                    }
                    profile-group-combo := ComboBox {
                        model: root.group-name-list;
                        current-index <=> root.form.selected-group-idx;
                        accessible-label: "Group";
                    }
                }

                // ── Kind ──────────────────────────────────────────────
                VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Type";
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-family;
                        font-weight: 600;
                    }
                    SegmentedControl {
                        options: ["SSH", "RDP", "Local"];
                        selected <=> root.form.kind;
                        // A saved RDP connection almost never wants port 22
                        // and vice versa -- keep the pre-filled default in
                        // step with kind so an untouched Port field still
                        // saves the right value (mirrors QuickConnectForm's
                        // `changed kind` handler, screens/dialogs.slint).
                        changed(new-kind) => {
                            if (new-kind == 1 && root.form.port == "22") {
                                root.form.port = "3389";
                            } else if (new-kind != 1 && root.form.port == "3389") {
                                root.form.port = "22";
                            }
                        }
                    }
                }

                // ── Host / Port (SSH + RDP) ───────────────────────────
                if root.form.kind != 2 : profile-host-field := FormField {
                    label: "Host";
                    placeholder: "hostname or IP address";
                    text <=> root.form.host;
                }
                if root.form.kind != 2 : profile-port-field := FormField {
                    label: "Port";
                    placeholder: root.form.kind == 0 ? "22" : "3389";
                    text <=> root.form.port;
                }

                // ── Username (SSH + RDP) ──────────────────────────────
                if root.form.kind != 2 : profile-username-field := FormField {
                    label: "Username";
                    placeholder: "login username";
                    text <=> root.form.username;
                }

                // ── Auth method (SSH only) ────────────────────────────
                if root.form.kind == 0 : VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Authentication";
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-family;
                        font-weight: 600;
                    }
                    SegmentedControl {
                        options: ["Public Key", "Password", "Agent"];
                        selected <=> root.form.auth-method;
                    }
                }

                // ── RDP-only fields (mirror QuickConnectForm) ─────────
                if root.form.kind == 1 : profile-rdp-domain-field := FormField {
                    label: "Domain";
                    placeholder: "(optional, e.g. CORP)";
                    text <=> root.form.rdp-domain;
                }
                if root.form.kind == 1 : profile-rdp-resolution-field := FormField {
                    label: "Resolution";
                    placeholder: "1280x720";
                    text <=> root.form.rdp-resolution;
                }

                // ── Credential ─────────────────────────────────────────
                VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Credential";
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-family;
                        font-weight: 600;
                    }
                    profile-cred-combo := ComboBox {
                        model: root.cred-name-list;
                        current-index <=> root.form.selected-cred-idx;
                        accessible-label: "Credential";
                    }
                    // Show the effective (possibly inherited) credential.
                    if root.form.effective-cred-name != "" : HorizontalLayout {
                        spacing: Theme.space-2;
                        padding-top: Theme.space-1;
                        Text {
                            text: root.form.effective-inherited ? "Inheriting:" : "Using:";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.form.effective-cred-name;
                            color: root.form.effective-inherited
                                ? Theme.color-accent : Theme.color-text;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        if root.form.effective-inherited : Text {
                            text: "(from group)";
                            color: Theme.color-text-disabled;
                            font-size: Theme.font-sm;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── Actions ──────────────────────────────────────────────────
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: end;
            padding-top: Theme.space-2;
            profile-cancel-btn := SecondaryButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            profile-save-btn := PrimaryButton {
                text: "Save";
                enabled: root.form.name != "";
                clicked => { root.save(); }
            }
        }
    }
}

// ── GroupEditor ────────────────────────────────────────────────────────────
// Lets the user rename a group, pick its default credential, and move it to a
// different parent group.
//
// Opaque card: mirrors ProfileEditor / QuickConnectForm (P7.6, fixes the same
// "no opaque card" bleed-through defect P7.2 fixed for ProfileEditor) — a
// solid `color-overlay` panel with a border/radius so nothing behind the
// Modal scrim bleeds through, in both themes.
export component GroupEditor inherits Rectangle {
    in-out property <GroupForm> form;
    in property <[string]> cred-name-list;
    // Flat list of group names for the parent picker.
    // group-name-list[0] = "Root (no parent)"; the rest are sorted group names.
    in property <[string]> group-name-list;
    callback save();
    callback cancel();

    // P8.1: no dialog role in Slint 1.17 — groupbox + "<Title> dialog".
    accessible-role: groupbox;
    accessible-label: (root.form.id == 0 ? "New group" : "Group settings") + " dialog";

    width: 520px;
    background: Theme.color-overlay;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    // Absorb clicks so the Modal scrim behind doesn't dismiss on inner clicks
    // (mirrors ProfileEditor / QuickConnectForm).
    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;

        Text {
            text: root.form.id == 0 ? "New Group" : "Group Settings";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }

        group-name-field := FormField {
            label: "Name";
            placeholder: "Group name";
            text <=> root.form.name;
        }

        // ── Parent group (move between groups) ────────────────────────
        if root.group-name-list.length > 0 : VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Parent Group";
                color: Theme.color-text-secondary;
                font-size: Theme.font-sm;
                font-family: Theme.font-family;
                font-weight: 600;
            }
            group-parent-combo := ComboBox {
                model: root.group-name-list;
                current-index <=> root.form.selected-parent-idx;
                accessible-label: "Parent Group";
            }
        }

        VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Default Credential";
                color: Theme.color-text-secondary;
                font-size: Theme.font-sm;
                font-family: Theme.font-family;
                font-weight: 600;
            }
            Text {
                text: "Connections in this group inherit this credential unless they override it.";
                color: Theme.color-text-disabled;
                font-size: Theme.font-xs;
                font-family: Theme.font-family;
                wrap: word-wrap;
            }
            group-default-cred-combo := ComboBox {
                model: root.cred-name-list;
                current-index <=> root.form.default-cred-idx;
                accessible-label: "Default Credential";
            }
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: end;
            group-cancel-btn := SecondaryButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            group-save-btn := PrimaryButton {
                text: "Save";
                enabled: root.form.name != "";
                clicked => { root.save(); }
            }
        }
    }
}
