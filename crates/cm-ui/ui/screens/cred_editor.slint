// — Credential editor modal.
//
// Allows creating and editing a Credential (name, kind, username) and storing
// the secret via the OS keychain. The `secret` / `passphrase` fields
// are TRANSIENT — Rust MUST clear them immediately after reading them in the
// `cred-save` callback.
//
// Mounted inside a Modal in app.slint.

import { Theme } from "../theme.slint";
import {
    FormField, PrimaryButton, SecondaryButton, SegmentedControl
} from "../components.slint";
import { ComboBox } from "std-widgets.slint";

// ── CredFormData ───────────────────────────────────────────────────────────
// Data bag for the credential editor.
//
// `kind` 0 = Password · 1 = SSH Key · 2 = SSH Key + Passphrase
// `folder-id` 0 = root (no folder)
// `secret` TRANSIENT — cleared by Rust after cred-save fires
// `passphrase` TRANSIENT — cleared by Rust after cred-save fires
export struct CredFormData {
    id: string,
    name: string,
    kind: int,
    username: string,
    folder-id: string,
    // 1-based index into AppWindow.folder-name-list; 0 = "Root (no folder)".
    // Bound two-way to the folder ComboBox; resolved to a DB id in on_cred_save.
    selected-folder-idx: int,
    secret: string,
    passphrase: string,
}

// ── CredEditor ─────────────────────────────────────────────────────────────
// Opaque card: mirrors ProfileEditor / GroupEditor / QuickConnectForm (
// #4 - the SAME "no opaque card" bleed-through defect fixed for
// ProfileEditor and fixed for GroupEditor, but this dialog was missed)
// - a solid `color-overlay` panel with a border/radius so nothing behind
// the Modal scrim bleeds through, in both themes.
export component CredEditor inherits Rectangle {
    in-out property <CredFormData> form;
    // Flat folder name list for the folder combo box.
    // Index 0 is "Root (no folder)"; subsequent entries are folder paths.
    in property <[string]> folder-name-list;
    callback save();
    callback cancel();

    // no dialog role in Slint 1.17 — groupbox + "<Title> dialog".
    accessible-role: groupbox;
    accessible-label: (root.form.id == "" ? "New credential" : "Edit credential") + " dialog";

    width: 520px;
    background: Theme.color-overlay;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    // Absorb clicks so the Modal scrim behind doesn't dismiss on inner clicks
    // (mirrors ProfileEditor / GroupEditor / QuickConnectForm).
    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;

        // ── Title ─────────────────────────────────────────────────────
        Text {
            text: root.form.id == "" ? "New Credential" : "Edit Credential";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }

        // ── Name ──────────────────────────────────────────────────────
        cred-name-field := FormField {
            label: "Name";
            placeholder: "e.g. ops@prod, deploy key";
            text <=> root.form.name;
        }

        // ── Kind ──────────────────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Type";
                color: Theme.color-text-secondary;
                font-size: Theme.font-sm;
                font-family: Theme.font-family;
                font-weight: 600;
            }
            SegmentedControl {
                options: ["Password", "SSH Key", "SSH Key+PP"];
                selected <=> root.form.kind;
            }
        }

        // ── Username ──────────────────────────────────────────────────
        cred-username-field := FormField {
            label: "Username";
            placeholder: "login username (optional)";
            text <=> root.form.username;
        }

        // ── Secret (Password kind: password field) ───────────────────
        if root.form.kind == 0 : cred-secret-field := FormField {
            label: "Password";
            placeholder: "••••••••";
            password: true;
            text <=> root.form.secret;
        }

        // ── SSH Key path ──────────────────────────────────────────────
        if root.form.kind == 1 || root.form.kind == 2 : cred-key-path-field := FormField {
            label: "Private Key Path";
            placeholder: "~/.ssh/id_ed25519";
            text <=> root.form.secret;
        }

        // ── Passphrase (SSH Key+PP kind) ─────────────────────────────
        if root.form.kind == 2 : cred-passphrase-field := FormField {
            label: "Passphrase";
            placeholder: "key passphrase (optional)";
            password: true;
            text <=> root.form.passphrase;
        }

        // ── Folder ───────────────────────────────────────────────────
        if root.folder-name-list.length > 1 : VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Folder";
                color: Theme.color-text-secondary;
                font-size: Theme.font-sm;
                font-family: Theme.font-family;
                font-weight: 600;
            }
            cred-folder-combo := ComboBox {
                model: root.folder-name-list;
                // Two-way bound: Rust sets selected-folder-idx before opening
                // the editor; on_cred_save resolves it back to a DB id.
                current-index <=> root.form.selected-folder-idx;
                accessible-label: "Folder";
            }
        }

        // ── Actions ───────────────────────────────────────────────────
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: end;
            padding-top: Theme.space-2;
            cred-cancel-btn := SecondaryButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            cred-save-btn := PrimaryButton {
                text: "Save";
                enabled: root.form.name != "";
                clicked => { root.save(); }
            }
        }
    }
}

// ── Credential-folder editor ───────────────────────────────────────────────
// CredentialFolder identity and optional parent cross the Slint boundary only
// as canonical decimal strings. Empty ID means a new folder; empty parent means
// root. Picker indices remain local UI integers.
export struct CredFolderFormData {
    id: string,
    name: string,
    parent-id: string,
    selected-parent-idx: int,
}

export component CredFolderEditor inherits Rectangle {
    in-out property <CredFolderFormData> form;
    in property <[string]> parent-name-list;
    in property <bool> save-pending: false;
    in property <string> save-error: "";
    callback save();
    callback cancel();
    callback form-edited();

    accessible-role: groupbox;
    accessible-label: (root.form.id == "" ? "New credential folder" : "Edit credential folder") + " dialog";

    width: 480px;
    background: Theme.color-overlay;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;
    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;
        Text {
            text: root.form.id == "" ? "New Credential Folder" : "Edit Credential Folder";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }
        folder-name-field := FormField {
            label: "Name";
            placeholder: "e.g. Production keys";
            text <=> root.form.name;
            edited(_) => { root.form-edited(); }
        }
        VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Parent folder";
                color: Theme.color-text-secondary;
                font-size: Theme.font-sm;
                font-family: Theme.font-family;
                font-weight: 600;
            }
            ComboBox {
                model: root.parent-name-list;
                current-index <=> root.form.selected-parent-idx;
                accessible-label: "Parent folder";
                selected(_) => { root.form-edited(); }
            }
        }
        if root.save-error != "" : Text {
            text: root.save-error;
            color: Theme.color-error;
            font-size: Theme.font-sm;
            font-family: Theme.font-family;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: end;
            padding-top: Theme.space-2;
            SecondaryButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            PrimaryButton {
                text: root.save-pending ? "Saving…" : "Save";
                enabled: !root.save-pending && root.form.name != "";
                clicked => { root.save(); }
            }
        }
    }
}
