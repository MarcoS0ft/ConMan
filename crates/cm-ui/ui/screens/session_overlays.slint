// ConMan — Session-state overlays (GUI_DESIGN §5). Rendered in the session area in place
// of the TerminalSurface while a tab is NOT Connected (the redraw timer paints the grid
// only once Connected — P3.2). One overlay per non-live state.
//
// Also home to `SearchOverlay` (P6.7): unlike the two below, it floats *above* a live
// terminal (small, top-right) rather than replacing it.
//
//   import { ConnectingOverlay, ErrorOverlay, SearchOverlay } from "screens/session_overlays.slint";

import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton, IconButton } from "../components.slint";
import { LineEdit } from "std-widgets.slint";

// ── ConnectingOverlay ─────────────────────────────────────────────────────────
// 8-dot orbital spinner + "Connecting to user@host…" + one live status line.
//
// P6.9 (gap 16): this used to be a 3-step checklist ("Resolving host" / "TCP
// handshake · :22" / "Authenticating · ed25519") driven by a `step` index that
// Rust never advanced past 0 — the labels were fiction dressed up as progress.
// `cm_session::SessionStatus` only reports coarse state (Connecting/Connected/
// Failed/Disconnected/Exited) with no auth-stage sub-events to drive real
// per-step transitions, and inventing a new session-layer event protocol is
// out of scope here (see the task spec's "Out" section). So this overlay now
// shows exactly what is true: we are waiting on a remote protocol handshake
// for `identity`, nothing more specific.
//
// Spinner note: rotation-angle is only valid on Image in Slint 1.17; we use an
// 8-dot-on-ring approach driven by a Timer-cycled integer (0-7) instead.
export component ConnectingOverlay inherits Rectangle {
    in property <string> identity: "ops@web-prod-01";
    // Protocol label for the one honest status line below (e.g. "SSH", "RDP").
    in property <string> kind: "session";
    // Spinner state: 0-7 cycles clockwise through eight orbital dot positions.
    property <int> spin-tick: 0;
    // P7.3 (win-ui-investigation #4): an explicit way to abort a slow/held
    // connect and return, instead of relying solely on the tab's own ✕. Wired
    // in app.slint to the same `close-tab` path the tab close button uses.
    callback cancel();

    // P8.1: not a dialog (it replaces the session surface in place, not a
    // modal), but still a distinct region a screen reader should be able to
    // land on — a live, human-meaningful status line.
    accessible-role: region;
    accessible-label: "Connecting to " + root.identity;

    background: Theme.color-terminal-bg;

    // ── 8-dot orbital spinner (r=15px, 40×40 container, dots 5×5px) ──────────
    // Positions (top-left of 5×5 dot) for N, NE, E, SE, S, SW, W, NW on a 15px radius
    // centered at (20, 20) in the 40px container. Alpha trail: head=1.0, -1=0.65, -2=0.35,
    // dim=0.12. Conditions are spelled out per dot to avoid needing mod() in property exprs.
    Rectangle {
        width: 40px; height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height / 2) - 60px;
        // N  (0°)   center=(20, 5)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 17px; y: 2px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 0 ? 1.0 : root.spin-tick == 1 ? 0.65
                    : root.spin-tick == 2 ? 0.35 : 0.12); }
        // NE (45°)  center=(30.6, 9.4)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 28px; y: 7px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 1 ? 1.0 : root.spin-tick == 2 ? 0.65
                    : root.spin-tick == 3 ? 0.35 : 0.12); }
        // E  (90°)  center=(35, 20)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 32px; y: 17px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 2 ? 1.0 : root.spin-tick == 3 ? 0.65
                    : root.spin-tick == 4 ? 0.35 : 0.12); }
        // SE (135°) center=(30.6, 30.6)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 28px; y: 28px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 3 ? 1.0 : root.spin-tick == 4 ? 0.65
                    : root.spin-tick == 5 ? 0.35 : 0.12); }
        // S  (180°) center=(20, 35)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 17px; y: 32px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 4 ? 1.0 : root.spin-tick == 5 ? 0.65
                    : root.spin-tick == 6 ? 0.35 : 0.12); }
        // SW (225°) center=(9.4, 30.6)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 7px; y: 28px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 5 ? 1.0 : root.spin-tick == 6 ? 0.65
                    : root.spin-tick == 7 ? 0.35 : 0.12); }
        // W  (270°) center=(5, 20)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 2px; y: 17px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 6 ? 1.0 : root.spin-tick == 7 ? 0.65
                    : root.spin-tick == 0 ? 0.35 : 0.12); }
        // NW (315°) center=(9.4, 9.4)
        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; x: 7px; y: 7px;
            background: Theme.color-accent.with-alpha(
                root.spin-tick == 7 ? 1.0 : root.spin-tick == 0 ? 0.65
                    : root.spin-tick == 1 ? 0.35 : 0.12); }
    }
    // Advance the spinner head one position every 80ms (≈ 8 fps full orbit).
    Timer { interval: 80ms; running: true;
        triggered => { root.spin-tick = root.spin-tick >= 7 ? 0 : root.spin-tick + 1; } }

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-4;
        padding-top: 30px;
        Text {
            text: "Connecting to " + identity + "…";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 600;
            horizontal-alignment: center;
        }
        // One honest, always-active status line (see the type-level comment above
        // for why this is no longer a fake multi-step checklist).
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            Text {
                text: "\u{EB19}";  // active-step glyph (same one the old checklist used)
                font-family: Theme.font-family-icons;
                font-size: Theme.icon-sm;
                color: Theme.color-accent;
                vertical-alignment: center;
            }
            Text {
                text: "Establishing " + (root.kind == "" ? "the" : "the " + root.kind) + " connection…";
                color: Theme.color-text;
                font-size: Theme.font-mono;
                font-family: Theme.font-family-mono;
            }
        }
        // P7.3: Cancel affordance — aborts the held connect and returns
        // (closes this tab via the same path as the tab strip's ✕).
        HorizontalLayout {
            alignment: center;
            connecting-cancel-btn := SecondaryButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
        }
    }
}

// ── ErrorOverlay ──────────────────────────────────────────────────────────────
// Failed state: error glyph + reason + Reconnect (re-runs connect with same settings)
// and Edit. Tab status dot is red while this shows.
export component ErrorOverlay inherits Rectangle {
    in property <string> identity: "ops@web-prod-01:22";
    in property <string> reason: "Connection refused · ECONNREFUSED";
    in property <string> detail: "after 4.2s";
    // P9.12 #3: `true` for a genuine `SessionStatus::Failed` (red "Connection
    // failed" framing); `false` for a clean `Disconnected`/`Exited` end (a
    // neutral "Session ended" title + neutral accent color) -- exiting a
    // shell normally must not look like a failure. Reconnect stays available
    // either way (see `root.reconnect` below).
    in property <bool> is-failure: true;
    callback reconnect();
    callback edit();

    // P8.1: same region rationale as ConnectingOverlay.
    accessible-role: region;
    accessible-label: (root.is-failure ? "Connection error for " : "Session ended for ") + root.identity;

    background: Theme.color-terminal-bg;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-4;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 46px; height: 46px;
                border-radius: Theme.radius-md;
                background: (root.is-failure ? Theme.color-error : Theme.color-disconnected).with-alpha(0.13);
                // Error icon — Theme.icon-xl token (was 22px literal).
                Text { text: "\u{F0026}"; font-family: Theme.font-family-icons;
                    font-size: Theme.icon-xl;
                    color: root.is-failure ? Theme.color-error : Theme.color-disconnected;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height; }
            }
        }
        Text { text: root.is-failure ? "Connection failed" : "Session ended"; color: Theme.color-text; font-size: Theme.font-lg;
            font-family: Theme.font-family; font-weight: 600; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            // P7.5: some reasons (e.g. the legacy-Standard-RDP-Security message)
            // are full sentences, not a short connector string — bound the
            // width and wrap so they don't get clipped to one line.
            VerticalLayout {
                width: min(680px, root.width - Theme.space-8 * 2);
                spacing: Theme.space-1;
                Text { text: reason; color: root.is-failure ? Theme.color-error : Theme.color-text-secondary;
                    font-size: Theme.font-mono;
                    font-family: Theme.font-family-mono; horizontal-alignment: center;
                    wrap: word-wrap; }
                Text { text: identity + " · " + detail; color: Theme.color-text-secondary;
                    font-size: Theme.font-sm; font-family: Theme.font-family-mono; horizontal-alignment: center; }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            error-reconnect-btn := PrimaryButton { text: "Reconnect"; clicked => { root.reconnect(); } }
            error-edit-btn := SecondaryButton { text: "Edit…"; clicked => { root.edit(); } }
        }
    }
}

// ── SearchOverlay ──────────────────────────────────────────────────────────────
// Whole-buffer terminal search (P6.7, Ctrl⇧F): a small floating find-bar over the
// top-right of a live terminal (not full-bleed — the terminal underneath stays
// visible and live). Typed keys normally reach this via the terminal FocusScope
// forwarding to Rust (`sessions.rs`'s `wire_key_input` → `search::handle_search_key`,
// mirroring how the command palette's query box works); the LineEdit's own
// `edited`/`accepted` callbacks are wired too, for the case where the box has actual
// input focus (e.g. after a mouse click into it).
export component SearchOverlay inherits Rectangle {
    in-out property <string> query: "";
    in property <int> match-count: 0;
    in property <int> current-index: -1; // 0-based; -1 = no matches
    callback edited(string);
    callback next();
    callback prev();
    callback close();

    // P8.1: a small finder popup — dialog-like but not modal; groupbox +
    // static label (its own content, the query text, is separately labeled
    // on the input field below).
    accessible-role: groupbox;
    accessible-label: "Find in scrollback dialog";

    width: 320px;
    height: 44px;
    background: Theme.color-overlay;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.color-stroke;

    TouchArea {} // absorb clicks so they don't fall through to the terminal beneath

    HorizontalLayout {
        padding-left: Theme.space-3; padding-right: Theme.space-3;
        spacing: Theme.space-2;
        Text {
            text: "\u{F0349}";  // Search / magnifier (matches CommandPalette's icon).
            font-family: Theme.font-family-icons;
            font-size: Theme.icon-sm;
            color: Theme.color-text-secondary;
            vertical-alignment: center;
        }
        input := LineEdit {
            placeholder-text: "Find in scrollback…";
            text <=> root.query;
            horizontal-stretch: 1;
            accessible-label: "Find in scrollback";
            edited(t) => { root.edited(t); }
            accepted => { root.next(); }
        }
        Text {
            text: root.match-count == 0 ? "0/0" : (root.current-index + 1) + "/" + root.match-count;
            color: Theme.color-text-secondary;
            font-size: Theme.font-xs;
            font-family: Theme.font-family-mono;
            vertical-alignment: center;
        }
        search-prev-btn := IconButton {
            glyph: "\u{EAB7}"; // ChevronUp -> previous match
            size: 22px; glyph-size: Theme.icon-xs;
            tooltip: "Previous match (Shift+Enter)";
            clicked => { root.prev(); }
        }
        search-next-btn := IconButton {
            glyph: "\u{EAB4}"; // ChevronDown -> next match
            size: 22px; glyph-size: Theme.icon-xs;
            tooltip: "Next match (Enter)";
            clicked => { root.next(); }
        }
        search-close-btn := IconButton {
            glyph: "\u{EA76}"; // cod-close
            size: 22px; glyph-size: Theme.icon-xs;
            tooltip: "Close (Esc)";
            clicked => { root.close(); }
        }
    }
}
