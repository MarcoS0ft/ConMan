// ConMan — Session-state overlays (GUI_DESIGN §5). Rendered in the session area in place
// of the TerminalSurface while a tab is NOT Connected (the redraw timer paints the grid
// only once Connected — P3.2). One overlay per non-live state.
//
//   import { ConnectingOverlay, ErrorOverlay } from "screens/session_overlays.slint";

import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton } from "../components.slint";

// ── ConnectingOverlay ─────────────────────────────────────────────────────────
// Spinner + "Connecting to user@host…" + a step checklist driven by Rust.
//   step: 0 resolving · 1 tcp · 2 auth  (steps below `step` show done, `step` is active)
export component ConnectingOverlay inherits Rectangle {
    in property <string> identity: "ops@web-prod-01";
    in property <int>    step: 2;
    property <angle>     spin: 0deg;

    background: Theme.color-terminal-bg;

    // Continuous spinner.
    Rectangle {
        width: 40px; height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height / 2) - 60px;
        rot := Rectangle {
            width: 100%; height: 100%;
            border-width: 3px;
            border-radius: 20px;
            border-color: Theme.color-accent.with-alpha(0.2);
            // Accent arc (top) gives the rotation something visible.
            Rectangle { width: 100%; height: 50%; y: 0px; clip: true;
                Rectangle { width: 100%; height: 200%; border-width: 3px; border-radius: 20px;
                    border-color: transparent; }
            }
            rotation-angle: root.spin;
        }
    }
    // Drive the spinner from an animation tick.
    Timer { interval: 16ms; running: true; triggered => { root.spin += 6deg; } }

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-4;
        padding-top: 30px;
        Text {
            text: "Connecting to " + identity + "…";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 600;
            horizontal-alignment: center;
        }
        // Steps.
        for s[i] in ["Resolving host", "TCP handshake · :22", "Authenticating · ed25519"]: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            Text {
                text: i < root.step ? "\u{E73E}" : (i == root.step ? "\u{E712}" : "\u{E73C}");  // done / active / pending
                font-family: Theme.font-family-icons;
                font-size: 12px;
                color: i < root.step ? Theme.color-connected
                     : i == root.step ? Theme.color-accent : Theme.color-text-disabled;
                vertical-alignment: center;
            }
            Text { text: s; color: i <= root.step ? Theme.color-text : Theme.color-text-secondary;
                font-size: Theme.font-mono; font-family: Theme.font-family-mono; }
        }
    }
}

// ── ErrorOverlay ──────────────────────────────────────────────────────────────
// Failed state: error glyph + reason + Reconnect (re-runs connect with same settings)
// and Edit. Tab status dot is red while this shows.
export component ErrorOverlay inherits Rectangle {
    in property <string> identity: "ops@web-prod-01:22";
    in property <string> reason: "Connection refused · ECONNREFUSED";
    in property <string> detail: "after 4.2s";
    callback reconnect();
    callback edit();

    background: Theme.color-terminal-bg;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-4;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 46px; height: 46px;
                border-radius: Theme.radius-md;
                background: Theme.color-error.with-alpha(0.13);
                Text { text: "\u{E7BA}"; font-family: Theme.font-family-icons; font-size: 22px;
                    color: Theme.color-error; horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height; }
            }
        }
        Text { text: "Connection failed"; color: Theme.color-text; font-size: Theme.font-lg;
            font-family: Theme.font-family; font-weight: 600; horizontal-alignment: center; }
        VerticalLayout {
            Text { text: reason; color: Theme.color-error; font-size: Theme.font-mono;
                font-family: Theme.font-family-mono; horizontal-alignment: center; }
            Text { text: identity + " · " + detail; color: Theme.color-text-secondary;
                font-size: Theme.font-sm; font-family: Theme.font-family-mono; horizontal-alignment: center; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            PrimaryButton { text: "Reconnect"; clicked => { root.reconnect(); } }
            SecondaryButton { text: "Edit…"; clicked => { root.edit(); } }
        }
    }
}
