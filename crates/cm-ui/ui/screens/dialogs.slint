// ConMan — Modal base + feature dialogs (GUI_DESIGN §4).
//   Modal                — scrim + centered card; Esc cancels (wire at the window level).
//   QuickConnectForm     — host/port/username + auth SegmentedControl + conditional secret (P3.2).
//   HostKeyDialog        — TOFU accept (unknown) and the loud mismatch warning (P3.1 policy).
//   CertDialog           — RDP TOFU accept (unknown/self-signed) and the loud mismatch warning (P4.2).
//   KbdInteractiveDialog — SSH keyboard-interactive challenge/response prompt (P6.13).
//   ImportPasswordDialog — mRemoteNG import password prompt (P9.4).
//   DeleteConfirmationDialog — destructive connection/group confirmation.
//
//   import { Modal, QuickConnectForm, HostKeyDialog, CertDialog, KbdInteractiveDialog, KbdPromptRow, ImportPasswordDialog, DeleteConfirmationDialog } from "screens/dialogs.slint";

import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton, SegmentedControl, FormField, StatusDot } from "../components.slint";

// ── Modal ───────────────────────────────────────────────────────────────────
// Full-window scrim that centers its @children (a Card). Mount as the LAST child of
// the window so it floats above the shell. Esc → dismissed() is wired by the parent.
export component Modal inherits Rectangle {
    in property <bool> open: false;
    callback dismissed();

    visible: open;
    width: 100%;
    height: 100%;
    background: Theme.color-scrim;

    // Click-out to dismiss (clicks on the card are absorbed by its own TouchArea).
    TouchArea { clicked => { root.dismissed(); } }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// ── QuickConnectForm ──────────────────────────────────────────────────────────
// Kind selector: 0 SSH · 1 RDP · 2 Telnet · 3 Local — swaps the fields below
// to the per-kind set and dispatches to the matching open-*-tab in Rust
// (`sessions::wire_qc_connect`). Secrets are held in memory only and never logged;
// a local quick-connect has no secret at all, it just spawns a shell.
//
// SSH auth-method: 0 Public key · 1 Password · 2 Agent · 3 Keyboard interactive
// (conditional field below; P6.13 adds option 3, no upfront secret — the challenge
// is answered live via KbdInteractiveDialog once the server asks for it).
export component QuickConnectForm inherits Rectangle {
    in-out property <int>    kind: 0;
    in-out property <string> host;
    in-out property <string> port: "22";
    in-out property <string> username;
    in-out property <int>    auth-method: 0;
    in-out property <string> secret;        // SSH: password OR key path. RDP: password.
    in-out property <string> passphrase;    // SSH public-key only.
    in-out property <string> rdp-domain;
    in-out property <string> rdp-resolution: "1280x720";
    in-out property <string> local-program;
    in-out property <string> local-args;
    in-out property <string> local-cwd;
    callback connect();
    callback cancel();

    // P8.1: no dialog role exists in Slint 1.17 — dialog root = groupbox +
    // "<Title> dialog" label (the contract's rule). Title text is dynamic
    // per kind, so the label follows it.
    accessible-role: groupbox;
    accessible-label: (root.kind == 0 ? "New SSH connection"
        : root.kind == 1 ? "New RDP connection"
        : root.kind == 2 ? "New Telnet connection" : "New local shell") + " dialog";

    width: 520px;
    background: Theme.color-overlay;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    // Absorb clicks so the Modal scrim behind doesn't dismiss on inner clicks.
    TouchArea {}

    // Keep a protocol default in step with the selected kind. Arbitrary
    // user-entered ports are deliberately left alone.
    changed kind => {
        if (root.kind == 1 && (root.port == "22" || root.port == "23")) {
            root.port = "3389";
        } else if (root.kind == 2 && (root.port == "22" || root.port == "3389")) {
            root.port = "23";
        } else if (root.kind == 0 && (root.port == "23" || root.port == "3389")) {
            root.port = "22";
        }
    }

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        // Title.
        HorizontalLayout {
            Text {
                text: root.kind == 0 ? "New SSH connection"
                    : root.kind == 1 ? "New RDP connection"
                    : root.kind == 2 ? "New Telnet connection"
                    : "New local shell";
                color: Theme.color-text;
                font-size: Theme.font-lg;
                font-family: Theme.font-family;
                font-weight: 700;
                horizontal-stretch: 1;
            }
        }

        // Kind selector.
        VerticalLayout {
            spacing: Theme.space-2;
            Text { text: "TYPE"; color: Theme.color-text-secondary;
                font-size: Theme.font-sm; font-family: Theme.font-family; font-weight: 600; }
            SegmentedControl {
                options: ["SSH", "RDP", "Telnet", "Local"];
                selected <=> root.kind;
            }
        }

        // ── Host + port (SSH + RDP) ────────────────────────────────────
        if root.kind != 3 : HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout { horizontal-stretch: 1;
                qc-host-field := FormField { label: "HOST"; placeholder: "web-prod-01.lab"; text <=> root.host; }
            }
            Rectangle { width: 100px;
                qc-port-field := FormField {
                    label: "PORT";
                    placeholder: root.kind == 0 ? "22" : root.kind == 1 ? "3389" : "23";
                    text <=> root.port;
                }
            }
        }

        // ── Username (SSH + RDP) ────────────────────────────────────────
        if root.kind == 0 || root.kind == 1 : qc-username-field := FormField {
            label: "USERNAME";
            placeholder: root.kind == 0 ? "ops" : "administrator";
            text <=> root.username;
        }

        // ── SSH auth method ──────────────────────────────────────────────
        if root.kind == 0 : VerticalLayout {
            spacing: Theme.space-2;
            Text { text: "AUTH METHOD"; color: Theme.color-text-secondary;
                font-size: Theme.font-sm; font-family: Theme.font-family; font-weight: 600; }
            SegmentedControl {
                options: ["Public key", "Password", "Agent", "Keyboard interactive"];
                selected <=> root.auth-method;
            }
        }
        if root.kind == 0 && auth-method == 0 : qc-secret-field := FormField { label: "PRIVATE KEY"; placeholder: "~/.ssh/id_ed25519"; text <=> root.secret; }
        if root.kind == 0 && auth-method == 0 : qc-passphrase-field := FormField { label: "PASSPHRASE"; placeholder: ""; password: true; text <=> root.passphrase; }
        if root.kind == 0 && auth-method == 1 : qc-password-field := FormField { label: "PASSWORD"; placeholder: ""; password: true; text <=> root.secret; }
        if root.kind == 0 && auth-method == 2 : Text {
            text: "Uses the running SSH agent. No secret stored.";
            color: Theme.color-text-secondary;
            font-size: Theme.font-sm;
            font-family: Theme.font-family;
        }
        if root.kind == 0 && auth-method == 3 : Text {
            text: "The server will prompt you for credentials (e.g. a password and a one-time code) after connecting.";
            color: Theme.color-text-secondary;
            font-size: Theme.font-sm;
            font-family: Theme.font-family;
            wrap: word-wrap;
        }

        // ── RDP-only fields ──────────────────────────────────────────────
        if root.kind == 1 : qc-rdp-domain-field := FormField { label: "DOMAIN"; placeholder: "(optional, e.g. CORP)"; text <=> root.rdp-domain; }
        if root.kind == 1 : qc-rdp-resolution-field := FormField { label: "RESOLUTION"; placeholder: "1280x720"; text <=> root.rdp-resolution; }
        if root.kind == 1 : qc-rdp-password-field := FormField { label: "PASSWORD"; placeholder: ""; password: true; text <=> root.secret; }

        if root.kind == 2 : qc-telnet-warning := Text {
            text: "Telnet is unencrypted. Credentials and session data are sent in clear text.";
            color: Theme.color-connecting;
            font-size: Theme.font-sm;
            font-family: Theme.font-family;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: "Telnet is unencrypted. Credentials and session data are sent in clear text.";
        }

        // ── Local-only fields ────────────────────────────────────────────
        if root.kind == 3 : qc-local-program-field := FormField { label: "PROGRAM"; placeholder: "(default shell)"; text <=> root.local-program; }
        if root.kind == 3 : qc-local-args-field := FormField { label: "ARGUMENTS"; placeholder: "(space-separated)"; text <=> root.local-args; }
        if root.kind == 3 : qc-local-cwd-field := FormField { label: "WORKING DIRECTORY"; placeholder: "(default)"; text <=> root.local-cwd; }

        // Footer.
        HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle { horizontal-stretch: 1; }
            qc-cancel-btn := SecondaryButton { text: "Cancel"; clicked => { root.cancel(); } }
            qc-connect-btn := PrimaryButton { text: "Connect"; clicked => { root.connect(); } }
        }
    }
}

// ── HostKeyDialog ─────────────────────────────────────────────────────────────
// Realizes the P3.1 HostKeyVerifier decision. mismatch=false → unknown-host TOFU
// (Reject / Accept & continue). mismatch=true → loud warning showing stored-vs-presented
// fingerprints (Reject default / Accept & replace, destructive). "Accept & replace"
// updates ConMan's own known-hosts ONLY — never ~/.ssh/known_hosts.
export component HostKeyDialog inherits Rectangle {
    in property <bool>   mismatch: false;
    in property <string> host: "web-prod-01:22";
    in property <string> key-type: "ssh-ed25519 · 256-bit";
    in property <string> fingerprint: "SHA256 aRq9…Kf2P pXc8";
    in property <string> stored-fingerprint: "SHA256 aRq9…Kf2P pXc8";
    callback reject();
    callback accept();    // accept (unknown) OR accept & replace (mismatch)

    accessible-role: groupbox;
    accessible-label: (root.mismatch ? "Host key mismatch" : "Unknown host key") + " dialog";

    width: mismatch ? 500px : 480px;
    background: Theme.color-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: mismatch ? Theme.color-error.with-alpha(0.4) : Theme.color-stroke;

    TouchArea {}

    VerticalLayout {
        spacing: 0px;

        // Loud banner (mismatch only).
        if mismatch : Rectangle {
            background: Theme.color-error.with-alpha(0.13);
            border-color: Theme.color-error.with-alpha(0.25);
            border-width: 0px;
            HorizontalLayout {
                padding: Theme.space-3;
                padding-left: Theme.space-6;
                spacing: Theme.space-3;
                // Alert/warning banner icon — Theme.icon-alert token (was 18px literal).
                Text { text: "\u{F0026}"; font-family: Theme.font-family-icons;
                    font-size: Theme.icon-alert;
                    color: Theme.color-error; vertical-alignment: center; }   // Warning
                Text {
                    text: "HOST KEY CHANGED — possible attack";
                    color: Theme.color-error;
                    font-size: Theme.font-base;
                    font-family: Theme.font-family;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            if !mismatch : Text {
                text: "Unknown host key";
                color: Theme.color-text; font-size: Theme.font-lg;
                font-family: Theme.font-family; font-weight: 700;
            }

            Text {
                text: mismatch
                    ? "The key presented by " + host + " does not match the key ConMan has stored. This can mean the server was rebuilt — or that someone is intercepting your connection. Do not continue unless you know why it changed."
                    : "The authenticity of " + host + " can't be established. Verify the fingerprint out-of-band before you trust it.";
                color: Theme.color-text-secondary;
                font-size: Theme.font-base;
                font-family: Theme.font-family;
                wrap: word-wrap;
            }

            // Fingerprint block.
            Rectangle {
                background: Theme.color-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.color-stroke;
                VerticalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-2;
                    // Fingerprint label — Theme.font-xs token (was 10px literal).
                    if mismatch : Text { text: "STORED · ConMan known-hosts"; color: Theme.color-text-secondary;
                        font-size: Theme.font-xs; font-family: Theme.font-family; font-weight: 600; }
                    if mismatch : Text { text: stored-fingerprint; color: Theme.color-connected;
                        font-size: Theme.font-mono; font-family: Theme.font-family-mono; }
                    // "PRESENTED NOW" label — Theme.font-xs token (was 10px literal).
                    Text { text: mismatch ? "PRESENTED NOW" : key-type; color: Theme.color-text-secondary;
                        font-size: mismatch ? Theme.font-xs : Theme.font-mono;
                        font-family: mismatch ? Theme.font-family : Theme.font-family-mono;
                        font-weight: mismatch ? 600 : 400; }
                    Text { text: fingerprint;
                        color: mismatch ? Theme.color-error : Theme.color-accent;
                        font-size: Theme.font-mono; font-family: Theme.font-family-mono; }
                }
            }

            // Actions.
            HorizontalLayout {
                spacing: Theme.space-3;
                Rectangle { horizontal-stretch: 1; }
                // Mismatch: Reject is primary/default. Unknown: Reject is secondary.
                if mismatch : hostkey-reject-mismatch-btn := PrimaryButton { text: "Reject"; clicked => { root.reject(); } }
                if !mismatch : hostkey-reject-unknown-btn := SecondaryButton { text: "Reject"; clicked => { root.reject(); } }
                if mismatch : hostkey-accept-replace-btn := PrimaryButton { text: "Accept & replace"; destructive: true; clicked => { root.accept(); } }
                if !mismatch : hostkey-accept-continue-btn := PrimaryButton { text: "Accept & continue"; clicked => { root.accept(); } }
            }
        }
    }
}

// ── CertDialog ────────────────────────────────────────────────────────────────
// Realizes the P4.2 CertVerifier decision for RDP connections.
//
// mismatch=false → unknown / self-signed certificate TOFU prompt
//   Reject / "Accept & remember" (stores fingerprint in the persistent cert store).
// mismatch=true  → fingerprint changed (MITM warning).
//   Reject (default / primary) / "Accept & replace" (destructive).
//
// subject    — certificate Subject DN or Common Name.
// fingerprint — SHA-256 fingerprint of the presented certificate.
// stored-fingerprint — previously stored fingerprint (shown only when mismatch=true).
export component CertDialog inherits Rectangle {
    in property <bool>   mismatch: false;
    in property <string> host: "HOSTNAME:3389";
    in property <string> subject: "CN=HOSTNAME";
    in property <string> fingerprint: "SHA256:00:11:22:33:44:55:66:77:88:99";
    in property <string> stored-fingerprint: "";
    callback reject();
    callback accept();    // "Accept & remember" (unknown) OR "Accept & replace" (mismatch)

    accessible-role: groupbox;
    accessible-label: (root.mismatch ? "RDP certificate mismatch" : "Unknown RDP certificate") + " dialog";

    width: mismatch ? 510px : 490px;
    background: Theme.color-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: mismatch ? Theme.color-error.with-alpha(0.4) : Theme.color-stroke;

    TouchArea {}

    VerticalLayout {
        spacing: 0px;

        // Loud error banner (mismatch only — potential MITM).
        if mismatch : Rectangle {
            background: Theme.color-error.with-alpha(0.13);
            border-color: Theme.color-error.with-alpha(0.25);
            border-width: 0px;
            HorizontalLayout {
                padding: Theme.space-3;
                padding-left: Theme.space-6;
                spacing: Theme.space-3;
                Text { text: "\u{F0026}"; font-family: Theme.font-family-icons;
                    font-size: Theme.icon-alert;
                    color: Theme.color-error; vertical-alignment: center; }
                Text {
                    text: "CERTIFICATE CHANGED — possible MITM attack";
                    color: Theme.color-error;
                    font-size: Theme.font-base;
                    font-family: Theme.font-family;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            if !mismatch : Text {
                text: "Unknown RDP certificate";
                color: Theme.color-text;
                font-size: Theme.font-lg;
                font-family: Theme.font-family;
                font-weight: 700;
            }

            Text {
                text: mismatch
                    ? "The certificate presented by " + host + " does not match the one ConMan has stored. This may indicate the server was rebuilt — or that someone is intercepting your connection. Do NOT continue unless you know why it changed."
                    : "The certificate for " + host + " is self-signed or issued by an untrusted CA. Verify the fingerprint out-of-band before trusting it.";
                color: Theme.color-text-secondary;
                font-size: Theme.font-base;
                font-family: Theme.font-family;
                wrap: word-wrap;
            }

            // Subject line.
            HorizontalLayout {
                spacing: Theme.space-2;
                Text { text: "Subject:"; color: Theme.color-text-secondary;
                    font-size: Theme.font-sm; font-family: Theme.font-family; vertical-alignment: center; }
                Text { text: subject; color: Theme.color-text;
                    font-size: Theme.font-mono; font-family: Theme.font-family-mono; vertical-alignment: center; }
            }

            // Fingerprint block.
            Rectangle {
                background: Theme.color-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.color-stroke;
                VerticalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-2;
                    if mismatch : Text { text: "STORED FINGERPRINT"; color: Theme.color-text-secondary;
                        font-size: Theme.font-xs; font-family: Theme.font-family; font-weight: 600; }
                    if mismatch : Text { text: stored-fingerprint; color: Theme.color-connected;
                        font-size: Theme.font-mono; font-family: Theme.font-family-mono; }
                    Text { text: mismatch ? "PRESENTED NOW" : "SHA-256 FINGERPRINT";
                        color: Theme.color-text-secondary;
                        font-size: Theme.font-xs; font-family: Theme.font-family; font-weight: 600; }
                    Text { text: fingerprint;
                        color: mismatch ? Theme.color-error : Theme.color-accent;
                        font-size: Theme.font-mono; font-family: Theme.font-family-mono; }
                }
            }

            // Actions.
            HorizontalLayout {
                spacing: Theme.space-3;
                Rectangle { horizontal-stretch: 1; }
                if mismatch  : cert-reject-mismatch-btn := PrimaryButton { text: "Reject"; clicked => { root.reject(); } }
                if !mismatch : cert-reject-unknown-btn := SecondaryButton { text: "Reject"; clicked => { root.reject(); } }
                if mismatch  : cert-accept-replace-btn := PrimaryButton { text: "Accept & replace"; destructive: true; clicked => { root.accept(); } }
                if !mismatch : cert-accept-remember-btn := PrimaryButton { text: "Accept & remember"; clicked => { root.accept(); } }
            }
        }
    }
}

// ── KbdInteractiveDialog ─────────────────────────────────────────────────────
// Realizes the P6.13 KbdInteractiveHandler round trip for SSH keyboard-
// interactive auth: the server sends a name/instructions plus N prompts (each
// with an echo flag); this dialog collects one answer per prompt and submits
// them all together. The server may issue several rounds in sequence (e.g. a
// password prompt, then a one-time code) — each round re-opens this same
// dialog with a fresh prompt set. Answers never leave this form as anything
// but the plain `edited` callback payload the controller forwards straight
// into a `Secret` — never logged, never re-displayed.
export struct KbdPromptRow {
    text: string,
    echo: bool,
    value: string,
}

export component KbdInteractiveDialog inherits Rectangle {
    in property <string> name: "";
    in property <string> instructions: "";
    in property <[KbdPromptRow]> prompts: [];
    callback answer-edited(int, string);
    callback submit();
    callback cancel();

    accessible-role: groupbox;
    accessible-label: (root.name == "" ? "Keyboard-interactive authentication" : root.name) + " dialog";

    width: 460px;
    background: Theme.color-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Text {
            text: name == "" ? "Keyboard-interactive authentication" : name;
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }

        if instructions != "" : Text {
            text: instructions;
            color: Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            wrap: word-wrap;
        }

        for row[idx] in prompts : kbd-prompt-field := FormField {
            label: row.text;
            password: !row.echo;
            text: row.value;
            edited(t) => { root.answer-edited(idx, t); }
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle { horizontal-stretch: 1; }
            kbd-cancel-btn := SecondaryButton { text: "Cancel"; clicked => { root.cancel(); } }
            kbd-submit-btn := PrimaryButton { text: "Submit"; clicked => { root.submit(); } }
        }
    }
}

// ── ImportPasswordDialog (P9.4) ─────────────────────────────────────────────
// mRemoteNG (`.xml`) import prompt: shown when `cm_storage::import` tried the
// built-in default password and the file's secrets need a custom one
// (`ImportExportError::PasswordRequired`, see `controller/import_export.rs`).
// One masked field + OK/Cancel, mirroring KbdInteractiveDialog's shape above
// (opaque card, click-absorbing TouchArea, `edited` callback rather than a
// two-way-bound property -- same no-leak pattern its answers already use).
// Exactly one retry: the controller re-invokes
// `import_from_path_with_password` once on submit and reports whatever it
// gets back (success or still-wrong) as the normal import toast -- this
// dialog never reopens itself for a second attempt.
export component ImportPasswordDialog inherits Rectangle {
    in property <string> file-name: "";
    callback password-edited(string);
    callback submit();
    callback cancel();

    accessible-role: groupbox;
    accessible-label: "Import password dialog";

    width: 440px;
    background: Theme.color-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-stroke;

    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Text {
            text: "Password required";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
        }

        Text {
            text: "\"" + root.file-name + "\" is encrypted with a custom password.";
            color: Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            wrap: word-wrap;
        }

        import-password-field := FormField {
            label: "Password";
            placeholder: "";
            password: true;
            edited(t) => { root.password-edited(t); }
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle { horizontal-stretch: 1; }
            import-password-cancel-btn := SecondaryButton { text: "Cancel"; clicked => { root.cancel(); } }
            import-password-submit-btn := PrimaryButton { text: "Import"; clicked => { root.submit(); } }
        }
    }
}

// ── DeleteConfirmationDialog ────────────────────────────────────────────────
// Both leaf connections and whole group subtrees pass through this explicit
// destructive confirmation. Group counts include the selected root group.
export component DeleteConfirmationDialog inherits Rectangle {
    in property <string> target-name: "";
    in property <bool> is-group: false;
    in property <int> group-count: 0;
    in property <int> connection-count: 0;
    callback confirm();
    callback cancel();

    accessible-role: groupbox;
    accessible-label: "Delete confirmation dialog";

    width: 480px;
    background: Theme.color-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.color-error.with-alpha(0.4);

    TouchArea {}

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Text {
            text: root.is-group
                ? "Delete \"" + root.target-name + "\" and its contents?"
                : "Delete \"" + root.target-name + "\"?";
            color: Theme.color-text;
            font-size: Theme.font-lg;
            font-family: Theme.font-family;
            font-weight: 700;
            wrap: word-wrap;
        }

        delete-confirm-body := Text {
            text: root.is-group
                ? "This will permanently delete " + root.group-count +
                  (root.group-count == 1 ? " group and " : " groups and ") +
                  root.connection-count +
                  (root.connection-count == 1 ? " connection. " : " connections. ") +
                  "This cannot be undone."
                : "This will permanently delete this connection. This cannot be undone.";
            color: Theme.color-text-secondary;
            font-size: Theme.font-base;
            font-family: Theme.font-family;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle { horizontal-stretch: 1; }
            delete-cancel-btn := SecondaryButton { text: "Cancel"; clicked => { root.cancel(); } }
            delete-confirm-btn := PrimaryButton {
                text: "Delete";
                destructive: true;
                clicked => { root.confirm(); }
            }
        }
    }
}
