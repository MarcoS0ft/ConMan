// ConMan — Settings panel (the "Settings" activity-bar panel; minimal Appearance group
// for the P2.8 foundation — full settings + shortcut remap land in P5). Flipping the
// theme segmented control writes Theme.dark-mode and recolors everything live.
//
//   import { SettingsPanel } from "screens/settings_panel.slint";

import { Theme } from "../theme.slint";
import { SegmentedControl } from "../components.slint";

// One labeled settings row: title + subtitle on the left, a control on the right.
component SettingRow {
    in property <string> title;
    in property <string> subtitle;
    HorizontalLayout {
        spacing: Theme.space-4;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: title; color: Theme.color-text; font-size: Theme.font-base;
                font-family: Theme.font-family; font-weight: 600; }
            Text { text: subtitle; color: Theme.color-text-secondary; font-size: Theme.font-sm;
                font-family: Theme.font-family; }
        }
        @children
    }
}

export component SettingsPanel inherits Rectangle {
    // 0 dark · 1 light · 2 system. 1 density-cosy toggle reserved for P5.
    in-out property <int> theme-mode: 2;
    in-out property <int> density: 0;   // 0 compact · 1 cosy
    // 4–5 curated accent options + the OS accent (last). Wire select to Theme.set_accent.
    in property <[color]> accent-options: [#3b82f6, #2dd4bf, #3fb950, #a78bfa];
    in-out property <int> accent-index: 0;
    callback theme-changed(int);
    callback accent-changed(int);

    background: Theme.color-base;

    VerticalLayout {
        // Header.
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                Text { text: "Appearance"; color: Theme.color-text; font-size: Theme.font-lg;
                    font-family: Theme.font-family; font-weight: 700; vertical-alignment: center; }
            }
        }
        Rectangle { height: 1px; background: Theme.color-stroke; }

        VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-6;

            SettingRow { title: "Theme"; subtitle: "Follows OS by default";
                Rectangle { width: 230px;
                    SegmentedControl {
                        options: ["Dark", "Light", "System"];
                        selected <=> root.theme-mode;
                        changed(i) => { root.theme-changed(i); }
                    }
                }
            }

            SettingRow { title: "Accent"; subtitle: "Falls back to OS accent";
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: end;
                    for c[idx] in accent-options : Rectangle {
                        width: 26px; height: 26px; border-radius: 13px;
                        background: c;
                        border-width: idx == accent-index ? 2px : 0px;
                        border-color: Theme.color-base;
                        // Selected ring.
                        Rectangle { width: 100%; height: 100%; border-radius: 13px;
                            border-width: idx == accent-index ? 2px : 0px; border-color: c; }
                        TouchArea { clicked => { root.accent-index = idx; root.accent-changed(idx); } }
                    }
                }
            }

            SettingRow { title: "Density"; subtitle: "Row height & padding";
                Rectangle { width: 170px;
                    SegmentedControl { options: ["Compact", "Cosy"]; selected <=> root.density; }
                }
            }

            SettingRow { title: "Terminal font"; subtitle: "Bundled Nerd Font";
                Rectangle { width: 230px; height: Theme.control-height;
                    border-radius: Theme.radius-sm; background: Theme.color-card;
                    border-width: 1px; border-color: Theme.color-stroke;
                    HorizontalLayout { padding-left: Theme.space-3; padding-right: Theme.space-3;
                        Text { text: "JetBrains Mono NF"; color: Theme.color-text;
                            font-size: Theme.font-base; font-family: Theme.font-family-mono;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "\u{E70D}"; font-family: Theme.font-family-icons; font-size: 11px;
                            color: Theme.color-text-secondary; vertical-alignment: center; }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
