// ConMan — Settings panel (P5.2: full settings + theming).
//
// Sections:
//   • Appearance — Theme (dark/light/system), Accent, Density (Compact/Cosy)
//   • Terminal   — Default font size, default local shell + args + cwd
//   • Startup    — Open last session on launch vs clean start
//   • Shortcuts  — Reserved Ctrl⇧ map (display-only; remap is a later task)
//
// All controls are token-driven (zero hardcoded colors). Changes are forwarded
// via callbacks; the Rust controller persists them to the settings(key,value)
// table and applies them live.
//
//   import { SettingsPanel } from "screens/settings_panel.slint";

import { Theme } from "../theme.slint";
import { SegmentedControl } from "../components.slint";
import { CheckBox, LineEdit, Palette } from "std-widgets.slint";

// ── SettingRow ───────────────────────────────────────────────────────────────
// One labeled row: title + optional subtitle on the left; a control slot on the right.
component SettingRow {
    in property <string> title;
    in property <string> subtitle;
    min-height: Theme.control-height + Theme.space-4;
    HorizontalLayout {
        spacing: Theme.space-4;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: title; color: Theme.color-text; font-size: Theme.font-base;
                font-family: Theme.font-family; font-weight: 600; }
            if subtitle != "" : Text {
                text: subtitle; color: Theme.color-text-secondary;
                font-size: Theme.font-sm; font-family: Theme.font-family;
            }
        }
        @children
    }
}

// ── SectionHeader ────────────────────────────────────────────────────────────
component SectionHeader inherits Rectangle {
    in property <string> label;
    height: Theme.settings-section-header-height;
    background: Theme.color-elevated;
    HorizontalLayout {
        padding-left: Theme.space-6;
        Text {
            text: label;
            color: Theme.color-text-disabled;
            font-size: Theme.font-xs; font-family: Theme.font-family;
            font-weight: 700; letter-spacing: 0.7px;
            vertical-alignment: center;
        }
    }
}

// ── ShortcutRow ──────────────────────────────────────────────────────────────
// One row in the keymap display table.
component ShortcutRow {
    in property <string> keys;
    in property <string> action;
    height: Theme.tree-row-height + 2px;
    HorizontalLayout {
        padding-left: Theme.space-6; padding-right: Theme.space-6;
        spacing: Theme.space-4;
        // Key badge
        Rectangle {
            width: Theme.settings-shortcut-label-width;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 17px;
                    border-radius: Theme.radius-xs;
                    background: Theme.color-elevated;
                    border-width: 1px; border-color: Theme.color-stroke;
                    HorizontalLayout {
                        padding-left: Theme.space-2; padding-right: Theme.space-2;
                        Text {
                            text: keys;
                            color: Theme.color-text-secondary;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-family-mono;
                            font-weight: 600; vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Text {
            text: action;
            color: Theme.color-text-secondary;
            font-size: Theme.font-base; font-family: Theme.font-family;
            vertical-alignment: center; horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// ── SettingsPanel ─────────────────────────────────────────────────────────────
export component SettingsPanel inherits Rectangle {
    // ── Appearance ─────────────────────────────────────────────────────────
    // 0 dark · 1 light · 2 system (Palette.color-scheme driven)
    in-out property <int>  theme-mode: 2;
    // 0 compact · 1 cosy — writes Theme.density live
    in-out property <int>  density: 0;
    // index into Theme.accent-presets (0-based)
    in-out property <int>  accent-index: 0;

    // ── Terminal defaults ───────────────────────────────────────────────────
    // Terminal font size (pt). Default 13.
    in-out property <int>  font-size: 13;
    // Default local shell executable path (empty = OS default: $SHELL / cmd.exe).
    in-out property <string> shell-path: "";
    // Extra arguments passed to the shell (space-separated).
    in-out property <string> shell-args: "";
    // Working directory for new local sessions (empty = home dir).
    in-out property <string> shell-cwd: "";

    // ── Startup ────────────────────────────────────────────────────────────
    // 0 = clean start, 1 = restore last session
    in-out property <int>  startup-behavior: 0;

    // ── Rendering (P7.1 cont.) ──────────────────────────────────────────────
    // 0 = Auto (probe each launch) · 1 = Software · 2 = Hardware (accelerated).
    // Takes effect on next launch (see the row hint below).
    in-out property <int>  render-backend: 0;

    // ── Automation / Agent mode (P8.6-B) ─────────────────────────────────────
    // `agent-mode-available`: true only when this binary was actually built
    // with the `agent-mode` Cargo feature -- Rust never sets this in a normal
    // release build, so the whole section below stays hidden there (the
    // markup itself still compiles in, per the P8.6-impl.md trade-off note;
    // nothing user-visible or functional ships without the feature).
    in property <bool> agent-mode-available: false;
    // The `automation.enabled` master toggle.
    in-out property <bool> agent-mode-enabled: false;
    // The three granted scopes -- read/write/execute, see the consent copy
    // below for exactly what each allows.
    in-out property <bool> agent-mode-scope-read: false;
    in-out property <bool> agent-mode-scope-write: false;
    in-out property <bool> agent-mode-scope-execute: false;
    // "" when not currently listening (enabled but the proxy failed to bind,
    // or disabled); otherwise "127.0.0.1:<port>" -- the loopback address an
    // agent connects to.
    in property <string> agent-mode-connection-details: "";

    // ── Callbacks ──────────────────────────────────────────────────────────
    callback theme-changed(int);           // 0 dark · 1 light · 2 system
    callback density-changed(int);         // 0 compact · 1 cosy
    callback accent-changed(int);          // idx into Theme.accent-presets
    callback font-size-changed(int);
    callback shell-path-changed(string);
    callback shell-args-changed(string);
    callback shell-cwd-changed(string);
    callback startup-behavior-changed(int);
    callback render-backend-changed(int);     // 0 auto · 1 software · 2 hardware
    callback agent-mode-enabled-changed(bool);
    callback agent-mode-scope-read-changed(bool);
    callback agent-mode-scope-write-changed(bool);
    callback agent-mode-scope-execute-changed(bool);

    // P8.1: landmark region — non-interactive, but a genuine navigation aid
    // for screen readers jumping between panels (not required for the audit's
    // interactive-role check, added for real a11y value).
    accessible-role: region;
    accessible-label: "Settings panel";

    background: Theme.color-base;

    VerticalLayout {
        // ── Panel header ────────────────────────────────────────────────
        Rectangle {
            height: 56px;
            background: Theme.color-elevated;
            HorizontalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                Text { text: "Settings"; color: Theme.color-text; font-size: Theme.font-lg;
                    font-family: Theme.font-family; font-weight: 700;
                    vertical-alignment: center; }
            }
        }
        Rectangle { height: 1px; background: Theme.color-stroke; }

        VerticalLayout {
            vertical-stretch: 1;
            padding-bottom: Theme.space-4;

            // ════ APPEARANCE ════════════════════════════════════════════
            SectionHeader { label: "APPEARANCE"; }
            Rectangle { height: 1px; background: Theme.color-stroke; }

            VerticalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                padding-top: Theme.space-4;  padding-bottom: Theme.space-2;
                spacing: Theme.space-4;

                // Theme — stacked: label above, full-width segmented control below.
                VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        Text { text: "Theme"; color: Theme.color-text; font-size: Theme.font-base;
                            font-family: Theme.font-family; font-weight: 600;
                            horizontal-stretch: 1; }
                        Text { text: "Follows OS by default"; color: Theme.color-text-secondary;
                            font-size: Theme.font-sm; font-family: Theme.font-family;
                            vertical-alignment: center; }
                    }
                    SegmentedControl {
                        options: ["Dark", "Light", "System"];
                        selected <=> root.theme-mode;
                        changed(i) => {
                            // P6.8 (gap 9): `Theme.dark-mode` must already hold the
                            // NEW value before `root.theme-changed(i)` fires --
                            // the Rust handler re-pushes the terminal palette from
                            // `ui.get_dark_mode()` synchronously inside that call,
                            // so the write order here matters (was reversed pre-P6.8).
                            if (i == 0) { Theme.dark-mode = true; }
                            else if (i == 1) { Theme.dark-mode = false; }
                            else {
                                Theme.dark-mode = (Palette.color-scheme == ColorScheme.dark);
                            }
                            root.theme-changed(i);
                        }
                    }
                }

                // Accent swatches — label left, swatches right (compact enough).
                SettingRow { title: "Accent color"; subtitle: "Presets, or the live OS accent";
                    HorizontalLayout {
                        spacing: Theme.space-1; alignment: end;
                        // Preset swatches come from Theme.accent-presets — no hardcoded hex here.
                        // space-1 (4px) gap ensures all swatches fit within the 252px panel.
                        for c[idx] in Theme.accent-presets : accent-swatch := Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: c;
                            border-width: idx == root.accent-index ? 2px : 0px;
                            border-color: Theme.color-base;
                            // P8.1: a single-select swatch picker is a radio group;
                            // no color-name text exists to quote, so the label is
                            // an honest ordinal (no fabricated color name).
                            accessible-role: radio-button;
                            accessible-label: "Accent preset " + (idx + 1);
                            accessible-checked: idx == root.accent-index;
                            accessible-item-index: idx;
                            accessible-item-count: Theme.accent-presets.length;
                            accessible-action-default => {
                                root.accent-index = idx;
                                Theme.accent = Theme.accent-presets[idx];
                                root.accent-changed(idx);
                            }
                            // Selected ring (inner outline in swatch color).
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 12px;
                                border-width: idx == root.accent-index ? 2px : 0px;
                                border-color: c;
                            }
                            TouchArea { clicked => {
                                root.accent-index = idx;
                                // Live recolor — writes directly to the Theme global.
                                Theme.accent = Theme.accent-presets[idx];
                                root.accent-changed(idx);
                            } }
                        }
                        // Reserved "OS accent" swatch (P6.8, gap 10): a live, non-
                        // preset color read from the OS by `cm_platform::accent` and
                        // pushed into `Theme.os-accent-color` from Rust at startup
                        // (and live, where the platform has a change signal). Kept
                        // out of `accent-presets` because it isn't a fixed color.
                        // Always outlined (unlike the flat presets above) so it
                        // reads as "live/special" even when not selected.
                        os-accent-swatch := Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: Theme.os-accent-color;
                            border-width: root.accent-index == Theme.os-accent-index ? 2px : 1px;
                            border-color: root.accent-index == Theme.os-accent-index
                                ? Theme.color-base : Theme.color-stroke;
                            accessible-role: radio-button;
                            accessible-label: "OS accent color";
                            accessible-checked: root.accent-index == Theme.os-accent-index;
                            accessible-action-default => {
                                root.accent-index = Theme.os-accent-index;
                                Theme.accent = Theme.os-accent-color;
                                root.accent-changed(Theme.os-accent-index);
                            }
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 12px;
                                border-width: root.accent-index == Theme.os-accent-index ? 2px : 0px;
                                border-color: Theme.os-accent-color;
                            }
                            TouchArea { clicked => {
                                root.accent-index = Theme.os-accent-index;
                                Theme.accent = Theme.os-accent-color;
                                root.accent-changed(Theme.os-accent-index);
                            } }
                        }
                    }
                }

                // Density — stacked: label above, full-width segmented control below.
                VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        Text { text: "Density"; color: Theme.color-text; font-size: Theme.font-base;
                            font-family: Theme.font-family; font-weight: 600;
                            horizontal-stretch: 1; }
                        Text { text: "Row height and padding"; color: Theme.color-text-secondary;
                            font-size: Theme.font-sm; font-family: Theme.font-family;
                            vertical-alignment: center; }
                    }
                    SegmentedControl {
                        options: ["Compact", "Cosy"];
                        selected <=> root.density;
                        changed(i) => {
                            Theme.density = i;
                            root.density-changed(i);
                        }
                    }
                }
            }

            // ════ TERMINAL ══════════════════════════════════════════════
            Rectangle { height: 1px; background: Theme.color-stroke; }
            SectionHeader { label: "TERMINAL"; }
            Rectangle { height: 1px; background: Theme.color-stroke; }

            VerticalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                padding-top: Theme.space-4;  padding-bottom: Theme.space-2;
                spacing: Theme.space-4;

                // Font size — stacked layout so the stepper fits the 252px panel.
                VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Font size"; color: Theme.color-text;
                            font-size: Theme.font-base; font-family: Theme.font-family;
                            font-weight: 600; vertical-alignment: center; }
                        Text { text: "Terminal monospace size (pt)";
                            color: Theme.color-text-secondary; font-size: Theme.font-sm;
                            font-family: Theme.font-family; vertical-alignment: center; }
                    }
                    // Simple − / value display / + stepper, bounded 6..72.
                    HorizontalLayout {
                        spacing: Theme.space-2; alignment: start;
                        Rectangle {
                            width: 28px; height: Theme.control-height;
                            border-radius: Theme.radius-sm;
                            background: dec-ta.has-hover ? Theme.color-hover : Theme.color-card;
                            border-width: 1px; border-color: Theme.color-stroke;
                            Text { text: "−"; color: Theme.color-text; font-size: Theme.font-lg;
                                font-family: Theme.font-family; horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width; height: parent.height; }
                            dec-ta := TouchArea {
                                accessible-role: button;
                                accessible-label: "Decrease font size";
                                accessible-action-default => {
                                    if (root.font-size > 6) {
                                        root.font-size -= 1;
                                        root.font-size-changed(root.font-size);
                                    }
                                }
                                clicked => {
                                if (root.font-size > 6) {
                                    root.font-size -= 1;
                                    root.font-size-changed(root.font-size);
                                }
                            } }
                        }
                        font-size-value := Rectangle {
                            width: 38px; height: Theme.control-height;
                            border-radius: Theme.radius-sm; background: Theme.color-card;
                            border-width: 1px; border-color: Theme.color-stroke;
                            // P8.1: the −/value/+ trio is a custom stepper — the
                            // closest role fit is `spinbox`, with the numeric value
                            // exposed for assistive tech (bounds mirror the clamps
                            // the dec/inc buttons already enforce).
                            accessible-role: spinbox;
                            accessible-label: "Terminal font size";
                            accessible-value: root.font-size + " pt";
                            accessible-value-minimum: 6;
                            accessible-value-maximum: 72;
                            accessible-value-step: 1;
                            Text { text: root.font-size; color: Theme.color-text;
                                font-size: Theme.font-base; font-family: Theme.font-family-mono;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height; }
                        }
                        Rectangle {
                            width: 28px; height: Theme.control-height;
                            border-radius: Theme.radius-sm;
                            background: inc-ta.has-hover ? Theme.color-hover : Theme.color-card;
                            border-width: 1px; border-color: Theme.color-stroke;
                            Text { text: "+"; color: Theme.color-text; font-size: Theme.font-lg;
                                font-family: Theme.font-family; horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width; height: parent.height; }
                            inc-ta := TouchArea {
                                accessible-role: button;
                                accessible-label: "Increase font size";
                                accessible-action-default => {
                                    if (root.font-size < 72) {
                                        root.font-size += 1;
                                        root.font-size-changed(root.font-size);
                                    }
                                }
                                clicked => {
                                if (root.font-size < 72) {
                                    root.font-size += 1;
                                    root.font-size-changed(root.font-size);
                                }
                            } }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Default shell"; color: Theme.color-text;
                        font-size: Theme.font-base; font-family: Theme.font-family;
                        font-weight: 600; }
                    Text { text: "Executable path — empty uses $SHELL or cmd.exe";
                        color: Theme.color-text-secondary; font-size: Theme.font-sm;
                        font-family: Theme.font-family; }
                    settings-shell-path-field := LineEdit {
                        text <=> root.shell-path;
                        placeholder-text: "/bin/bash";
                        font-size: Theme.font-base;
                        accessible-label: "Default shell";
                        accepted(t) => { root.shell-path-changed(t); }
                        edited(t)   => { root.shell-path = t; root.shell-path-changed(t); }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Shell arguments"; color: Theme.color-text;
                        font-size: Theme.font-base; font-family: Theme.font-family;
                        font-weight: 600; }
                    settings-shell-args-field := LineEdit {
                        text <=> root.shell-args;
                        placeholder-text: "--login";
                        font-size: Theme.font-base;
                        accessible-label: "Shell arguments";
                        accepted(t) => { root.shell-args-changed(t); }
                        edited(t)   => { root.shell-args = t; root.shell-args-changed(t); }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Working directory"; color: Theme.color-text;
                        font-size: Theme.font-base; font-family: Theme.font-family;
                        font-weight: 600; }
                    Text { text: "Empty defaults to the user home directory";
                        color: Theme.color-text-secondary; font-size: Theme.font-sm;
                        font-family: Theme.font-family; }
                    settings-shell-cwd-field := LineEdit {
                        text <=> root.shell-cwd;
                        placeholder-text: "~";
                        font-size: Theme.font-base;
                        accessible-label: "Working directory";
                        accepted(t) => { root.shell-cwd-changed(t); }
                        edited(t)   => { root.shell-cwd = t; root.shell-cwd-changed(t); }
                    }
                }
            }

            // ════ STARTUP ═══════════════════════════════════════════════
            Rectangle { height: 1px; background: Theme.color-stroke; }
            SectionHeader { label: "STARTUP"; }
            Rectangle { height: 1px; background: Theme.color-stroke; }

            VerticalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                padding-top: Theme.space-4;  padding-bottom: Theme.space-2;
                spacing: Theme.space-4;

                // Startup — stacked: label above, full-width segmented control below.
                VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        Text { text: "On launch"; color: Theme.color-text; font-size: Theme.font-base;
                            font-family: Theme.font-family; font-weight: 600;
                            horizontal-stretch: 1; }
                        Text { text: "What to do when ConMan opens"; color: Theme.color-text-secondary;
                            font-size: Theme.font-sm; font-family: Theme.font-family;
                            vertical-alignment: center; }
                    }
                    SegmentedControl {
                        options: ["Clean start", "Restore last"];
                        selected <=> root.startup-behavior;
                        changed(i) => { root.startup-behavior-changed(i); }
                    }
                }
            }

            // ════ RENDERING ═════════════════════════════════════════════
            Rectangle { height: 1px; background: Theme.color-stroke; }
            SectionHeader { label: "RENDERING"; }
            Rectangle { height: 1px; background: Theme.color-stroke; }

            VerticalLayout {
                padding-left: Theme.space-6; padding-right: Theme.space-6;
                padding-top: Theme.space-4;  padding-bottom: Theme.space-2;
                spacing: Theme.space-4;

                // Renderer — stacked: label above, full-width segmented control below.
                VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        Text { text: "Renderer"; color: Theme.color-text; font-size: Theme.font-base;
                            font-family: Theme.font-family; font-weight: 600;
                            horizontal-stretch: 1; }
                        Text { text: "Applied on restart"; color: Theme.color-text-secondary;
                            font-size: Theme.font-sm; font-family: Theme.font-family;
                            vertical-alignment: center; }
                    }
                    SegmentedControl {
                        // 0 Auto · 1 Software · 2 Hardware — mirrors render.backend
                        // ("auto"/"software"/"accelerated") persisted by the Rust
                        // controller. Auto re-probes each launch; the others pin it.
                        options: ["Auto", "Software", "Hardware"];
                        selected <=> root.render-backend;
                        changed(i) => { root.render-backend-changed(i); }
                    }
                    Text {
                        text: "Auto detects a working GPU on each launch. Software is the safe fallback for machines without one.";
                        color: Theme.color-text-secondary; font-size: Theme.font-sm;
                        font-family: Theme.font-family; wrap: word-wrap;
                    }
                }
            }

            // ════ AUTOMATION / AGENT MODE (P8.6-B) ═══════════════════════
            // Whole section hidden unless this binary was built with the
            // `agent-mode` feature (see `agent-mode-available`'s doc comment).
            if root.agent-mode-available : VerticalLayout {
                Rectangle { height: 1px; background: Theme.color-stroke; }
                SectionHeader { label: "AUTOMATION / AGENT MODE"; }
                Rectangle { height: 1px; background: Theme.color-stroke; }

                VerticalLayout {
                    padding-left: Theme.space-6; padding-right: Theme.space-6;
                    padding-top: Theme.space-4;  padding-bottom: Theme.space-2;
                    spacing: Theme.space-4;

                    // Master enable toggle. Own checkbox text (not a
                    // separate title Text) so its accessible-label is
                    // unambiguous -- a plain Text with the same words would
                    // otherwise tie for "first match" on a label lookup.
                    VerticalLayout {
                        spacing: Theme.space-2;
                        agent-mode-enable-check := CheckBox {
                            text: "Enable agent mode";
                            checked <=> root.agent-mode-enabled;
                            toggled => { root.agent-mode-enabled-changed(self.checked); }
                        }
                        Text {
                            text: "Lets an AI agent connect over MCP (loopback only) and drive this app -- inspect the window, click things, and (if granted) open your saved connections. Off by default. Applied on restart.";
                            color: Theme.color-text-secondary; font-size: Theme.font-sm;
                            font-family: Theme.font-family; wrap: word-wrap;
                        }
                    }

                    // Scope checkboxes + plain-language consent copy.
                    VerticalLayout {
                        spacing: Theme.space-3;
                        Text {
                            text: "Granted scopes";
                            color: Theme.color-text-secondary; font-size: Theme.font-sm;
                            font-family: Theme.font-family; font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-3;
                            agent-mode-read-check := CheckBox {
                                text: "Read";
                                checked <=> root.agent-mode-scope-read;
                                toggled => { root.agent-mode-scope-read-changed(self.checked); }
                            }
                        }
                        Text {
                            text: "Read -- the agent can inspect the window: see what's on screen, read element properties and status text, take screenshots. It cannot change anything.";
                            color: Theme.color-text-secondary; font-size: Theme.font-xs;
                            font-family: Theme.font-family; wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-3;
                            agent-mode-write-check := CheckBox {
                                text: "Write";
                                checked <=> root.agent-mode-scope-write;
                                toggled => { root.agent-mode-scope-write-changed(self.checked); }
                            }
                        }
                        Text {
                            text: "Write -- the agent can also click, type, and fill in fields: create/edit connections and credentials, change settings. It still cannot open a session by itself (that needs Execute too).";
                            color: Theme.color-text-secondary; font-size: Theme.font-xs;
                            font-family: Theme.font-family; wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-3;
                            agent-mode-execute-check := CheckBox {
                                text: "Execute";
                                checked <=> root.agent-mode-scope-execute;
                                toggled => { root.agent-mode-scope-execute-changed(self.checked); }
                            }
                        }
                        Text {
                            text: "Execute -- the agent can open sessions using your stored credentials (launch a saved SSH/RDP connection, or broadcast input to one already open). The credential's actual password/key is never readable over MCP -- only its name -- even with every scope granted.";
                            color: Theme.color-text-secondary; font-size: Theme.font-xs;
                            font-family: Theme.font-family; wrap: word-wrap;
                        }
                    }

                    // Connection details.
                    if root.agent-mode-connection-details != "" : VerticalLayout {
                        spacing: Theme.space-1;
                        Text {
                            text: "Listening on " + root.agent-mode-connection-details + " (loopback only -- never reachable from another machine).";
                            color: Theme.color-text-disabled; font-size: Theme.font-xs;
                            font-family: Theme.font-family; wrap: word-wrap;
                        }
                    }
                }
            }

            // ════ KEYBOARD SHORTCUTS ════════════════════════════════════
            Rectangle { height: 1px; background: Theme.color-stroke; }
            SectionHeader { label: "KEYBOARD SHORTCUTS"; }
            Rectangle { height: 1px; background: Theme.color-stroke; }

            // Sub-header: Ctrl⇧ reserved app layer
            Rectangle {
                height: 24px;
                HorizontalLayout {
                    padding-left: Theme.space-6;
                    Text {
                        text: "Ctrl ⇧  —  app layer (never forwarded to the terminal)";
                        color: Theme.color-text-disabled; font-size: Theme.font-xs;
                        font-family: Theme.font-family; font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            ShortcutRow { keys: "Ctrl ⇧ \\";   action: "Split pane horizontally"; }
            ShortcutRow { keys: "Ctrl ⇧ −";    action: "Split pane vertically"; }
            ShortcutRow { keys: "Ctrl ⇧ W";    action: "Close focused pane"; }
            ShortcutRow { keys: "Ctrl ⇧ D";    action: "Detach session (keep alive)"; }
            ShortcutRow { keys: "Ctrl ⇧ B";    action: "Toggle broadcast to all panes"; }
            ShortcutRow { keys: "Ctrl ⇧ ←/→";  action: "Focus prev / next pane (H-split)"; }
            ShortcutRow { keys: "Ctrl ⇧ ↑/↓";  action: "Focus prev / next pane (V-split)"; }
            // P6.9 (gap 17): direct shortcuts on the same reserved Ctrl⇧ layer.
            ShortcutRow { keys: "Ctrl ⇧ T";    action: "Open new local tab"; }
            ShortcutRow { keys: "Ctrl ⇧ Tab";  action: "Switch to next tab"; }
            ShortcutRow { keys: "Ctrl ⇧ 1-9";  action: "Jump to tab N"; }
            ShortcutRow { keys: "Ctrl ⇧ E";    action: "Toggle the side panel"; }

            // Sub-header: global shortcuts
            Rectangle {
                height: 24px;
                HorizontalLayout {
                    padding-left: Theme.space-6;
                    Text {
                        text: "Global  —  work from any focus";
                        color: Theme.color-text-disabled; font-size: Theme.font-xs;
                        font-family: Theme.font-family; font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            ShortcutRow { keys: "Ctrl K"; action: "Open command palette"; }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
