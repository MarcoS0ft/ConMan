// ConMan — Shared component primitives (token-driven; ZERO hardcoded colors).
//
// GUI_DESIGN §4 component inventory. Every widget imports the Theme global and reads
// `Theme.*` tokens, so dark/light + accent flip everywhere at once. Chrome glyphs use
// Theme.font-family-icons (bundled Symbols Nerd Font Mono, P5.4) via codepoint strings.
//
//   import { StatusDot, StatusPill, IconButton, ActivityBarButton,
//            PrimaryButton, SecondaryButton, SegmentedControl, FormField,
//            Card, EmptyState } from "components.slint";

import { Theme } from "theme.slint";
// InputType is a Slint 1.17 builtin — no import needed.
import { LineEdit } from "std-widgets.slint";

// ── StatusDot ───────────────────────────────────────────────────────────────
// Filled circle whose color reflects a session-state string. The single source of
// truth for status → color (tab dot, tree row, status bar all use this).
//   state: "connected" | "connecting" | "disconnected" | "error" | ""
export component StatusDot {
  in property <string> state: "disconnected";
  in property <length> diameter: 7px;

  property <color> dot-color:
    state == "connected"  ? Theme.color-connected  :
    state == "connecting" ? Theme.color-connecting :
    state == "error"      ? Theme.color-error      :
    Theme.color-disconnected;

  width: diameter;
  height: diameter;

  Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: parent.diameter / 2;
    background: dot-color;
  }
}

// ── StatusPill ────────────────────────────────────────────────────────────────
// StatusDot + short label, e.g. "Connected · user@host:port" in the status bar.
export component StatusPill {
  in property <string> state: "disconnected";
  in property <string> text: "";

  // P8.1: read-only status text — role `text` (not interactive), label tracks
  // the live status line verbatim (dynamic content per the a11y contract).
  // Qualified `AccessibleRole.text` (not bare `text`) — this component has its
  // own `text` property, which would otherwise shadow the enum value.
  accessible-role: AccessibleRole.text;
  accessible-label: root.text;

  HorizontalLayout {
    spacing: Theme.space-2;
    alignment: start;
    VerticalLayout {
      alignment: center;
      StatusDot { state: root.state; }
    }
    Text {
      text: root.text;
      color: Theme.color-text-secondary;
      font-size: Theme.font-sm;
      font-family: Theme.font-family;
      vertical-alignment: center;
    }
  }
}

// ── IconButton ────────────────────────────────────────────────────────────────
// Square hit-target rendering one Nerd Font icon glyph. Used for toolbar/header actions.
//   glyph: a Symbols Nerd Font Mono codepoint string, e.g. "\u{EA60}" (cod-add).
export component IconButton {
  in property <string> glyph;
  in property <length> size: Theme.control-height;
  in property <length> glyph-size: 15px;
  in property <bool>   enabled: true;
  in property <color>  glyph-color: Theme.color-text-secondary;
  // P5.3b: optional tooltip text shown above the button on hover.
  in property <string> tooltip: "";
  // P9.5 #1: exposes this button's own hover state so a container (e.g. a
  // hoverable list row with an action-icon strip) can OR it together with
  // its own hover TouchArea -- see `ConnectionRow` in app.slint for why a
  // bare `touch.has-hover` on the container alone is unstable once an
  // overlapping child TouchArea (like this button's) is what's actually
  // receiving pointer-move events.
  out property <bool> hovered: touch.has-hover;
  // Fires whenever `hovered` changes. A container can't reach into an
  // `if`-conditional instance's properties from outside that conditional
  // (Slint compile error: "Cannot access id") -- e.g. `ConnectionRow`'s
  // action-icon strip only exists `if action-hover`, so its own
  // `move-up-btn.hovered` etc. can't be read from `action-hover`'s own
  // formula. This callback sidesteps that: the conditional instance can
  // still freely CALL OUT to its enclosing scope (exactly how `clicked`
  // already works from inside that same conditional), letting the parent
  // latch the value into its own plain property.
  callback hover-changed(bool);
  changed hovered => { root.hover-changed(root.hovered); }
  callback clicked();

  // P8.1: icon-only button — the visible tooltip text IS the accessible label
  // (the contract's rule for icon-only buttons). Every call site MUST supply a
  // non-empty `tooltip`; the a11y audit test (tests/a11y_audit.rs) fails any
  // IconButton instance that doesn't.
  accessible-role: button;
  accessible-label: root.tooltip;
  // Real activation via accessibility APIs / the testing backend's
  // invoke_accessible_default_action() (mirrors Slint's own Button widget).
  accessible-action-default => { root.clicked(); }

  width: size;
  height: size;

  Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.color-hover : transparent;

    Text {
      text: root.glyph;
      font-family: Theme.font-family-icons;
      font-size: root.glyph-size;
      color: root.enabled ? root.glyph-color : Theme.color-text-disabled;
      horizontal-alignment: center;
      vertical-alignment: center;
      width: parent.width;
      height: parent.height;
    }
  }

  touch := TouchArea {
    enabled: root.enabled;
    clicked => { root.clicked(); }
  }

  // Tooltip pill — rendered only when hovering and tooltip text is set.
  // Floats above the button via a negative y offset.
  if touch.has-hover && root.tooltip != "" : Rectangle {
    height: 20px;
    min-width: tip-text.preferred-width + Theme.space-3 * 2;
    // Center over the button, clamped to the left side to avoid clipping.
    x: max(-root.x, (root.width - self.width) / 2);
    y: -self.height - Theme.space-1;
    border-radius: Theme.radius-xs;
    background: Theme.color-overlay;
    border-width: 1px;
    border-color: Theme.color-stroke;
    drop-shadow-blur: 4px;
    drop-shadow-color: #00000033;
    tip-text := Text {
      text: root.tooltip;
      font-size: Theme.font-xs;
      font-family: Theme.font-family;
      color: Theme.color-text;
      horizontal-alignment: center;
      vertical-alignment: center;
      x: Theme.space-3;
      y: 0; width: parent.width - Theme.space-3 * 2; height: parent.height;
    }
  }
}

// ── ActivityBarButton ───────────────────────────────────────────────────────
// Slim left-bar panel switcher: a Nerd Font glyph + an accent indicator bar + subtle
// accent wash when active.
// The accent rail is absolutely positioned (left edge) as a sibling of the centered
// icon; Slint 1.17 does not allow setting `x` inside a layout element.
export component ActivityBarButton {
  in property <string> glyph;
  in property <bool>   active: false;
  // P8.1: icon-only nav button — same tooltip-is-the-label contract as IconButton.
  in property <string> tooltip: "";
  callback clicked();

  accessible-role: button;
  accessible-label: root.tooltip;
  // Expose which navigation target is active (and whether the sidebar toggle
  // is pressed) through the same semantic element tree used by UI tests/MCP.
  accessible-checked: root.active;
  accessible-action-default => { root.clicked(); }

  height: 40px;
  width: 100%;

  // Accent indicator rail — pinned to the left edge, vertically centered.
  Rectangle {
    x: 0px;
    y: (parent.height - self.height) / 2;
    width: 3px;
    height: 18px;
    border-radius: 2px;
    background: root.active ? Theme.color-accent : transparent;
  }

  // Centered icon button area.
  HorizontalLayout {
    alignment: center;
    Rectangle {
      width: 34px;
      height: 34px;
      border-radius: Theme.radius-sm;
      background: root.active ? Theme.color-accent-subtle
                : touch.has-hover ? Theme.color-hover : transparent;
      Text {
        text: root.glyph;
        font-family: Theme.font-family-icons;
        // Activity-bar icon — Theme.icon-bar token (was 17px literal).
        font-size: Theme.icon-bar;
        color: root.active ? Theme.color-accent : Theme.color-text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
      }
    }
  }

  touch := TouchArea { clicked => { root.clicked(); } }
}

// ── PrimaryButton ─────────────────────────────────────────────────────────────
// Accent-filled primary action (Connect / Accept & continue). destructive=true
// switches to an outlined error style (e.g. "Accept & replace").
export component PrimaryButton {
  in property <string> text: "Connect";
  in property <bool>   enabled: true;
  in property <bool>   destructive: false;
  in property <bool>   keyboard-focused: false;
  callback clicked();
  out property <bool> has-focus: button-focus.has-focus;

  // P8.1: a button's accessible label is its own visible text (contract §3).
  accessible-role: button;
  accessible-label: root.text;
  accessible-action-default => { root.clicked(); }
  forward-focus: button-focus;

  property <color> bg:
    !enabled    ? Theme.color-hover :
    destructive ? transparent :
    touch.has-hover ? Theme.color-accent-hover : Theme.color-accent;

  preferred-height: Theme.control-height;
  preferred-width: 120px;
  min-width: 80px;

  Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: Theme.radius-sm;
    background: bg;
    border-width: root.destructive || root.has-focus || root.keyboard-focused ? 1px : 0px;
    border-color: root.has-focus || root.keyboard-focused
      ? Theme.color-accent
      : Theme.color-error.with-alpha(0.5);

    Text {
      text: root.text;
      color: !root.enabled ? Theme.color-text-disabled
           : root.destructive ? Theme.color-error
           : Theme.color-accent-text;
      font-size: Theme.font-base;
      font-family: Theme.font-family;
      font-weight: 600;
      horizontal-alignment: center;
      vertical-alignment: center;
      width: parent.width;
      height: parent.height;
    }
  }

  touch := TouchArea {
    enabled: root.enabled;
    clicked => { root.clicked(); }
  }

  button-focus := FocusScope {
    width: 0px;
    enabled: root.enabled;
    key-pressed(event) => {
      if (event.text == Key.Space || event.text == Key.Return) {
        root.clicked();
        accept
      } else {
        reject
      }
    }
  }
}

// ── SecondaryButton ───────────────────────────────────────────────────────────
// Neutral card-surface button with a hairline border (Cancel / Edit / Import).
export component SecondaryButton {
  in property <string> text: "Cancel";
  in property <bool>   enabled: true;
  in property <bool>   keyboard-focused: false;
  callback clicked();
  out property <bool> has-focus: button-focus.has-focus;

  // P8.1: a button's accessible label is its own visible text (contract §3).
  accessible-role: button;
  accessible-label: root.text;
  accessible-action-default => { root.clicked(); }
  forward-focus: button-focus;

  preferred-height: Theme.control-height;
  preferred-width: 100px;
  min-width: 72px;

  Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.color-hover : Theme.color-card;
    border-width: root.has-focus || root.keyboard-focused ? 2px : 1px;
    border-color: root.has-focus || root.keyboard-focused ? Theme.color-accent : Theme.color-stroke;

    Text {
      text: root.text;
      color: root.enabled ? Theme.color-text : Theme.color-text-disabled;
      font-size: Theme.font-base;
      font-family: Theme.font-family;
      font-weight: 600;
      horizontal-alignment: center;
      vertical-alignment: center;
      width: parent.width;
      height: parent.height;
    }
  }

  touch := TouchArea {
    enabled: root.enabled;
    clicked => { root.clicked(); }
  }

  button-focus := FocusScope {
    width: 0px;
    enabled: root.enabled;
    key-pressed(event) => {
      if (event.text == Key.Space || event.text == Key.Return) {
        root.clicked();
        accept
      } else {
        reject
      }
    }
  }
}

// ── SegmentedControl ──────────────────────────────────────────────────────────
// Token segmented picker (theme dark/light/system, auth method, density…).
//   options: labels; selected: 0-based index; emits changed(new-index).
export component SegmentedControl {
  in property <[string]> options;
  in-out property <int>  selected: 0;
  callback changed(int);

  preferred-height: Theme.control-height;

  // P8.1: the strip is a non-interactive grouping container (no label
  // required — the audit test's interactive-role set excludes `tab-list`);
  // each option below is the real interactive target and carries its own
  // role/label/index per the contract's repeated-item rule.
  accessible-role: tab-list;

  Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: Theme.radius-md;
    background: Theme.color-elevated;
    border-width: 1px;
    border-color: Theme.color-stroke;

    HorizontalLayout {
      padding: 3px;
      spacing: 3px;
      for opt[idx] in root.options: seg-tab := Rectangle {
        horizontal-stretch: 1;
        border-radius: Theme.radius-sm;
        background: idx == root.selected ? Theme.color-accent
                  : seg-touch.has-hover ? Theme.color-hover : transparent;
        // P8.1: one option = one tab. Label is the option's own visible
        // text; repeated instances disambiguate via item-index/item-count
        // (never label suffixes), per the contract.
        accessible-role: tab;
        accessible-label: opt;
        accessible-item-index: idx;
        accessible-item-count: root.options.length;
        accessible-item-selected: idx == root.selected;
        accessible-action-default => { root.selected = idx; root.changed(idx); }
        Text {
          text: opt;
          color: idx == root.selected ? Theme.color-accent-text : Theme.color-text-secondary;
          font-size: Theme.font-base;
          font-family: Theme.font-family;
          font-weight: 600;
          horizontal-alignment: center;
          vertical-alignment: center;
          width: parent.width;
          height: parent.height;
        }
        seg-touch := TouchArea {
          clicked => {
            root.selected = idx;
            root.changed(idx);
          }
        }
      }
    }
  }
}

// ── FormField ─────────────────────────────────────────────────────────────────
// Labeled LineEdit with optional password masking. Wraps the std-widgets LineEdit
// so masking + the text style stay consistent (used by QuickConnectForm).
export component FormField {
  in property <string> label;
  in property <string> placeholder;
  in property <bool>   password: false;
  // P9.6-A Phase C (P9.5 #7): greys out and disables the field -- used by the
  // connection editor's Username field in Reference/Object mode, where the
  // username actually used comes from the bound credential, not this
  // connection. Only wired for the non-password (`LineEdit`) variant; no
  // caller currently needs a read-only *password* field.
  in property <bool>   read-only: false;
  in-out property <string> text;
  callback accepted(string);
  callback edited(string);

  VerticalLayout {
    spacing: Theme.space-2;
    Text {
      text: root.label;
      color: Theme.color-text-secondary;
      font-size: Theme.font-sm;
      font-family: Theme.font-family;
      font-weight: 600;
    }
    // P8.1b: std LineEdit binds `accessible-value <=> text` **inside its own
    // definition** in every style (`i-slint-compiler-1.17.0/widgets/*/lineedit.slint`).
    // That is a two-way alias declared at the widget's own scope. Empirically (see
    // `tests/a11y_audit.rs`'s sentinel test), TWO mitigations were tried and BOTH
    // failed to stop the leak on a std LineEdit instance:
    //  1. `accessible-value: root.password ? "" : root.text;` written at this
    //     instantiation site — compiles with no error/warning, but is silently
    //     dropped at runtime; `accessible_value()` still returned the cleartext.
    //     There is no supported way to override one side of a two-way binding
    //     declared inside a std widget's own definition.
    //  2. `accessible-role: none;` on the same LineEdit instance — this override
    //     DOES take effect (`accessible_role()` correctly reports `None`), but
    //     `accessible_value()` STILL returned the cleartext regardless: the
    //     testing/introspection API reads the raw `accessible-value` property
    //     value directly, independent of role (role-gating is a concern of the
    //     OS-native accessibility bridge, not this API) — so muting the role does
    //     not stop this sink.
    // The only mechanism that actually works: never let a std LineEdit hold the
    // real secret in the first place. Password fields use the raw `TextInput`
    // builtin instead: it has no widget-level `accessible-value <=> text` alias
    // (the compiler only fills in a *default* accessible-value binding via
    // `set_binding_if_not_set` — an explicit binding at the instantiation site
    // wins outright, confirmed by the same sentinel test now passing). Visual
    // chrome (box/border/radius/height) is rebuilt from Theme tokens to match
    // LineEdit's look; masking, typing, and `text`/`edited`/`accepted` behave the
    // same as before. Non-password fields are untouched (still plain LineEdit).
    if !root.password : edit := LineEdit {
      placeholder-text: root.placeholder;
      text <=> root.text;
      input-type: InputType.text;
      font-size: Theme.font-base;
      accessible-label: root.label;
      enabled: !root.read-only;
      accepted(t) => { root.accepted(t); }
      edited(t) => { root.edited(t); }
    }
    if root.password : edit-secure := Rectangle {
      height: Theme.control-height;
      background: Theme.color-card;
      border-radius: Theme.radius-sm;
      border-width: 1px;
      border-color: secure-input.has-focus ? Theme.color-accent : Theme.color-stroke;
      clip: true;

      // The accessible surface for this field lives HERE, on the wrapping
      // Rectangle — not on `secure-input` below (which carries the real
      // secret and has its own accessible surface turned off). `text-input`
      // role + human label are present per scope item 3; the value is masked
      // (empty), never the cleartext.
      accessible-role: text-input;
      accessible-label: root.label;
      accessible-value: "";
      accessible-placeholder-text: root.placeholder;
      accessible-read-only: false;

      HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        placeholder := Text {
          text: root.text == "" ? root.placeholder : "";
          color: Theme.color-text-secondary;
          font-size: Theme.font-base;
          font-family: Theme.font-family;
          vertical-alignment: center;
          accessible-role: none;
        }

        secure-input := TextInput {
          text <=> root.text;
          input-type: InputType.password;
          font-size: Theme.font-base;
          font-family: Theme.font-family;
          color: Theme.color-text;
          single-line: true;
          vertical-alignment: center;
          horizontal-stretch: 1;
          // This element holds the real secret in its own `text` — its
          // accessible surface is turned off entirely; `edit-secure` above
          // is the only accessible carrier for this field.
          accessible-role: none;
          accepted => { root.accepted(self.text); }
          edited => { root.edited(self.text); }
        }
      }
    }
  }
}

// ── Card ──────────────────────────────────────────────────────────────────────
// Elevated surface with a hairline stroke. Children are laid out by the caller.
export component Card {
  in property <length> radius: Theme.radius-md;
  Rectangle {
    background: Theme.color-card;
    border-radius: root.radius;
    border-width: 1px;
    border-color: Theme.color-stroke;
    @children
  }
}

// ── EmptyState ────────────────────────────────────────────────────────────────
// Centered glyph + title + subtitle for empty lists/areas (no connections, etc.).
export component EmptyState {
  in property <string> glyph: "\u{EA70}";  // cod-eye (Symbols Nerd Font Mono)
  in property <string> title: "Nothing here yet";
  in property <string> subtitle: "";

  VerticalLayout {
    alignment: center;
    spacing: Theme.space-3;
    HorizontalLayout {
      alignment: center;
      Rectangle {
        width: Theme.space-12;
        height: Theme.space-12;
        border-radius: Theme.radius-md;
        background: Theme.color-card;
        border-width: 1px;
        border-color: Theme.color-stroke;
        Text {
          text: root.glyph;
          font-family: Theme.font-family-icons;
          // Empty-state icon — Theme.icon-xl token (was 22px literal).
          font-size: Theme.icon-xl;
          color: Theme.color-text-disabled;
          horizontal-alignment: center;
          vertical-alignment: center;
          width: parent.width;
          height: parent.height;
        }
      }
    }
    Text {
      text: root.title;
      color: Theme.color-text;
      font-size: Theme.font-base;
      font-family: Theme.font-family;
      font-weight: 600;
      horizontal-alignment: center;
    }
    Text {
      text: root.subtitle;
      color: Theme.color-text-secondary;
      font-size: Theme.font-sm;
      font-family: Theme.font-family;
      horizontal-alignment: center;
      wrap: word-wrap;
    }
  }
}

// ── Toast ─────────────────────────────────────────────────────────────────────
// Ephemeral notification pill that appears for ~3 s then auto-dismisses.
// Kind: 0 = info (accent), 1 = success (green), 2 = warning (amber), 3 = error (red).
//
// Usage in AppWindow:
//   ToastBar at the bottom of the window, bound to an `active-toasts` model.
//   The Rust controller pushes entries; the Timer auto-dismisses each item.
export component Toast inherits Rectangle {
    in property <string> message: "Disconnected from web-prod-01";
    in property <int>    kind:    0;   // 0=info 1=success 2=warning 3=error
    callback dismissed();

    border-radius: Theme.radius-pill;
    background: kind == 1 ? Theme.color-connected.with-alpha(0.92)
              : kind == 2 ? Theme.color-connecting.with-alpha(0.92)
              : kind == 3 ? Theme.color-error.with-alpha(0.92)
              : Theme.color-overlay;
    border-width: 1px;
    border-color: Theme.color-stroke;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    height: 32px;
    min-width: 200px;
    max-width: 440px;

    // Auto-dismiss after 3.2 s.
    Timer {
        interval: 3200ms; running: true;
        triggered => { root.dismissed(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-4; padding-right: Theme.space-3;
        spacing: Theme.space-2; alignment: center;
        // Kind icon.
        Text {
            text: kind == 1 ? "\u{F012C}"   // md-check
                : kind == 2 ? "\u{F0026}"   // md-alert
                : kind == 3 ? "\u{F0026}"   // md-alert (error)
                : "\u{F02FC}";              // md-information
            font-family: Theme.font-family-icons;
            font-size: Theme.icon-sm;
            color: kind == 0 ? Theme.color-accent : Theme.color-accent-text;
            vertical-alignment: center;
        }
        Text {
            text: root.message;
            font-size: Theme.font-sm;
            font-family: Theme.font-family;
            color: kind == 0 ? Theme.color-text : Theme.color-accent-text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Dismiss button.
        dismiss-btn := TouchArea {
            width: 18px; height: 18px;
            accessible-role: button;
            accessible-label: "Dismiss notification";
            accessible-action-default => { root.dismissed(); }
            clicked => { root.dismissed(); }
            Text { text: "\u{EA76}"; font-family: Theme.font-family-icons;  // cod-close
                font-size: Theme.icon-sm;
                color: kind == 0 ? Theme.color-text-secondary : Theme.color-accent-text.with-alpha(0.75);
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height; }
        }
    }
}
