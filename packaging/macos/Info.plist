<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Connection Manager</string>
    <key>CFBundleExecutable</key>
    <string>conman</string>
    <key>CFBundleIconFile</key>
    <string>ConMan</string>
    <key>CFBundleIdentifier</key>
    <string>com.marcos0ft.conman</string>
    <key>CFBundleName</key>
    <string>ConMan</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!-- Sparkle 2.9.4; the bridge dynamically selects the stable/dev feed. -->
    <key>SUFeedURL</key>
    <string>https://github.com/MarcoS0ft/ConMan/releases/latest/download/appcast-stable.xml</string>
    <!-- Sparkle key id: conman-sparkle-v1; release CI injects the public key. -->
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_CONMAN_SPARKLE_V1_PUBLIC_KEY</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <true/>
    <key>SUAllowsAutomaticUpdates</key>
    <true/>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 ConMan contributors.</string>
</dict>
</plist>
